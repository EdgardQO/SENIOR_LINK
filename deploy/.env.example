# Copiar a deploy/.env solo en el VPS (no subir credenciales a GitHub).
SENIORLINK_DB_PASSWORD=REEMPLAZAR_CON_CLAVE_DE_seniorlink_user
SENIORLINK_JWT_SECRET_BASE64=REEMPLAZAR_CON_SECRETO_BASE64_NUEVO
# Para prueba segura vía túnel SSH, antes de tener dominio:
# Dejar vacío para utilizar /api en el mismo origen.
PUBLIC_API_URL=
FRONTEND_ALLOWED_ORIGINS=http://localhost:4321
# Valor temporal de desarrollo: revisar migraciones antes del entorno productivo.
HIBERNATE_DDL_AUTO=update
