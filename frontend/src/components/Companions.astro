---
const companions = [
  {
    name: 'Lucía Ramos',
    dni: '433',
    career: 'Enfermería',
    cycle: '9.º ciclo',
    photo: '/fotografia de alumnos/enfermeria/enfermeria_mujer.png',
    rating: '4.98',
    reviews: 34,
    rate: '25.00',
    bio: 'Acompañamiento cercano, escucha activa y apoyo en las actividades cotidianas de las personas mayores.',
  },
  {
    name: 'Jorge Quispe',
    dni: '698',
    career: 'Terapia Física y Rehabilitación',
    cycle: '8.º ciclo',
    photo: '/fotografia de alumnos/Terapia Física y Rehabilitación/Terapia Física y Rehabilitación hombre.png',
    rating: '4.85',
    reviews: 21,
    rate: '22.00',
    bio: 'Disfruta acompañar caminatas, paseos y actividades recreativas adaptadas al ritmo de cada persona.',
  },
  {
    name: 'Camila Valdivia',
    dni: '812',
    career: 'Psicología',
    cycle: '7.º ciclo',
    photo: '/fotografia de alumnos/psicologia/psicologia_mujer.png',
    rating: '4.92',
    reviews: 19,
    rate: '24.00',
    bio: 'Le apasionan la lectura, las conversaciones y las actividades que promueven la conexión social.',
  },
];
---

<section id="acompanantes" class="featured-section" aria-labelledby="featured-title">
  <div class="featured-container">
    <header class="featured-heading">
      <span class="featured-eyebrow">ACOMPAÑANTES DESTACADOS</span>
      <h2 id="featured-title">Personas que acompañan con vocación</h2>
      <p>Conoce perfiles de estudiantes comprometidos con brindar compañía y atención cercana.</p>
    </header>

    <div class="featured-grid">
      {companions.map((c) => (
        <article class="featured-card">
          <div class="featured-photo-wrap">
            <img class="featured-photo" src={c.photo} alt={`Fotografía ilustrativa del perfil de ${c.name}`} loading="lazy" decoding="async" />
            <span class="featured-photo-tag">Acompañante SeniorLink</span>
          </div>

          <div class="featured-body">
            <div class="featured-name-row">
              <h3>{c.name}</h3>
              <span class="featured-dni">DNI ···{c.dni}</span>
            </div>

            <div class="featured-rating" aria-label={`Calificación de ${c.rating} de 5 estrellas, basada en ${c.reviews} reseñas`}>
              <span class="featured-stars" aria-hidden="true">★★★★★</span>
              <strong>{c.rating}</strong>
              <span class="featured-review-count">({c.reviews} reseñas)</span>
            </div>

            <div class="featured-study">
              <span class="featured-study-icon" aria-hidden="true">✦</span>
              <div>
                <span class="featured-study-label">Carrera y ciclo</span>
                <p>{c.career} <span>· {c.cycle}</span></p>
              </div>
            </div>

            <p class="featured-bio">{c.bio}</p>

            <div class="featured-footer">
              <div>
                <span class="featured-rate-label">Tarifa actual</span>
                <p class="featured-rate">S/ {c.rate}<span> / hora</span></p>
              </div>
              <span class="featured-rating-pill" aria-label={`${c.reviews} reseñas recibidas`}>{c.reviews} reseñas</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="featured-note">Perfiles y valoraciones de ejemplo para mostrar el diseño. Los datos definitivos se mostrarán cuando se conecten los perfiles reales.</p>
  </div>
</section>

<style>
  .featured-section{padding:88px 0 100px;background:#fff;border-top:1px solid #e9f0ed;scroll-margin-top:85px}
  .featured-container{max-width:1200px;margin:0 auto;padding:0 28px}
  .featured-heading{text-align:center;max-width:670px;margin:0 auto 42px}
  .featured-eyebrow{color:#128274;font-size:11px;font-weight:800;letter-spacing:.14em}
  .featured-heading h2{margin:13px 0 13px;color:#173e3a;font-size:clamp(28px,3vw,39px);font-weight:850;letter-spacing:-.03em;line-height:1.2}
  .featured-heading>p{margin:0;color:#71857e;font-size:15px;line-height:1.7}
  .featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .featured-card{min-width:0;overflow:hidden;border:1px solid #e2ece7;border-radius:18px;background:#fff;box-shadow:0 8px 26px rgba(20,70,60,.055);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
  .featured-card:hover{transform:translateY(-5px);border-color:#b5d6c9;box-shadow:0 17px 40px rgba(20,70,60,.12)}
  .featured-photo-wrap{height:245px;position:relative;overflow:hidden;background:#e8f2ee}
  .featured-photo{width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block;transition:transform .4s ease}
  .featured-card:hover .featured-photo{transform:scale(1.035)}
  .featured-photo-tag{position:absolute;bottom:14px;left:16px;border:1px solid rgba(255,255,255,.7);border-radius:30px;padding:7px 11px;background:rgba(255,255,255,.94);color:#246458;font-size:10px;font-weight:750;box-shadow:0 3px 12px rgba(0,0,0,.08)}
  .featured-body{display:flex;flex-direction:column;padding:23px 24px 24px;min-height:340px}
  .featured-name-row{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
  .featured-name-row h3{margin:0;color:#173e3a;font-size:21px;font-weight:800;letter-spacing:-.025em}
  .featured-dni{white-space:nowrap;color:#8a9a94;font-size:11px;font-weight:650}
  .featured-rating{display:flex;align-items:center;gap:8px;margin-top:10px}
  .featured-stars{color:#e5a72d;font-size:14px;letter-spacing:1px;white-space:nowrap}
  .featured-rating strong{color:#26473f;font-size:14px}
  .featured-review-count{color:#899a94;font-size:11px}
  .featured-study{display:flex;align-items:center;gap:11px;margin-top:21px;padding:13px 14px;background:#edf7f2;border-radius:11px}
  .featured-study-icon{display:grid;place-items:center;width:31px;height:31px;flex-shrink:0;border-radius:9px;background:#d5ede3;color:#117c6d;font-size:20px}
  .featured-study-label{display:block;color:#7b958b;font-size:10px;font-weight:700}
  .featured-study p{margin:3px 0 0;color:#26574b;font-size:12px;font-weight:750;line-height:1.4}
  .featured-study p span{font-weight:550;color:#668b7d}
  .featured-bio{margin:17px 0 23px;color:#6c8179;font-size:13px;line-height:1.75}
  .featured-footer{display:flex;justify-content:space-between;align-items:end;gap:10px;margin-top:auto;padding-top:18px;border-top:1px solid #e7efeb}
  .featured-rate-label{display:block;color:#8a9b94;font-size:11px;font-weight:650}
  .featured-rate{margin:4px 0 0;color:#11796d;font-size:24px;font-weight:850;letter-spacing:-.035em}
  .featured-rate span{font-size:12px;color:#84978f;font-weight:550;letter-spacing:0}
  .featured-rating-pill{border:1px solid #e3ede8;border-radius:30px;padding:7px 10px;color:#55796d;font-size:10px;font-weight:700;white-space:nowrap}
  .featured-note{margin:22px 0 0;text-align:center;color:#92a29b;font-size:11px}
  @media(max-width:980px){.featured-grid{gap:16px}.featured-body{padding:19px}.featured-name-row{flex-wrap:wrap}.featured-photo-wrap{height:230px}}
  @media(max-width:760px){.featured-section{padding:65px 0}.featured-container{padding:0 18px}.featured-grid{grid-template-columns:1fr;max-width:440px;margin:0 auto;gap:20px}.featured-photo-wrap{height:255px}.featured-body{min-height:0}.featured-heading{margin-bottom:30px}}
  @media(prefers-reduced-motion:reduce){.featured-card,.featured-photo{transition:none}.featured-card:hover,.featured-card:hover .featured-photo{transform:none}}
</style>