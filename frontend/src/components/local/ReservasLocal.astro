---
interface Props { rol: 'ADULTO_MAYOR'|'FAMILIAR'|'ACOMPANANTE'|'ADMINISTRADOR' }
const {rol}=Astro.props;
const cliente=rol==='ADULTO_MAYOR'||rol==='FAMILIAR';
---
<section class="local-card" data-reservas-rol={rol}>
 <h2>{cliente?'Solicitar acompañamiento':rol==='ACOMPANANTE'?'Solicitudes y agenda':'Reservas registradas'}</h2>
 {cliente && <form id="reserva-local-form" class="local-form">
  {rol==='FAMILIAR' && <label>Adulto mayor autorizado<select name="adultoMayorDni" id="reserva-local-adulto" required><option value="">Selecciona un adulto autorizado</option></select></label>}
  <div class="companion-picker" id="reserva-local-picker">
   <label for="reserva-local-buscar">Acompañante</label>
   <div class="companion-picker-field">
    <input id="reserva-local-buscar" type="text" placeholder="Busca o selecciona un acompañante" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="reserva-local-opciones" required disabled/>
    <button id="reserva-local-toggle" type="button" aria-label="Mostrar acompañantes" aria-controls="reserva-local-opciones" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
   </div>
   <input type="hidden" name="acompananteDni" id="reserva-local-acompanante"/>
   <div id="reserva-local-opciones" class="companion-options" role="listbox" aria-label="Acompañantes disponibles" hidden></div>
   <span id="reserva-local-resultados" class="companion-sr-only" role="status" aria-live="polite"></span>
  </div>
  <section id="reserva-local-ficha" class="local-companion-card" aria-live="polite" hidden>
    <div class="local-companion-heading">
      <img id="reserva-local-foto" alt="Fotografía del acompañante seleccionado" hidden />
      <div><strong id="reserva-local-nombre"></strong><p id="reserva-local-carrera"></p></div>
    </div>
    <p id="reserva-local-institucion"></p>
    <p id="reserva-local-bio"></p>
    <p id="reserva-local-tarifa"></p>
    <div id="reserva-local-calificacion" class="companion-rating"></div>
    <details id="reserva-local-resenas" class="companion-reviews">
      <summary>Ver reseñas</summary>
      <div id="reserva-local-resenas-lista" aria-live="polite"></div>
    </details>
    <h3>Horarios de atención</h3>
    <p id="reserva-local-horarios">Consultando disponibilidad...</p>
  </section>
  <label>Servicio<select name="servicioId" id="reserva-local-servicio" required><option value="">Selecciona un servicio</option></select></label>
  <label>Inicio<input name="inicio" type="datetime-local" required/></label>
  <label>Fin<input name="fin" type="datetime-local" required/></label>
  <label>Dirección de encuentro<input name="direccion" maxlength="1000" required/></label>
  <label>Indicaciones adicionales<textarea name="indicaciones" rows="2"></textarea></label>
  <button type="submit">Enviar solicitud</button>
 </form>}
 <p id="reserva-local-status" role="status" aria-live="polite"></p>
 <div id="reserva-local-list" class="local-list"></div>
 {cliente && <p>Modo de prueba: para pagar, registra una tarjeta en <a href={rol==='FAMILIAR'?'/familiar/metodos-pago':'/adulto-mayor/metodos-pago'}>Mis métodos de pago</a>.</p>}
</section>
<style>
 .companion-picker{position:relative;display:grid;gap:5px;min-width:0}
 .companion-picker-field{position:relative}
 .companion-picker-field input{padding-right:48px}
 .companion-picker-field button{position:absolute;right:4px;top:4px;bottom:4px;width:38px;display:grid;place-items:center;background:transparent;color:#365b51;padding:0}
 .companion-picker-field button:hover{background:#eaf4ef;color:#087a70}
 .companion-options{position:absolute;top:100%;left:0;right:0;z-index:30;max-height:300px;overflow-y:auto;background:#fff;border:1px solid #cbdad5;border-radius:10px;box-shadow:0 8px 24px #163d3520;padding:5px}
 .companion-options[hidden]{display:none}
 :global(.companion-option){display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 12px;border-radius:7px;cursor:pointer;color:#173d35}
 :global(.companion-option[aria-selected=true]),:global(.companion-option:hover){background:#e9f5f0}
 :global(.companion-option strong),:global(.companion-option small){display:block;overflow-wrap:anywhere}
 :global(.companion-option small){font-size:12px;color:#52665f;margin-top:3px}
 :global(.companion-option-price){white-space:nowrap;font-size:13px;font-weight:600}
 :global(.companion-empty){padding:12px;font-size:13px;color:#52665f}
 .companion-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .companion-rating{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:13px}
 .companion-reviews{border:1px solid #d1e5dd;border-radius:9px;background:#fff;margin:5px 0;padding:10px 13px}
 .companion-reviews summary{cursor:pointer;color:#087a70;font-size:13px;font-weight:600}
 .companion-reviews summary:focus-visible{outline:2px solid #087a70;outline-offset:4px}
 :global(.companion-stars){position:relative;display:inline-block;vertical-align:middle;font-size:21px;letter-spacing:2px;line-height:1.2;white-space:nowrap;color:#b9c7c1}
 :global(.companion-stars-fill){position:absolute;inset:0 auto 0 0;overflow:hidden;color:#c58b18;white-space:nowrap}
 :global(.companion-review){padding:12px 0;border-top:1px solid #e4eee9;margin-top:10px}
 :global(.companion-review-heading){display:flex;align-items:center;gap:8px;flex-wrap:wrap}
 :global(.companion-review-date){color:#64756e;font-size:12px;margin-left:auto}
 :global(.companion-review p){white-space:pre-wrap;overflow-wrap:anywhere}
 .local-companion-card{border:1px solid #cbe6db;background:#f5fbf8;padding:17px;border-radius:15px;display:grid;gap:7px}
 .local-companion-card[hidden]{display:none}
 .local-companion-heading{display:flex;align-items:center;gap:13px}
 .local-companion-heading img{width:78px;height:78px;border-radius:50%;object-fit:cover;flex-shrink:0}
 .local-companion-heading img[hidden]{display:none}
 .local-companion-card p{margin:3px 0;line-height:1.5;font-size:13px}
 .local-companion-card h3{font-size:14px;margin:10px 0 0;color:#12695d}
 :global(.reserva-personas){display:flex;flex-wrap:wrap;gap:12px;margin:12px 0}
 :global(.reserva-persona){display:flex;align-items:center;gap:10px;flex:1 1 195px;padding:12px;border:1px solid #d7e9e2;background:#f5fbf8;border-radius:12px;min-width:0}
 :global(.reserva-persona img),:global(.reserva-persona-avatar){width:58px;height:58px;border-radius:50%;object-fit:cover;flex-shrink:0}
 :global(.reserva-persona-avatar){display:grid;place-items:center;background:#dcefe7;color:#245b50;font-weight:700}
 :global(.reserva-persona [hidden]){display:none!important}
 :global(.reserva-persona small){display:block;color:#496b60;font-size:12px}
 :global(.reserva-persona strong){display:block;overflow-wrap:anywhere}
 </style>
<script>
 import {apiLocal,horaLocal,importe,sesionRequerida} from '../../lib/local-api';
 import {mostrarFotoProtegida,limpiarFoto} from '../../lib/profile-photo';
 const root=document.querySelector<HTMLElement>('[data-reservas-rol]')!;
 const rol=root.dataset.reservasRol!;
 const estado=root.querySelector<HTMLElement>('#reserva-local-status')!;
 const contenedor=root.querySelector<HTMLElement>('#reserva-local-list')!;
 const session=sesionRequerida();
 const nuevo=(tag:string,texto:string)=>{const e=document.createElement(tag);e.textContent=texto;return e;};
 const refrescar=async()=>{
  const bookings=await apiLocal('/reservas');
  let medios:any[]=[];
  let errorMedios=false;
  if(rol==='ADULTO_MAYOR'||rol==='FAMILIAR'){
   try{medios=await apiLocal('/metodos-pago');}catch(e){errorMedios=true;console.error('Error al consultar métodos de pago',e);}
  }
  contenedor.querySelectorAll<HTMLImageElement>('img').forEach(limpiarFoto);
  contenedor.replaceChildren();
  if(!bookings.length){contenedor.textContent='No hay reservas para mostrar.';return;}
  for(const b of bookings){
   const div=document.createElement('article');div.className='local-item local-booking';
   div.append(nuevo('strong','#'+b.id+' · '+b.estado.replaceAll('_',' ')));
   const personas=document.createElement('div');personas.className='reserva-personas';
   const participante=(dni:string,nombre:string,etiqueta:string,tieneFoto:boolean)=>{
    const tarjeta=document.createElement('div');tarjeta.className='reserva-persona';
    const img=document.createElement('img');img.alt='Foto de '+nombre;img.hidden=true;
    const iniciales=nuevo('span',String(nombre||'?').trim().split(/\s+/).slice(0,2).map(n=>n[0]||'').join('').toUpperCase());
    iniciales.className='reserva-persona-avatar';iniciales.setAttribute('aria-hidden','true');
    const info=document.createElement('div');info.append(nuevo('small',etiqueta),nuevo('strong',nombre||'Sin nombre'));
    const aviso=nuevo('small',tieneFoto?'Cargando fotografía…':'Sin fotografía');info.append(aviso);
    tarjeta.append(img,iniciales,info);personas.append(tarjeta);
    if(tieneFoto)void mostrarFotoProtegida(dni,img,Number(b.id)).then(ok=>{
     iniciales.hidden=ok;aviso.textContent=ok?'':'Fotografía no disponible';aviso.hidden=ok;
    });
   };
   if(rol!=='ACOMPANANTE')participante(b.acompananteDni,b.acompananteNombre,'Acompañante',Boolean(b.acompananteFotoUrl));
   if(rol!=='ADULTO_MAYOR')participante(b.adultoMayorDni,b.adultoMayorNombre,'Adulto mayor',Boolean(b.adultoMayorFotoUrl));
   if(b.solicitanteDni && b.solicitanteDni!==b.adultoMayorDni &&
      (rol==='ACOMPANANTE'||rol==='ADULTO_MAYOR'||rol==='ADMINISTRADOR'))
    participante(b.solicitanteDni,b.solicitanteNombre,'Familiar solicitante',Boolean(b.solicitanteFotoUrl));
   div.append(personas);
   div.append(nuevo('p',horaLocal(b.inicio)+' — '+horaLocal(b.fin)+' · '+importe(b.montoTotal)));
   if(b.direccion)div.append(nuevo('p','Lugar de encuentro: '+b.direccion));
   const acciones=document.createElement('div');acciones.className='local-actions';
   const accion=(nombre:string,ruta:string)=>{
    const btn=nuevo('button',nombre) as HTMLButtonElement;btn.type='button';
    btn.addEventListener('click',async()=>{
     try{estado.textContent='Procesando…';await apiLocal('/reservas/'+b.id+'/'+ruta,{method:'POST'});
      estado.textContent='Actualización guardada.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(btn);
   };
   if(rol==='ACOMPANANTE'){
    if(b.estado==='PENDIENTE_ACEPTACION'){accion('Aceptar','aceptar');accion('Rechazar','rechazar');}
    if(b.estado==='CONFIRMADA')accion('Iniciar','iniciar');
    if(b.estado==='EN_PROGRESO')accion('Finalizar','finalizar');
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR')&&b.estado==='PENDIENTE_CONFIRMACION')accion('Confirmar servicio','confirmar');
   if(['PENDIENTE_ACEPTACION','PENDIENTE_PAGO','CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION'].includes(b.estado) && rol!=='ADMINISTRADOR')
    accion('Cancelar / reportar','cancelar');
   if(rol==='ADMINISTRADOR' && (b.estado==='CANCELADA'||b.estado==='EN_DISPUTA')){
    const refund=nuevo('button','Reembolsar pago') as HTMLButtonElement;
    refund.addEventListener('click',async()=>{
     if(!confirm('¿Registrar el reembolso de esta reserva?'))return;
     try{const res=await apiLocal('/admin/reservas/'+b.id+'/reembolsar',{method:'POST'});
      estado.textContent='Resultado del reembolso: '+res.estado;await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(refund);
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR')&&b.estado==='PENDIENTE_PAGO'){
    const pago=document.createElement('form');pago.className='local-form local-checkout';
    const titulo=nuevo('h3','Resumen del pago');
    const total=nuevo('strong',importe(b.montoTotal));total.className='checkout-total';
    const aviso=nuevo('p','Pasarela local de prueba. No se realizará ningún cargo real.');
    const mensaje=nuevo('p','');mensaje.setAttribute('role','status');
    const sel=document.createElement('select');sel.required=true;
    const n=document.createElement('option');n.value='';n.textContent='Seleccionar tarjeta';sel.append(n);
    for(const m of medios){const opt=document.createElement('option');opt.value=m.id;opt.textContent=m.tipo+' '+m.numeroEnmascarado;sel.append(opt);}
    const cvv=document.createElement('input');cvv.type='password';cvv.placeholder='Código de prueba';cvv.required=true;cvv.pattern='[0-9]{3,4}';cvv.maxLength=4;cvv.inputMode='numeric';cvv.autocomplete='off';cvv.setAttribute('aria-label','Código de seguridad de prueba');
    sel.setAttribute('aria-label','Método de pago de prueba');
    const btn=nuevo('button','Pagar '+importe(b.montoTotal)) as HTMLButtonElement;btn.type='submit';
    let clave=crypto.randomUUID();let enviando=false;
    pago.append(titulo,total,aviso);
    if(errorMedios)pago.append(nuevo('p','No se pudieron consultar tus métodos de pago. Recarga la página para reintentar.'));
    else if(!medios.length){const enlace=document.createElement('a');enlace.href=rol==='FAMILIAR'?'/familiar/metodos-pago':'/adulto-mayor/metodos-pago';enlace.textContent='Agregar un método de pago de prueba';pago.append(enlace);}
    else pago.append(sel,cvv,btn,mensaje);
    const renovar=()=>{if(!enviando)clave=crypto.randomUUID();};
    sel.addEventListener('change',renovar);cvv.addEventListener('input',renovar);
    pago.addEventListener('submit',async ev=>{
     ev.preventDefault();if(enviando||!medios.length)return;
     enviando=true;btn.disabled=true;sel.disabled=true;cvv.disabled=true;
     try{
      mensaje.textContent='Procesando el pago simulado…';
      const res=await apiLocal('/reservas/'+b.id+'/pagar',{method:'POST',body:JSON.stringify({
       metodoId:sel.value,claveIdempotencia:clave,cvv:cvv.value
      })});
      cvv.value='';
      if(res.estado==='APROBADO'){estado.textContent='Pago simulado aprobado. Reserva confirmada. Referencia: '+res.transaccionId;await refrescar();}
      else{const razones:Record<string,string>={FONDOS_INSUFICIENTES:'Fondos de prueba insuficientes.',CVV_INVALIDO:'Código de seguridad incorrecto.',TARJETA_INACTIVA:'Método de pago inactivo.',TARJETA_VENCIDA:'Método de pago vencido.'};mensaje.textContent=razones[res.codigo]||'El pago simulado fue rechazado.';clave=crypto.randomUUID();}
     }catch(e){mensaje.textContent=e instanceof Error?e.message:String(e);}
     finally{enviando=false;btn.disabled=false;sel.disabled=false;cvv.disabled=false;}
    });acciones.append(pago);
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR') && b.estado==='COMPLETADA'){
    const review=document.createElement('form');review.className='local-form';
    const score=document.createElement('select');
    for(let n=5;n>=1;n--){const o=document.createElement('option');o.value=String(n);o.textContent=n+' estrellas';score.append(o);}
    const comment=document.createElement('input');comment.placeholder='Comentario (opcional)';comment.maxLength=1000;
    const btn=nuevo('button','Enviar valoración') as HTMLButtonElement;btn.type='submit';
    review.append(score,comment,btn);
    review.addEventListener('submit',async e=>{
     e.preventDefault();
     try{await apiLocal('/reservas/'+b.id+'/valorar',{method:'POST',body:JSON.stringify({
      puntuacion:Number(score.value),comentario:comment.value
     })});estado.textContent='Valoración registrada.';review.remove();
     }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}
    });acciones.append(review);
   }
   if(rol!=='ADMINISTRADOR'&&['CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION'].includes(b.estado)){
    const inc=nuevo('button','Reportar incidencia') as HTMLButtonElement;
    inc.addEventListener('click',async()=>{
     const descripcion=prompt('Describe el problema con esta reserva:');
     if(!descripcion)return;
     try{await apiLocal('/reservas/'+b.id+'/incidencias',{method:'POST',body:JSON.stringify({descripcion})});
      estado.textContent='Incidencia enviada a soporte.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(inc);
   }
   if(rol==='ADMINISTRADOR'&&b.estado==='COMPLETADA'){
    const settle=nuevo('button','Registrar liquidación') as HTMLButtonElement;
    settle.addEventListener('click',async()=>{
     try{await apiLocal('/liquidaciones/'+b.id,{method:'POST'});
      estado.textContent='Liquidación manual registrada.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(settle);
   }
   div.append(acciones);contenedor.append(div);
  }
 };
 const form=root.querySelector<HTMLFormElement>('#reserva-local-form');
 if(form){
  (async()=>{
   const [personas,servicios]=await Promise.all([apiLocal('/acompanantes'),apiLocal('/servicios')]);
   type Persona={dni:string,nombre:string,carrera?:string,institucion?:string,tarifaHora:number};
   const catalogo:Persona[]=personas;
   const acomp=form.querySelector<HTMLInputElement>('#reserva-local-acompanante')!;
   const buscar=form.querySelector<HTMLInputElement>('#reserva-local-buscar')!;
   const picker=form.querySelector<HTMLElement>('#reserva-local-picker')!;
   const opciones=form.querySelector<HTMLElement>('#reserva-local-opciones')!;
   const toggle=form.querySelector<HTMLButtonElement>('#reserva-local-toggle')!;
   const resultados=form.querySelector<HTMLElement>('#reserva-local-resultados')!;
   const normalizar=(v:unknown)=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
   let coincidencias:Persona[]=[];let activo=-1;
   const cerrar=()=>{opciones.hidden=true;buscar.setAttribute('aria-expanded','false');buscar.removeAttribute('aria-activedescendant');activo=-1;};
   const marcar=(i:number)=>{
    activo=i;
    opciones.querySelectorAll<HTMLElement>('[role=option]').forEach((el,j)=>el.setAttribute('aria-selected',String(i===j)));
    const el=opciones.children[i] as HTMLElement|undefined;
    if(el){buscar.setAttribute('aria-activedescendant',el.id);el.scrollIntoView({block:'nearest'});}
    else buscar.removeAttribute('aria-activedescendant');
   };
   const elegir=(x:Persona)=>{
    acomp.value=x.dni;buscar.value=x.nombre;buscar.setCustomValidity('');cerrar();
    acomp.dispatchEvent(new Event('change'));buscar.focus();cerrar();
   };
   const filtrar=(todos=false)=>{
    const q=todos?[]:normalizar(buscar.value).split(/\s+/).filter(Boolean);
    coincidencias=catalogo.filter(x=>q.every(t=>normalizar([x.nombre,x.carrera,x.institucion].join(' ')).includes(t)));
    opciones.replaceChildren();activo=-1;buscar.removeAttribute('aria-activedescendant');
    coincidencias.forEach((x,i)=>{
     const item=document.createElement('div');item.className='companion-option';item.id='reserva-opcion-'+i;
     item.setAttribute('role','option');item.setAttribute('aria-selected','false');
     const info=document.createElement('div');
     info.append(nuevo('strong',x.nombre),nuevo('small',[x.carrera,x.institucion].filter(Boolean).join(' · ')));
     const tarifa=nuevo('span',importe(x.tarifaHora)+'/h');tarifa.className='companion-option-price';
     item.append(info,tarifa);
     item.addEventListener('pointerdown',ev=>ev.preventDefault());
     item.addEventListener('click',()=>elegir(x));opciones.append(item);
    });
    if(!coincidencias.length){const vacio=nuevo('div','No se encontraron acompañantes.');vacio.className='companion-empty';opciones.append(vacio);}
    resultados.textContent=coincidencias.length+' resultados';
    opciones.hidden=false;buscar.setAttribute('aria-expanded','true');
   };
   buscar.disabled=false;toggle.disabled=false;
   buscar.addEventListener('focus',()=>filtrar(Boolean(acomp.value)));
   buscar.addEventListener('click',()=>{if(opciones.hidden)filtrar(Boolean(acomp.value));});
   buscar.addEventListener('input',()=>{
    if(acomp.value){acomp.value='';acomp.dispatchEvent(new Event('change'));}
    buscar.setCustomValidity(buscar.value?'Selecciona un acompañante de la lista.':'');
    filtrar();
   });
   toggle.addEventListener('click',()=>{if(!opciones.hidden)cerrar();else{buscar.focus();filtrar(Boolean(acomp.value));}});
   buscar.addEventListener('keydown',ev=>{
    if(ev.key==='Escape'){cerrar();return;}
    if(ev.key==='Tab'){cerrar();return;}
    if(ev.key==='ArrowDown'||ev.key==='ArrowUp'){
     ev.preventDefault();if(opciones.hidden)filtrar(Boolean(acomp.value));
     if(coincidencias.length)marcar(ev.key==='ArrowDown'?(activo+1)%coincidencias.length:(activo<0?coincidencias.length-1:(activo-1+coincidencias.length)%coincidencias.length));
    }
    if(ev.key==='Enter'&&!opciones.hidden){ev.preventDefault();if(activo>=0)elegir(coincidencias[activo]);else if(coincidencias.length===1)elegir(coincidencias[0]);}
   });
   document.addEventListener('pointerdown',ev=>{if(ev.target instanceof Node&&!picker.contains(ev.target))cerrar();});
   picker.addEventListener('focusout',ev=>{if(!(ev.relatedTarget instanceof Node)||!picker.contains(ev.relatedTarget))cerrar();});
   form.addEventListener('reset',()=>{cerrar();buscar.setCustomValidity('');queueMicrotask(()=>{acomp.value='';acomp.dispatchEvent(new Event('change'));});});
   const ficha=form.querySelector<HTMLElement>('#reserva-local-ficha')!;
   const foto=form.querySelector<HTMLImageElement>('#reserva-local-foto')!;
   const campo=(id:string,valor:string)=>{const e=form.querySelector<HTMLElement>('#'+id);if(e)e.textContent=valor;};
   const rating=form.querySelector<HTMLElement>('#reserva-local-calificacion')!;
   const resenas=form.querySelector<HTMLDetailsElement>('#reserva-local-resenas')!;
   const resenasLista=form.querySelector<HTMLElement>('#reserva-local-resenas-lista')!;
   const estrellas=(valor:number)=>{
    const v=Math.max(0,Math.min(5,Number.isFinite(valor)?valor:0));
    const grupo=nuevo('span','★★★★★');grupo.className='companion-stars';grupo.setAttribute('role','img');grupo.setAttribute('aria-label',v.toFixed(1)+' de 5 estrellas');
    const relleno=nuevo('span','★★★★★');relleno.className='companion-stars-fill';relleno.style.width=(v/5*100)+'%';relleno.setAttribute('aria-hidden','true');grupo.append(relleno);return grupo;
   };
   let consulta=0;
   let cargadas=false;
   let cargando=false;
   resenas.addEventListener('toggle',async()=>{
    if(!resenas.open||cargadas||cargando||!acomp.value)return;
    const seleccion=consulta,dni=acomp.value;cargando=true;
    resenasLista.replaceChildren(nuevo('p','Cargando reseñas…'));
    try{
     const perfil=personas.find((p:any)=>p.dni===dni);
     const datos=Array.isArray(perfil?.resenas)?perfil.resenas:await apiLocal('/acompanantes/'+encodeURIComponent(dni)+'/resenas');
     if(seleccion!==consulta)return;
     resenasLista.replaceChildren();
     if(!datos.length)resenasLista.append(nuevo('p','Este acompañante aún no tiene reseñas.'));
     for(const v of datos){
      const item=document.createElement('article');item.className='companion-review';
      const encabezado=document.createElement('div');encabezado.className='companion-review-heading';
      const fecha=nuevo('span',new Date(v.creadoEn).toLocaleDateString('es-PE',{day:'numeric',month:'long',year:'numeric',timeZone:'America/Lima'}));fecha.className='companion-review-date';
      encabezado.append(estrellas(Number(v.puntuacion)),nuevo('strong',Number(v.puntuacion).toFixed(1)+' / 5'),fecha);
      item.append(encabezado,nuevo('p',v.comentario||'Valoración sin comentario.'));resenasLista.append(item);
     }
     cargadas=true;
    }catch(e){if(seleccion===consulta){
     const detalle=e instanceof Error?e.message:String(e);
     resenasLista.replaceChildren(nuevo('p','No se pudieron cargar las reseñas: '+detalle));
     console.error('Error al consultar reseñas del acompañante',e);
    }}
    finally{if(seleccion===consulta)cargando=false;}
   });
   acomp.addEventListener('change',async()=>{
    const seleccion=++consulta;
    resenas.open=false;cargadas=false;cargando=false;resenasLista.replaceChildren();
    const x=personas.find((persona:any)=>persona.dni===acomp.value);
    limpiarFoto(foto);
    if(!x){ficha.hidden=true;return;}
    ficha.hidden=false;
    campo('reserva-local-nombre',x.nombre);
    campo('reserva-local-carrera',[x.carrera,x.ciclo?'Ciclo '+x.ciclo:null].filter(Boolean).join(' · '));
    campo('reserva-local-institucion','Institución: '+(x.institucion||'No registrada'));
    campo('reserva-local-bio',x.biografia||'El acompañante aún no ha añadido una biografía.');
    campo('reserva-local-tarifa','Tarifa: '+importe(x.tarifaHora)+' por hora');
    const cantidad=Number(x.totalCalificaciones||0);
    const tieneValoracion=cantidad>0&&x.promedioCalificacion!=null;
    rating.replaceChildren(estrellas(tieneValoracion?Number(x.promedioCalificacion):0),nuevo('strong',tieneValoracion?Number(x.promedioCalificacion).toFixed(1)+' / 5':'Sin calificaciones'),nuevo('span',cantidad+' '+(cantidad===1?'opinión':'opiniones')));
    resenas.querySelector('summary')!.textContent='Ver reseñas ('+cantidad+')';
    campo('reserva-local-horarios','Consultando disponibilidad...');
    if(x.fotoUrl) void mostrarFotoProtegida(x.dni,foto);
    try{
     const horarios=await apiLocal('/acompanantes/'+encodeURIComponent(x.dni)+'/disponibilidad');
     if(seleccion!==consulta)return;
     const dias=['','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
     campo('reserva-local-horarios',horarios.length
      ? horarios.map((h:any)=>dias[h.diaSemana]+': '+h.horaInicio.slice(0,5)+'–'+h.horaFin.slice(0,5)).join(' · ')
      : 'Sin horarios registrados');
    }catch{if(seleccion===consulta)campo('reserva-local-horarios','No se pudo consultar la disponibilidad');}
   });
   const lista=form.querySelector<HTMLSelectElement>('#reserva-local-servicio')!;
   for(const s of servicios){const opt=document.createElement('option');opt.value=s.id;opt.textContent=s.nombre;lista.append(opt);}
   if(rol==='FAMILIAR'){
    const links=await apiLocal('/vinculos');
    const adultos=form.querySelector<HTMLSelectElement>('#reserva-local-adulto')!;
    for(const v of links.filter((v:any)=>v.estado==='ACEPTADO'&&v.permiteReservar)){
     const opt=document.createElement('option');opt.value=v.adultoMayorDni;opt.textContent=v.adultoMayorNombre;adultos.append(opt);
    }
   }
  })().catch(e=>estado.textContent=String(e));
  form.addEventListener('submit',async ev=>{
   ev.preventDefault();const fd=new FormData(form);
   if(!fd.get('acompananteDni')){const input=form.querySelector<HTMLInputElement>('#reserva-local-buscar');input?.setCustomValidity('Selecciona un acompañante de la lista.');input?.reportValidity();return;}
   const inicio=new Date(String(fd.get('inicio'))),fin=new Date(String(fd.get('fin')));
   if(!Number.isFinite(inicio.getTime())||!Number.isFinite(fin.getTime())){estado.textContent='Fechas inválidas';return;}
   try{estado.textContent='Registrando solicitud…';
    await apiLocal('/reservas',{method:'POST',body:JSON.stringify({
     adultoMayorDni:rol==='FAMILIAR'?String(fd.get('adultoMayorDni')):session.dni,
     acompananteDni:String(fd.get('acompananteDni')),servicioId:Number(fd.get('servicioId')),
     inicio:inicio.toISOString(),fin:fin.toISOString(),
     direccion:String(fd.get('direccion')),indicaciones:String(fd.get('indicaciones')||'')
    })});form.reset();estado.textContent='Solicitud enviada al acompañante.';await refrescar();
   }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
  });
 }
 window.addEventListener('pagehide',()=>contenedor.querySelectorAll<HTMLImageElement>('img').forEach(limpiarFoto));
 refrescar().catch(e=>estado.textContent=String(e));
</script>
