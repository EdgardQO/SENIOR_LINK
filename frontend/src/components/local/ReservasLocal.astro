---
interface Props { rol: 'ADULTO_MAYOR'|'FAMILIAR'|'ACOMPANANTE'|'ADMINISTRADOR' }
const {rol}=Astro.props;
const cliente=rol==='ADULTO_MAYOR'||rol==='FAMILIAR';
---
<section class="local-card" data-reservas-rol={rol}>
 <h2>{cliente?'Solicitar acompañamiento':rol==='ACOMPANANTE'?'Solicitudes y agenda':'Reservas registradas'}</h2>
 {cliente && <form id="reserva-local-form" class="local-form">
  {rol==='FAMILIAR' && <label>Adulto mayor autorizado<select name="adultoMayorDni" id="reserva-local-adulto" required><option value="">Selecciona un adulto autorizado</option></select></label>}
  <label>Acompañante<select name="acompananteDni" id="reserva-local-acompanante" required><option value="">Selecciona un acompañante</option></select></label>
  <section id="reserva-local-ficha" class="local-companion-card" aria-live="polite" hidden>
    <div class="local-companion-heading">
      <img id="reserva-local-foto" alt="Fotografía del acompañante seleccionado" hidden />
      <div><strong id="reserva-local-nombre"></strong><p id="reserva-local-carrera"></p></div>
    </div>
    <p id="reserva-local-institucion"></p>
    <p id="reserva-local-bio"></p>
    <p id="reserva-local-tarifa"></p>
    <p id="reserva-local-calificacion"></p>
    <h3>Horarios de atención</h3>
    <p id="reserva-local-horarios">Consultando disponibilidad...</p>
  </section>
  <label>Servicio<select name="servicioId" id="reserva-local-servicio" required><option value="">Selecciona un servicio</option></select></label>
  <label>Inicio<input name="inicio" type="datetime-local" required/></label>
  <label>Fin<input name="fin" type="datetime-local" required/></label>
  <label>Dirección de encuentro<input name="direccion" maxlength="1000" required/></label>
  <label>Indicaciones adicionales<textarea name="indicaciones" rows="2"></textarea></label>
  <button type="submit">Enviar solicitud</button>
 </form>}
 <p id="reserva-local-status" role="status" aria-live="polite"></p>
 <div id="reserva-local-list" class="local-list"></div>
 {cliente && <p>Modo de prueba: para pagar, registra una tarjeta en <a href={rol==='FAMILIAR'?'/familiar/metodos-pago':'/adulto-mayor/metodos-pago'}>Mis métodos de pago</a>.</p>}
</section>
<style>
 .local-companion-card{border:1px solid #cbe6db;background:#f5fbf8;padding:17px;border-radius:15px;display:grid;gap:7px}
 .local-companion-card[hidden]{display:none}
 .local-companion-heading{display:flex;align-items:center;gap:13px}
 .local-companion-heading img{width:78px;height:78px;border-radius:50%;object-fit:cover;flex-shrink:0}
 .local-companion-heading img[hidden]{display:none}
 .local-companion-card p{margin:3px 0;line-height:1.5;font-size:13px}
 .local-companion-card h3{font-size:14px;margin:10px 0 0;color:#12695d}
 </style>
<script>
 import {apiLocal,horaLocal,importe,sesionRequerida} from '../../lib/local-api';
 import {mostrarFotoProtegida,limpiarFoto} from '../../lib/profile-photo';
 const root=document.querySelector<HTMLElement>('[data-reservas-rol]')!;
 const rol=root.dataset.reservasRol!;
 const estado=root.querySelector<HTMLElement>('#reserva-local-status')!;
 const contenedor=root.querySelector<HTMLElement>('#reserva-local-list')!;
 const session=sesionRequerida();
 const nuevo=(tag:string,texto:string)=>{const e=document.createElement(tag);e.textContent=texto;return e;};
 const refrescar=async()=>{
  const bookings=await apiLocal('/reservas');
  const medios=(rol==='ADULTO_MAYOR'||rol==='FAMILIAR')?await apiLocal('/metodos-pago'):[];
  contenedor.replaceChildren();
  if(!bookings.length){contenedor.textContent='No hay reservas para mostrar.';return;}
  for(const b of bookings){
   const div=document.createElement('article');div.className='local-item local-booking';
   div.append(nuevo('strong','#'+b.id+' · '+b.estado.replaceAll('_',' ')));
   div.append(nuevo('p',b.adultoMayorNombre+' · '+b.acompananteNombre));
   div.append(nuevo('p',horaLocal(b.inicio)+' — '+horaLocal(b.fin)+' · '+importe(b.montoTotal)));
   const acciones=document.createElement('div');acciones.className='local-actions';
   const accion=(nombre:string,ruta:string)=>{
    const btn=nuevo('button',nombre) as HTMLButtonElement;btn.type='button';
    btn.addEventListener('click',async()=>{
     try{estado.textContent='Procesando…';await apiLocal('/reservas/'+b.id+'/'+ruta,{method:'POST'});
      estado.textContent='Actualización guardada.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(btn);
   };
   if(rol==='ACOMPANANTE'){
    if(b.estado==='PENDIENTE_ACEPTACION'){accion('Aceptar','aceptar');accion('Rechazar','rechazar');}
    if(b.estado==='CONFIRMADA')accion('Iniciar','iniciar');
    if(b.estado==='EN_PROGRESO')accion('Finalizar','finalizar');
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR')&&b.estado==='PENDIENTE_CONFIRMACION')accion('Confirmar servicio','confirmar');
   if(['PENDIENTE_ACEPTACION','PENDIENTE_PAGO','CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION'].includes(b.estado) && rol!=='ADMINISTRADOR')
    accion('Cancelar / reportar','cancelar');
   if(rol==='ADMINISTRADOR' && (b.estado==='CANCELADA'||b.estado==='EN_DISPUTA')){
    const refund=nuevo('button','Reembolsar pago') as HTMLButtonElement;
    refund.addEventListener('click',async()=>{
     if(!confirm('¿Registrar el reembolso de esta reserva?'))return;
     try{const res=await apiLocal('/admin/reservas/'+b.id+'/reembolsar',{method:'POST'});
      estado.textContent='Resultado del reembolso: '+res.estado;await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(refund);
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR')&&b.estado==='PENDIENTE_PAGO'){
    const pago=document.createElement('form');pago.className='local-form';
    const sel=document.createElement('select');sel.required=true;
    const n=document.createElement('option');n.value='';n.textContent='Seleccionar tarjeta';sel.append(n);
    for(const m of medios){const opt=document.createElement('option');opt.value=m.id;opt.textContent=m.tipo+' '+m.numeroEnmascarado;sel.append(opt);}
    const cvv=document.createElement('input');cvv.type='password';cvv.placeholder='CVV';cvv.required=true;cvv.pattern='[0-9]{3,4}';cvv.autocomplete='off';
    const btn=nuevo('button','Pagar '+importe(b.montoTotal)) as HTMLButtonElement;btn.type='submit';
    const clave=crypto.randomUUID();
    pago.append(sel,cvv,btn);
    pago.addEventListener('submit',async ev=>{
     ev.preventDefault();
     try{
      estado.textContent='Procesando el cobro…';
      const res=await apiLocal('/reservas/'+b.id+'/pagar',{method:'POST',body:JSON.stringify({
       metodoId:sel.value,claveIdempotencia:clave,cvv:cvv.value
      })});
      cvv.value='';estado.textContent=res.estado==='APROBADO'?'Pago aprobado':'Pago rechazado: '+res.codigo;
      await refrescar();
     }catch(e){cvv.value='';estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(pago);
   }
   if((rol==='ADULTO_MAYOR'||rol==='FAMILIAR') && b.estado==='COMPLETADA'){
    const review=document.createElement('form');review.className='local-form';
    const score=document.createElement('select');
    for(let n=5;n>=1;n--){const o=document.createElement('option');o.value=String(n);o.textContent=n+' estrellas';score.append(o);}
    const comment=document.createElement('input');comment.placeholder='Comentario (opcional)';comment.maxLength=1000;
    const btn=nuevo('button','Enviar valoración') as HTMLButtonElement;btn.type='submit';
    review.append(score,comment,btn);
    review.addEventListener('submit',async e=>{
     e.preventDefault();
     try{await apiLocal('/reservas/'+b.id+'/valorar',{method:'POST',body:JSON.stringify({
      puntuacion:Number(score.value),comentario:comment.value
     })});estado.textContent='Valoración registrada.';review.remove();
     }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}
    });acciones.append(review);
   }
   if(rol!=='ADMINISTRADOR'&&['CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION'].includes(b.estado)){
    const inc=nuevo('button','Reportar incidencia') as HTMLButtonElement;
    inc.addEventListener('click',async()=>{
     const descripcion=prompt('Describe el problema con esta reserva:');
     if(!descripcion)return;
     try{await apiLocal('/reservas/'+b.id+'/incidencias',{method:'POST',body:JSON.stringify({descripcion})});
      estado.textContent='Incidencia enviada a soporte.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(inc);
   }
   if(rol==='ADMINISTRADOR'&&b.estado==='COMPLETADA'){
    const settle=nuevo('button','Registrar liquidación') as HTMLButtonElement;
    settle.addEventListener('click',async()=>{
     try{await apiLocal('/liquidaciones/'+b.id,{method:'POST'});
      estado.textContent='Liquidación manual registrada.';await refrescar();
     }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
    });acciones.append(settle);
   }
   div.append(acciones);contenedor.append(div);
  }
 };
 const form=root.querySelector<HTMLFormElement>('#reserva-local-form');
 if(form){
  (async()=>{
   const [personas,servicios]=await Promise.all([apiLocal('/acompanantes'),apiLocal('/servicios')]);
   const acomp=form.querySelector<HTMLSelectElement>('#reserva-local-acompanante')!;
   for(const x of personas){const opt=document.createElement('option');opt.value=x.dni;opt.textContent=x.nombre+' · '+importe(x.tarifaHora)+'/h';acomp.append(opt);}
   const ficha=form.querySelector<HTMLElement>('#reserva-local-ficha')!;
   const foto=form.querySelector<HTMLImageElement>('#reserva-local-foto')!;
   const campo=(id:string,valor:string)=>{const e=form.querySelector<HTMLElement>('#'+id);if(e)e.textContent=valor;};
   let consulta=0;
   acomp.addEventListener('change',async()=>{
    const seleccion=++consulta;
    const x=personas.find((persona:any)=>persona.dni===acomp.value);
    limpiarFoto(foto);
    if(!x){ficha.hidden=true;return;}
    ficha.hidden=false;
    campo('reserva-local-nombre',x.nombre);
    campo('reserva-local-carrera',[x.carrera,x.ciclo?'Ciclo '+x.ciclo:null].filter(Boolean).join(' · '));
    campo('reserva-local-institucion','Institución: '+(x.institucion||'No registrada'));
    campo('reserva-local-bio',x.biografia||'El acompañante aún no ha añadido una biografía.');
    campo('reserva-local-tarifa','Tarifa: '+importe(x.tarifaHora)+' por hora');
    const puntuacion=x.promedioCalificacion==null?'Sin calificaciones':Number(x.promedioCalificacion).toFixed(1)+' / 5';
    campo('reserva-local-calificacion','Calificación: '+puntuacion+' · '+(x.totalCalificaciones||0)+' opiniones');
    campo('reserva-local-horarios','Consultando disponibilidad...');
    if(x.fotoUrl) void mostrarFotoProtegida(x.dni,foto);
    try{
     const horarios=await apiLocal('/acompanantes/'+encodeURIComponent(x.dni)+'/disponibilidad');
     if(seleccion!==consulta)return;
     const dias=['','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
     campo('reserva-local-horarios',horarios.length
      ? horarios.map((h:any)=>dias[h.diaSemana]+': '+h.horaInicio.slice(0,5)+'–'+h.horaFin.slice(0,5)).join(' · ')
      : 'Sin horarios registrados');
    }catch{if(seleccion===consulta)campo('reserva-local-horarios','No se pudo consultar la disponibilidad');}
   });
   const lista=form.querySelector<HTMLSelectElement>('#reserva-local-servicio')!;
   for(const s of servicios){const opt=document.createElement('option');opt.value=s.id;opt.textContent=s.nombre;lista.append(opt);}
   if(rol==='FAMILIAR'){
    const links=await apiLocal('/vinculos');
    const adultos=form.querySelector<HTMLSelectElement>('#reserva-local-adulto')!;
    for(const v of links.filter((v:any)=>v.estado==='ACEPTADO'&&v.permiteReservar)){
     const opt=document.createElement('option');opt.value=v.adultoMayorDni;opt.textContent=v.adultoMayorNombre;adultos.append(opt);
    }
   }
  })().catch(e=>estado.textContent=String(e));
  form.addEventListener('submit',async ev=>{
   ev.preventDefault();const fd=new FormData(form);
   const inicio=new Date(String(fd.get('inicio'))),fin=new Date(String(fd.get('fin')));
   if(!Number.isFinite(inicio.getTime())||!Number.isFinite(fin.getTime())){estado.textContent='Fechas inválidas';return;}
   try{estado.textContent='Registrando solicitud…';
    await apiLocal('/reservas',{method:'POST',body:JSON.stringify({
     adultoMayorDni:rol==='FAMILIAR'?String(fd.get('adultoMayorDni')):session.dni,
     acompananteDni:String(fd.get('acompananteDni')),servicioId:Number(fd.get('servicioId')),
     inicio:inicio.toISOString(),fin:fin.toISOString(),
     direccion:String(fd.get('direccion')),indicaciones:String(fd.get('indicaciones')||'')
    })});form.reset();estado.textContent='Solicitud enviada al acompañante.';await refrescar();
   }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
  });
 }
 refrescar().catch(e=>estado.textContent=String(e));
</script>
