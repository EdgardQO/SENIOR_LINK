<section class="local-card">
 <h2>Incidencias y cancelaciones</h2>
 <p>Las incidencias se revisan por soporte. Registrar la resolución no produce automáticamente un reembolso: administración debe autorizarlo.</p>
 <p id="incidencia-local-estado" role="status" aria-live="polite"></p>
 <section class="inc-filtros" aria-label="Filtros de incidencias">
  <div class="inc-tabs" role="group" aria-label="Estado de incidencia">
   {['Todas','Abiertas','Resueltas'].map((nombre,i)=><button type="button" data-inc-estado={['TODAS','ABIERTA','RESUELTA'][i]} aria-pressed={i===0?'true':'false'}>{nombre} <span class="inc-count">0</span></button>)}
  </div>
  <form id="inc-filtros-form" class="inc-form">
   <label class="inc-busqueda">Buscar incidencia<input name="buscar" type="search" placeholder="Número de incidencia, reserva, reportante, descripción o resolución" autocomplete="off"/></label>
   <label>Desde<input name="desde" type="date"/></label>
   <label>Hasta<input name="hasta" type="date"/></label>
   <label>Ordenar por<select name="orden"><option value="recientes">Más recientes</option><option value="antiguas">Más antiguas</option><option value="pendientes">Abiertas primero</option></select></label>
   <button class="inc-reset" type="reset">Limpiar filtros</button>
  </form>
  <p id="inc-resultados" role="status" aria-live="polite">Cargando incidencias…</p>
 </section>
 <div id="incidencia-local-list" class="local-list"></div>
</section>
<style>
.inc-filtros{display:grid;gap:14px;margin:16px 0}
.inc-tabs{display:flex;flex-wrap:wrap;gap:8px}
.inc-tabs button{display:inline-flex;align-items:center;gap:8px;border:1px solid #d5e5df;background:white;color:#355e53;border-radius:9px;padding:10px 14px;font:inherit;cursor:pointer}
.inc-tabs button[aria-pressed=true]{background:#087a70;border-color:#087a70;color:white}
.inc-count{font-size:11px;min-width:22px;text-align:center;border-radius:10px;background:#e7f3ee;color:#285b50;padding:2px 5px}
.inc-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:end;background:#f5faf8;border:1px solid #dce8e3;border-radius:12px;padding:16px}
.inc-form label{display:grid;gap:6px;font-size:13px;color:#355e53;min-width:0}
.inc-form input,.inc-form select{width:100%;min-width:0;border:1px solid #cbded6;border-radius:8px;background:white;padding:10px;font:inherit;color:#173d35}
.inc-busqueda{grid-column:1/-1}
.inc-form .inc-reset{background:#e3f1eb;color:#087a70;border:0;border-radius:8px;padding:11px;font:inherit;cursor:pointer}
.inc-form button:focus-visible,.inc-tabs button:focus-visible{outline:2px solid #087a70;outline-offset:3px}
#inc-resultados{margin:0;color:#527067;font-size:13px}
@media(max-width:520px){.inc-form{grid-template-columns:1fr}.inc-tabs button{flex:1 1 auto;justify-content:space-between}}
</style>
<script>
 import {apiLocal,horaLocal} from '../../lib/local-api';
 const list=document.querySelector<HTMLElement>('#incidencia-local-list')!;
 const estado=document.querySelector<HTMLElement>('#incidencia-local-estado')!;
 type Incidencia={id:number,reservaId:number,reportadoPor:string,descripcion:string,estado:string,resolucion?:string,creadoEn:string};
 const filtros=document.querySelector<HTMLFormElement>('#inc-filtros-form')!;
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-inc-estado]'));
 const resultados=document.querySelector<HTMLElement>('#inc-resultados')!;
 const params=new URLSearchParams(window.location.search);
 let grupo=['ABIERTA','RESUELTA'].includes(params.get('estado')||'')?params.get('estado')!:'TODAS';
 (filtros.elements.namedItem('buscar') as HTMLInputElement).value=params.get('buscar')||'';
 let datos:Incidencia[]=[];
 const borradores=new Map<number,string>();
 const normalizar=(v:unknown)=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
 const fechaLima=(v:string)=>{if(!Number.isFinite(Date.parse(v)))return '';const partes=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date(v));const p=Object.fromEntries(partes.map(x=>[x.type,x.value]));return p.year+'-'+p.month+'-'+p.day;};
 const cargar=async()=>{datos=await apiLocal('/incidencias');render();};
 const render=()=>{
  const f=new FormData(filtros);const q=normalizar(f.get('buscar')).split(/\s+/).filter(Boolean);
  const desde=String(f.get('desde')||''),hasta=String(f.get('hasta')||''),orden=String(f.get('orden')||'');
  for(const tab of tabs){const g=tab.dataset.incEstado;tab.setAttribute('aria-pressed',String(g===grupo));tab.querySelector('.inc-count')!.textContent=String(datos.filter(i=>g==='TODAS'||i.estado===g).length);}
  const filtradas=datos.filter(i=>{const texto=normalizar([i.id,i.reservaId,i.reportadoPor,i.descripcion,i.resolucion,i.estado].join(' '));const fecha=fechaLima(i.creadoEn);return (grupo==='TODAS'||i.estado===grupo)&&q.every(t=>texto.includes(t))&&(!desde||fecha>=desde)&&(!hasta||fecha<=hasta)&&(!desde||!hasta||desde<=hasta);});
  filtradas.sort((a,b)=>{if(orden==='pendientes'&&a.estado!==b.estado)return Number(b.estado==='ABIERTA')-Number(a.estado==='ABIERTA');return orden==='antiguas'?Date.parse(a.creadoEn)-Date.parse(b.creadoEn):Date.parse(b.creadoEn)-Date.parse(a.creadoEn);});
  resultados.textContent=filtradas.length+' de '+datos.length+' incidencias'+(desde&&hasta&&desde>hasta?' · El rango de fechas es inválido.':'');
  list.replaceChildren();
  if(!filtradas.length){list.textContent=datos.length?'No hay incidencias que coincidan con los filtros.':'No hay incidencias registradas.';return;}
  for(const i of filtradas){
   const box=document.createElement('article');box.className='local-item local-booking';
   const title=document.createElement('strong');title.textContent='Incidencia #'+i.id+' · reserva #'+i.reservaId+' · '+i.estado;
   const detalle=document.createElement('p');detalle.textContent=i.descripcion;
   const meta=document.createElement('p');meta.textContent='Reportada por '+i.reportadoPor+' · '+horaLocal(i.creadoEn);
   box.append(title,detalle,meta);
   if(i.resolucion){const p=document.createElement('p');p.textContent='Resolución: '+i.resolucion;box.append(p);}
   if(i.estado==='ABIERTA'){
    const form=document.createElement('form');form.className='local-form';
    const campo=document.createElement('textarea');campo.required=true;campo.maxLength=2000;
    campo.placeholder='Conclusión de la revisión de soporte';campo.setAttribute('aria-label','Resolución de incidencia '+i.id);campo.value=borradores.get(i.id)||'';campo.addEventListener('input',()=>borradores.set(i.id,campo.value));
    const boton=document.createElement('button');boton.type='submit';boton.textContent='Registrar resolución';
    form.append(campo,boton);
    form.addEventListener('submit',async e=>{
     e.preventDefault();if(boton.disabled)return;boton.disabled=true;
     try{await apiLocal('/incidencias/'+i.id+'/resolver',{method:'POST',body:JSON.stringify({resolucion:campo.value})});
      borradores.delete(i.id);estado.textContent='Resolución registrada.';await cargar();
     }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}finally{boton.disabled=false;}
    });box.append(form);
   }list.append(box);
  }
 };
 for(const tab of tabs)tab.addEventListener('click',()=>{grupo=tab.dataset.incEstado||'TODAS';render();});
 filtros.addEventListener('submit',e=>e.preventDefault());
 filtros.addEventListener('input',render);
 filtros.addEventListener('reset',()=>{grupo='TODAS';queueMicrotask(render);});
 cargar().catch(e=>{estado.textContent=String(e);resultados.textContent='No se pudieron cargar las incidencias.';});
</script>
