<section class="local-card">
 <h2>Métodos de pago</h2>
 <div class="local-test-notice"><p>Entorno local · Sin cargos reales. No introduzcas información bancaria real.</p></div>
 <div class="local-payment-grid"><section class="local-payment-panel"><h3>Agregar tarjeta</h3>
 <div class="local-card-preview" aria-hidden="true"><span>SeniorLink</span><strong id="preview-number">•••• •••• •••• ••••</strong><div><span id="preview-name">TITULAR DE LA TARJETA</span><span id="preview-expiry">MM / AAAA</span></div></div>
 <form id="demo-card-form" class="local-form">
  <label>Nombre del titular<input name="nombreTitular" type="text" maxlength="150" required autocomplete="off"/></label>
  <label>Identificador de tarjeta de simulación<input name="numeroDemo" type="text" placeholder="DEMO-00000000" pattern="DEMO-[0-9]{8}" maxlength="13" required autocomplete="off" aria-describedby="tarjeta-numero-info"/></label><small id="tarjeta-numero-info">Usa únicamente una tarjeta existente del catálogo local de simulación.</small>
  <label>Tipo de tarjeta<select name="tipo"><option value="DEBITO">Débito</option><option value="CREDITO">Crédito</option></select></label>
  <label>Mes de vencimiento<input name="mesVencimiento" type="number" min="1" max="12" placeholder="MM" required/></label>
  <label>Año de vencimiento<input name="anioVencimiento" type="number" min="2026" max="2199" placeholder="AAAA" required/></label>
  <label>Código de seguridad de simulación<input name="cvv" type="password" inputmode="numeric" pattern="[0-9]{3,4}" maxlength="4" autocomplete="off" required/></label>
  <button type="submit">Validar y guardar tarjeta</button>
 </form>
 <p id="demo-card-status" role="status" aria-live="polite"></p>
 </section><section class="local-payment-panel"><h3>Tarjetas guardadas</h3><div id="demo-card-list" class="local-list"></div></section></div>
</section>
<script>
 import {apiLocal} from '../../lib/local-api';
 const form=document.querySelector<HTMLFormElement>('#demo-card-form')!;
 const list=document.querySelector<HTMLElement>('#demo-card-list')!;
 const estado=document.querySelector<HTMLElement>('#demo-card-status')!;
 const submit=form.querySelector<HTMLButtonElement>('button[type=submit]')!;
 const preview=()=>{const fd=new FormData(form);document.querySelector('#preview-name')!.textContent=String(fd.get('nombreTitular')||'TITULAR DE LA TARJETA').toUpperCase();const numero=String(fd.get('numeroDemo')||'');document.querySelector('#preview-number')!.textContent='•••• •••• •••• '+(/^DEMO-[0-9]{8}$/.test(numero)?numero.slice(-4):'••••');document.querySelector('#preview-expiry')!.textContent=String(fd.get('mesVencimiento')||'MM').padStart(2,'0')+' / '+String(fd.get('anioVencimiento')||'AAAA');};
 form.addEventListener('input',preview);
 const cargar=async()=>{
  const datos=await apiLocal('/metodos-pago');
  list.replaceChildren();
  if(!datos.length){list.textContent='Todavía no has guardado tarjetas.';return;}
  for(const item of datos){
   const row=document.createElement('div');row.className='local-item';
   const span=document.createElement('span');
   span.textContent=(item.tipo==='DEBITO'?'Débito':'Crédito')+' · '+item.numeroEnmascarado+' · Vence '+item.mesVencimiento+'/'+item.anioVencimiento;
   const btn=document.createElement('button');btn.type='button';btn.textContent='Quitar';
   btn.addEventListener('click',async()=>{
    if(!confirm('¿Quitar este método de pago?'))return;
    try{await apiLocal('/metodos-pago/'+item.id,{method:'DELETE'});await cargar();}catch(e){estado.textContent=String(e);}
   });row.append(span,btn);list.append(row);
  }
 };
 form.addEventListener('submit',async e=>{
  e.preventDefault();if(submit.disabled)return;submit.disabled=true;estado.textContent='Validando tarjeta…';
  const fd=new FormData(form);
  try{
   await apiLocal('/metodos-pago',{method:'POST',body:JSON.stringify({
    nombreTitular:String(fd.get('nombreTitular')),tipo:String(fd.get('tipo')),
    numeroDemo:String(fd.get('numeroDemo')).trim(),
    mesVencimiento:Number(fd.get('mesVencimiento')),
    anioVencimiento:Number(fd.get('anioVencimiento')),
    cvv:String(fd.get('cvv'))})});
   form.reset();preview();estado.textContent='Tarjeta guardada correctamente.';await cargar();
  }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}finally{(form.elements.namedItem('cvv') as HTMLInputElement).value='';submit.disabled=false;}
 });
 cargar().catch(e=>estado.textContent=String(e));
</script>
