<section class="pay-workspace">
 <header class="pay-heading"><div class="pay-brand"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 10h18m-6 5h3M5 5l12-3"/></svg> SeniorLink Pay</div><p>Gestiona tus tarjetas y selecciona un método al pagar tus reservas.</p><span class="pay-tag">Entorno de pruebas</span></header>
 <div class="local-payment-grid">
 <section class="local-card local-payment-panel"><h2>Tarjetas guardadas</h2><p>Tus métodos disponibles para realizar pagos.</p><div id="demo-card-list" class="local-list"></div></section>
 <section class="local-card local-payment-panel"><h2>Agregar nueva tarjeta</h2><p>Registra una tarjeta existente del catálogo de pruebas.</p>
 <div class="local-card-preview" aria-hidden="true"><span>SeniorLink Pay · Pruebas</span><strong id="preview-number">•••• •••• •••• ••••</strong><div><span id="preview-name">TITULAR DE LA TARJETA</span><span id="preview-expiry">MM / AAAA</span></div></div>
 <form id="demo-card-form" class="local-form">
  <label>Nombre del titular<input name="nombreTitular" type="text" placeholder="Nombre del titular registrado" maxlength="150" required autocomplete="off"/></label>
  <label>Identificador de tarjeta<input name="numeroDemo" type="text" placeholder="DEMO-00000000" pattern="DEMO-[0-9]{8}" maxlength="13" required autocomplete="off" aria-describedby="tarjeta-numero-info"/></label><small id="tarjeta-numero-info">No ingreses información bancaria real.</small>
  <label>Tipo de tarjeta<select name="tipo"><option value="DEBITO">Débito</option><option value="CREDITO">Crédito</option></select></label>
  <div class="pay-fields"><label>Mes<input name="mesVencimiento" type="number" min="1" max="12" placeholder="MM" required/></label><label>Año<input name="anioVencimiento" type="number" min="2026" max="2199" placeholder="AAAA" required/></label><label>CVV de prueba<input name="cvv" type="password" inputmode="numeric" pattern="[0-9]{3,4}" maxlength="4" autocomplete="off" required placeholder="•••"/></label></div>
  <button type="submit">Registrar tarjeta</button>
 </form><p id="demo-card-status" role="status" aria-live="polite"></p></section></div>
 <footer class="pay-safety"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3 8 3v6c0 5-5 8-8 10-3-2-8-5-8-10V6zM8 12l3 3 5-6"/></svg><strong>Datos protegidos</strong><span>Las tarjetas se vinculan mediante tokens y se muestran enmascaradas. Solo operaciones de prueba.</span></footer>
</section>
<style>
.pay-workspace{display:grid;gap:16px}.pay-heading,.pay-safety{display:flex;align-items:center;gap:18px;flex-wrap:wrap;background:#e9f7f1;border:1px solid #d5ebe1;padding:18px 20px;border-radius:14px}.pay-brand{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:750;color:#173d35}.pay-brand svg,.pay-safety svg{color:#087a70;flex-shrink:0}.pay-heading p{flex:1;min-width:180px;color:#405d55;margin:0;font-size:13px}.pay-tag{font-size:12px;color:#12634a;background:#d7f1e0;border-radius:7px;padding:6px 10px}.pay-workspace .local-card{margin:0}.pay-workspace .local-payment-grid{gap:16px;align-items:stretch}.pay-workspace .local-card-preview{max-width:none;min-height:120px;gap:16px;margin:16px 0;background:linear-gradient(135deg,#173d35,#087a70)}.pay-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.pay-safety span{flex:1;min-width:160px;color:#405d55;font-size:12px}#tarjeta-numero-info{color:#52665f;font-size:12px}.pay-workspace :global(.pay-saved){display:flex;align-items:center;gap:12px;background:#eef8f4}.pay-workspace :global(.pay-card-mark){border:1px solid #d5e7df;background:white;color:#087a70;padding:9px;border-radius:8px;font-weight:700;font-size:11px}.pay-workspace :global(.pay-card-info){flex:1;min-width:110px}.pay-workspace :global(.pay-card-info small){display:block;margin-top:5px;color:#52665f}.pay-workspace :global(.pay-remove){background:#fff;color:#405d55;border:1px solid #cbdad5;font-size:12px}.pay-workspace :global(.pay-remove:hover){background:#e4f0eb;color:#173d35}@media(max-width:480px){.pay-fields{grid-template-columns:1fr 1fr}.pay-fields label:last-child{grid-column:1/-1}}
</style>
<script>
 import {apiPagoLocal} from '../../lib/local-api';
 const form=document.querySelector<HTMLFormElement>('#demo-card-form')!;
 const list=document.querySelector<HTMLElement>('#demo-card-list')!;
 const estado=document.querySelector<HTMLElement>('#demo-card-status')!;
 const submit=form.querySelector<HTMLButtonElement>('button[type=submit]')!;
 const preview=()=>{const fd=new FormData(form);document.querySelector('#preview-name')!.textContent=String(fd.get('nombreTitular')||'TITULAR DE LA TARJETA').toUpperCase();const numero=String(fd.get('numeroDemo')||'');document.querySelector('#preview-number')!.textContent='•••• •••• •••• '+(/^DEMO-[0-9]{8}$/.test(numero)?numero.slice(-4):'••••');document.querySelector('#preview-expiry')!.textContent=String(fd.get('mesVencimiento')||'MM').padStart(2,'0')+' / '+String(fd.get('anioVencimiento')||'AAAA');};
 form.addEventListener('input',preview);
 const cargar=async()=>{
  const datos=await apiPagoLocal('/metodos-pago');
  list.replaceChildren();
  if(!datos.length){list.textContent='Todavía no has guardado tarjetas.';return;}
  for(const item of datos){
   const row=document.createElement('div');row.className='local-item pay-saved';
   const marca=document.createElement('span');marca.className='pay-card-mark';marca.textContent='TARJETA';
   const span=document.createElement('div');span.className='pay-card-info';const titulo=document.createElement('strong');titulo.textContent=(item.tipo==='DEBITO'?'Débito':'Crédito')+' · '+item.numeroEnmascarado;const vence=document.createElement('small');vence.textContent='Vence '+item.mesVencimiento+'/'+item.anioVencimiento;span.append(titulo,vence);
   const btn=document.createElement('button');btn.type='button';btn.className='pay-remove';btn.textContent='Quitar';
   btn.addEventListener('click',async()=>{
    if(!confirm('¿Quitar este método de pago?'))return;
    try{await apiPagoLocal('/metodos-pago/'+item.id,{method:'DELETE'});await cargar();}catch(e){estado.textContent=String(e);}
   });row.append(marca,span,btn);list.append(row);
  }
 };
 form.addEventListener('submit',async e=>{
  e.preventDefault();if(submit.disabled)return;submit.disabled=true;estado.textContent='Validando tarjeta…';
  const fd=new FormData(form);
  try{
   await apiPagoLocal('/metodos-pago',{method:'POST',body:JSON.stringify({
    nombreTitular:String(fd.get('nombreTitular')),tipo:String(fd.get('tipo')),
    numeroDemo:String(fd.get('numeroDemo')).trim(),
    mesVencimiento:Number(fd.get('mesVencimiento')),
    anioVencimiento:Number(fd.get('anioVencimiento')),
    cvv:String(fd.get('cvv'))})});
   form.reset();preview();estado.textContent='Tarjeta guardada correctamente.';await cargar();
  }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}finally{(form.elements.namedItem('cvv') as HTMLInputElement).value='';submit.disabled=false;}
 });
 if(!(import.meta.env.DEV || import.meta.env.PUBLIC_PAGOS_SIMULADOS === 'true')){
  form.querySelectorAll('input,select,button').forEach(el=>(el as HTMLInputElement).disabled=true);
  estado.textContent='Los métodos de pago simulados solo están disponibles en localhost. No se admiten tarjetas desde este servidor.';
  list.textContent='No hay gestión de tarjetas de prueba en este entorno.';
 }else cargar().catch(e=>estado.textContent=String(e));
</script>
