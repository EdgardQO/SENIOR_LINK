---
interface Props { rol: 'FAMILIAR'|'ADULTO_MAYOR' }
const {rol}=Astro.props;
const pasos=[{titulo:'Cuenta registrada',detalle:'El adulto mayor debe tener una cuenta activa en SeniorLink.',trazo:'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 0 0 8 4 4 0 1 0 0-8zM19 8v6m-3-3h6'},{titulo:'Enviar solicitud',detalle:'Ingresa el DNI y selecciona el parentesco correspondiente.',trazo:'M3 5h18v14H3zM7 9a2 2 0 1 0 0 4 2 2 0 1 0 0-4zM12 9h5m-5 4h5M5 17l2-2 2 2'},{titulo:'Esperar aprobación',detalle:'El adulto mayor revisa y responde la solicitud desde su perfil.',trazo:'M5 3h14v18H5zM8 12l3 3 5-6'},{titulo:'Gestionar servicios',detalle:'Una vez aceptada, consulta los permisos de reserva, pago y gestión.',trazo:'M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6zM8 12l3 3 5-6'}];
---
<section class="vinculos-panel" data-vinculos-rol={rol}>
 <div class="vinculos-guia">
  <div class="guia-cabecera"><span class="guia-icono"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/></svg></span><div><div class="guia-eyebrow">GUÍA DE VINCULACIÓN</div><h2>Conecta tu cuenta con tu familiar</h2><p>Cuatro pasos para gestionar el acompañamiento con autorización.</p></div></div>
  <ol class="vinculos-pasos">
   {pasos.map((paso,i)=><li style={'--paso:'+i}><div class="guia-paso-top"><span class="guia-numero">{String(i+1).padStart(2,'0')}</span><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paso.trazo}/></svg></div><h3>{paso.titulo}</h3><p>{paso.detalle}</p></li>)}
  </ol>
  <div class="vinculos-aviso"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6zM8 12l3 3 5-6"/></svg><div><strong>La autorización es indispensable</strong><p>Mientras la solicitud esté pendiente, no se habilitan los permisos de reserva, pago ni gestión.</p></div></div>
 </div>
 <div class="vinculos-grid">
 <section class="local-card"><h2>Solicitar vinculación</h2><p>Envía una solicitud para vincular las cuentas.</p>
 <form id="vinculo-form" class="local-form">
  <label>{rol==='FAMILIAR'?'DNI del adulto mayor':'DNI del familiar'}<input name="otroDni" placeholder="Ingresa el DNI (8 dígitos)" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" required /></label>
  <label>Parentesco<select name="parentescoId" required><option value="">Selecciona tu parentesco</option><option value="1">Hijo/a</option><option value="2">Nieto/a</option><option value="3">Hermano/a</option><option value="4">Sobrino/a</option><option value="5">Cónyuge</option><option value="13">Otro</option></select></label>
  <button type="submit">Solicitar vinculación</button>
 </form><p id="vinculos-status" aria-live="polite" role="status"></p>
 </section>
 <section class="local-card"><h2>Mis vinculaciones</h2><p>Consulta el estado y los permisos de tus vínculos familiares.</p><div id="vinculos-list" class="local-list"></div></section>
 </div>
</section>
<style>
.vinculos-panel{display:grid;gap:16px}.vinculos-guia{background:#e9f7f1;border:1px solid #d5ebe1;border-radius:16px;padding:20px}.vinculos-guia h2{margin:0;font-size:20px}.vinculos-guia p{margin:6px 0;color:#405d55}.vinculos-pasos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}.vinculos-pasos article{background:#fff;border:1px solid #dce8e3;border-radius:12px;padding:14px;display:flex;gap:10px;align-items:flex-start}.vinculos-pasos span{background:#087a70;color:white;border-radius:50%;width:25px;height:25px;display:grid;place-items:center;flex-shrink:0;font-weight:600}.vinculos-pasos p{font-size:13px;margin:0}.vinculos-aviso{padding:12px;border:1px solid #a4d3c0;border-radius:9px;color:#174e42;font-size:13px}.vinculos-grid{display:grid;grid-template-columns:minmax(260px,2fr) minmax(0,3fr);gap:16px;align-items:start}.vinculos-grid .local-card{margin:0}.vinculos-panel :global(.vinculo-ficha){display:grid;gap:12px;background:#fff}.vinculos-panel :global(.vinculo-identidad){display:flex;align-items:center;gap:12px;flex-wrap:wrap}.vinculos-panel :global(.vinculo-avatar){width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:#d9f0e5;color:#087a70;font-weight:700;flex-shrink:0}.vinculos-panel :global(.vinculo-persona){flex:1;min-width:120px}.vinculos-panel :global(.vinculo-persona small){display:block;margin-top:4px;color:#52665f}.vinculos-panel :global(.vinculo-estado){font-size:11px;border-radius:20px;padding:6px 10px;background:#e6f5ec;color:#12634a}.vinculos-panel :global(.vinculo-estado[data-estado="PENDIENTE"]){background:#fff4d7;color:#85600c}.vinculos-panel :global(.vinculo-estado[data-estado="RECHAZADO"]){background:#fce8e8;color:#9c3030}.vinculos-panel :global(.vinculo-permisos){display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-size:12px}.vinculos-panel :global(.vinculo-permisos span){background:#e4f6ed;padding:5px 9px;border-radius:7px;color:#12634a}.vinculos-panel :global(.vinculo-permisos span[data-activo="false"]){background:#f0f2f1;color:#687771}.vinculos-panel :global(.vinculo-espera){background:#eef8f4;padding:10px;border-radius:8px;font-size:12px;margin:0}@media(max-width:900px){.vinculos-pasos{grid-template-columns:repeat(2,1fr)}.vinculos-grid{grid-template-columns:1fr}}@media(max-width:480px){.vinculos-pasos{grid-template-columns:1fr}}

/* Movimiento breve, sin bucles ni desplazamientos automáticos. */
.vinculos-guia{position:relative;overflow:hidden;background:linear-gradient(125deg,#effaf5,#e2f3ec);padding:clamp(16px,2.2vw,26px)}
.guia-cabecera{display:flex;align-items:center;gap:14px}.guia-icono{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#d7f1e5;color:#087a70;flex-shrink:0}.guia-eyebrow{font-size:10px;font-weight:750;letter-spacing:.13em;color:#087a70;margin-bottom:5px}.guia-cabecera h2{line-height:1.3;font-size:clamp(18px,2vw,23px)}.guia-cabecera p{font-size:13px}
.vinculos-pasos{list-style:none;padding:0;margin:22px 0;gap:18px}.vinculos-pasos li{position:relative;padding:16px 14px;border:1px solid #d3e6dd;background:white;border-radius:12px;min-width:0;box-shadow:0 3px 10px #173d3508;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;animation:guia-entrada .46s ease-out both;animation-delay:calc(var(--paso)*85ms)}
.guia-paso-top{display:flex;align-items:center;justify-content:space-between;color:#087a70;margin-bottom:14px}.vinculos-pasos .guia-numero{width:auto;height:auto;border-radius:6px;background:#e0f3e9;color:#087a70;padding:5px 8px;font-size:12px;letter-spacing:.06em}.vinculos-pasos h3{font-size:14px;color:#173d35;line-height:1.4;margin:0 0 6px}.vinculos-pasos li p{font-size:12px;line-height:1.6;margin:0;color:#52665f}.vinculos-pasos li:not(:last-child)::after{content:'';position:absolute;width:7px;height:7px;border-top:2px solid #6aa999;border-right:2px solid #6aa999;right:-14px;top:50%;transform:translateY(-50%) rotate(45deg)}
.vinculos-aviso{display:flex;align-items:center;gap:12px;background:#f5fcf8}.vinculos-aviso svg{flex-shrink:0;color:#087a70}.vinculos-aviso p{font-size:12px;margin:4px 0 0}.vinculos-panel :global(.vinculo-ficha){transition:box-shadow .2s ease,border-color .2s ease}.vinculos-panel :global(.vinculo-ficha:hover){border-color:#acd2c2;box-shadow:0 4px 14px #173d350b}
@keyframes guia-entrada{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
@media(hover:hover){.vinculos-pasos li:hover{transform:translateY(-3px);box-shadow:0 6px 18px #173d3510;border-color:#acd2c2}}
@media(max-width:900px){.vinculos-pasos li::after{display:none}}
@media(prefers-reduced-motion:reduce){.vinculos-pasos li{animation:none;transition:none}.vinculos-pasos li:hover{transform:none}.vinculos-panel :global(.vinculo-ficha){transition:none}}
</style>
<script>
 import {apiLocal} from '../../lib/local-api';
 const root=document.querySelector<HTMLElement>('[data-vinculos-rol]')!;
 const role=root.dataset.vinculosRol;
 const estado=root.querySelector<HTMLElement>('#vinculos-status')!;
 const list=root.querySelector<HTMLElement>('#vinculos-list')!;
 const form=root.querySelector<HTMLFormElement>('#vinculo-form')!;
 const cargar=async()=>{
  const datos=await apiLocal('/vinculos');list.replaceChildren();
  if(!datos.length){list.textContent='Aún no hay solicitudes.';return;}
  for(const v of datos){
   const row=document.createElement('article');row.className='local-item vinculo-ficha';
   const nombre=String(role==='FAMILIAR'?v.adultoMayorNombre:v.familiarNombre);
   const dni=String(role==='FAMILIAR'?v.adultoMayorDni:v.familiarDni);
   const identidad=document.createElement('div');identidad.className='vinculo-identidad';
   const avatar=document.createElement('span');avatar.className='vinculo-avatar';avatar.textContent=nombre.split(/\s+/).slice(0,2).map(n=>n[0]||'').join('').toUpperCase();
   const persona=document.createElement('div');persona.className='vinculo-persona';const titulo=document.createElement('strong');titulo.textContent=nombre;const doc=document.createElement('small');doc.textContent='DNI: '+dni;persona.append(titulo,doc);
   if(v.parentescoNombre){const p=document.createElement('small');p.textContent='Parentesco: '+v.parentescoNombre;persona.append(p);}
   const badge=document.createElement('span');badge.className='vinculo-estado';badge.dataset.estado=v.estado;badge.textContent=({ACEPTADO:'Vinculación aceptada',PENDIENTE:'Solicitud pendiente',RECHAZADO:'Solicitud rechazada'} as Record<string,string>)[v.estado]||v.estado;
   identidad.append(avatar,persona,badge);row.append(identidad);
   if(v.estado==='ACEPTADO'){
    const permisos=document.createElement('div');permisos.className='vinculo-permisos';permisos.append('Permisos otorgados: ');
    for(const [nombre,activo] of [['Reserva',v.permiteReservar],['Pago',v.permitePagar],['Gestión',v.permiteGestionar]]){const p=document.createElement('span');p.textContent=nombre+(activo?'':' (no autorizado)');p.dataset.activo=String(Boolean(activo));permisos.append(p);}row.append(permisos);
   }else if(v.estado==='PENDIENTE'){const aviso=document.createElement('p');aviso.className='vinculo-espera';aviso.textContent='En espera de la aprobación del adulto mayor.';row.append(aviso);}
   if(role==='ADULTO_MAYOR'&&v.estado==='PENDIENTE'){
    for(const [nombre,aprobar] of [['Autorizar',true],['Rechazar',false]] as const){
     const b=document.createElement('button');b.textContent=nombre;b.type='button';
     b.addEventListener('click',async()=>{
      try{await apiLocal('/vinculos/'+v.id+'/responder',{method:'POST',body:JSON.stringify({aprobar})});
       estado.textContent='Solicitud respondida.';await cargar();
      }catch(e){estado.textContent=e instanceof Error?e.message:String(e);}
     });row.append(b);
    }
   }
   list.append(row);
  }
 };
 form.addEventListener('submit',async e=>{
  e.preventDefault();const btn=form.querySelector<HTMLButtonElement>('button[type=submit]')!;if(btn.disabled)return;btn.disabled=true;const f=new FormData(form);
  try{await apiLocal('/vinculos',{method:'POST',body:JSON.stringify({
   otroDni:String(f.get('otroDni')),parentescoId:Number(f.get('parentescoId'))
  })});form.reset();estado.textContent='Solicitud registrada.';await cargar();
  }catch(err){estado.textContent=err instanceof Error?err.message:String(err);}finally{btn.disabled=false;}
 });
 cargar().catch(e=>estado.textContent=String(e));
</script>
