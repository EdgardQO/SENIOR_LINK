---
interface Props { rol: 'ADULTO_MAYOR'|'FAMILIAR' }
const {rol}=Astro.props;
---
<section class="local-card catalogo" data-catalogo={rol}>
 <header><h2>Acompañantes</h2><p>Encuentra un acompañante verificado y compara su experiencia, tarifa y opiniones.</p></header>
 <form class="catalogo-filtros local-form" id="catalogo-filtros">
  <label class="catalogo-busqueda">Buscar acompañantes<input name="texto" type="search" placeholder="Nombre, carrera, institución o biografía" autocomplete="off"/></label>
  <label>Calificación<select name="rating"><option value="">Todas</option><option value="5">5 estrellas</option><option value="4">4 estrellas o más</option><option value="3">3 estrellas o más</option><option value="sin">Sin opiniones</option></select></label>
  <label>Institución<select name="institucion"><option value="">Todas las instituciones</option></select></label>
  <label>Carrera<select name="carrera"><option value="">Todas las carreras</option></select></label>
  <label>Tarifa máxima (S/ por hora)<input name="tarifa" type="number" min="0" step="0.5" placeholder="Sin límite"/></label>
  <label>Ordenar por<select name="orden"><option value="rating">Mejor calificación</option><option value="precio">Menor tarifa</option><option value="precio-desc">Mayor tarifa</option><option value="nombre">Nombre A–Z</option><option value="opiniones">Más opiniones</option></select></label>
  <button type="reset" class="catalogo-reset">Limpiar filtros</button>
 </form>
 <p id="catalogo-estado" role="status" aria-live="polite">Cargando acompañantes…</p>
 <div id="catalogo-grid" class="catalogo-grid"></div>
</section>
<style is:global>
.catalogo{max-width:1400px}
.catalogo header p{margin:0}
.catalogo-filtros{grid-template-columns:repeat(3,minmax(0,1fr));align-items:end;padding:16px;background:#f5faf8;border:1px solid #dce8e3;border-radius:12px}
.catalogo-busqueda{grid-column:1/-1}
.catalogo-filtros .catalogo-reset{background:#e4f2ed;color:#087a70;min-height:42px}
.catalogo-filtros .catalogo-reset:hover{background:#d4e9e0;color:#075c51}
.catalogo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,255px),1fr));gap:16px;align-items:stretch}
.catalogo-card{min-width:0;display:flex;flex-direction:column;gap:12px;padding:18px;border:1px solid #dce8e3;border-radius:14px;background:white}
.catalogo-identidad{display:flex;align-items:center;gap:12px}
.catalogo-identidad>div{min-width:0}
.catalogo-identidad h3{margin:0 0 4px;overflow-wrap:anywhere}
.catalogo-avatar{position:relative;display:grid;place-items:center;flex:0 0 70px;width:70px;height:70px;border-radius:50%;overflow:hidden;background:#e1f1ea;color:#087a70;font-weight:700;font-size:22px}
.catalogo-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.catalogo-avatar img[hidden]{display:none}
.catalogo-meta{font-size:12px;color:#527067;overflow-wrap:anywhere}
.catalogo-rating{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px}
.catalogo-stars{position:relative;display:inline-block;white-space:nowrap;letter-spacing:1px;color:#b9c7c1;font-size:19px;line-height:1.2}
.catalogo-stars>span{position:absolute;inset:0 auto 0 0;overflow:hidden;white-space:nowrap;color:#b77913}
.catalogo-card p{margin:0;font-size:13px;overflow-wrap:anywhere}
.catalogo-bio{flex:1}
.catalogo-precio{font-size:20px;color:#173d35;font-weight:700}
.catalogo-precio small{font-size:12px;font-weight:400}
.catalogo-detalle{border-top:1px solid #e3ece8;padding-top:10px}
.catalogo-detalle summary{cursor:pointer;font-weight:600;color:#087a70;font-size:13px}
.catalogo-opinion{border-top:1px solid #e3ece8;padding:10px 0;margin-top:8px}
.catalogo-opinion p{white-space:pre-wrap}
.catalogo-reservar{display:block;text-align:center;padding:11px;border-radius:9px;background:#087a70;color:#fff;text-decoration:none;font-weight:600;font-size:14px}
.catalogo-reservar:hover{background:#065e56;color:white}
.catalogo-reservar:focus-visible,.catalogo-detalle summary:focus-visible{outline:2px solid #087a70;outline-offset:3px}
@media(max-width:850px){.catalogo-filtros{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.catalogo-filtros{grid-template-columns:1fr}.catalogo-grid{grid-template-columns:1fr}}
</style>
<script>
 import {apiLocal,importe} from '../../lib/local-api';
 import {mostrarFotoProtegida,limpiarFoto} from '../../lib/profile-photo';
 type Opinion={puntuacion:number,comentario?:string,creadoEn:string};
 type Persona={dni:string,nombre:string,carrera?:string,ciclo?:number,institucion?:string,biografia?:string,tarifaHora:number,promedioCalificacion:number|null,totalCalificaciones:number,fotoUrl?:string,resenas?:Opinion[]};
 const root=document.querySelector<HTMLElement>('[data-catalogo]')!;
 const filtros=root.querySelector<HTMLFormElement>('#catalogo-filtros')!;
 const grid=root.querySelector<HTMLElement>('#catalogo-grid')!;
 const estado=root.querySelector<HTMLElement>('#catalogo-estado')!;
 const base=root.dataset.catalogo==='FAMILIAR'?'/familiar':'/adulto-mayor';
 let catalogo:Persona[]=[];
 const normalizar=(s:unknown)=>String(s??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
 const crear=(tag:string,txt='',clase='')=>{const e=document.createElement(tag);e.textContent=txt;if(clase)e.className=clase;return e;};
 const stars=(n:number)=>{const v=Math.min(5,Math.max(0,Number(n)||0));const e=crear('span','★★★★★','catalogo-stars');e.setAttribute('role','img');e.setAttribute('aria-label',v.toFixed(1)+' de 5 estrellas');const relleno=crear('span','★★★★★');relleno.style.width=(v*20)+'%';relleno.setAttribute('aria-hidden','true');e.append(relleno);return e;};
 const tarjetas=new Map<string,HTMLElement>();
 function card(p:Persona){
  const existente=tarjetas.get(p.dni);if(existente)return existente;
  const e=crear('article','','catalogo-card');
  const identidad=crear('div','','catalogo-identidad');
  const avatar=crear('div',p.nombre.trim().split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase(),'catalogo-avatar');
  const img=document.createElement('img');img.alt='Foto de '+p.nombre;img.hidden=true;avatar.append(img);
  if(p.fotoUrl)void mostrarFotoProtegida(p.dni,img);
  const datos=crear('div');datos.append(crear('h3',p.nombre),crear('div',[p.carrera,p.ciclo?'Ciclo '+p.ciclo:''].filter(Boolean).join(' · ')||'Carrera no registrada','catalogo-meta'));
  identidad.append(avatar,datos);e.append(identidad,crear('p',p.institucion||'Institución no registrada'));
  const rating=crear('div','','catalogo-rating');const n=Number(p.totalCalificaciones)||0;
  rating.append(stars(n?Number(p.promedioCalificacion):0),crear('strong',n?Number(p.promedioCalificacion).toFixed(1)+' / 5':'Sin calificaciones'),crear('span',n+' '+(n===1?'opinión':'opiniones')));e.append(rating);
  e.append(crear('p',p.biografia||'Sin biografía registrada.','catalogo-bio'));
  const precio=crear('div',importe(p.tarifaHora),'catalogo-precio');precio.append(crear('small',' / hora'));e.append(precio);
  const res=document.createElement('details');res.className='catalogo-detalle';res.append(crear('summary','Ver reseñas ('+n+')'));
  const lista=crear('div');res.append(lista);let cargado=false;let cargando=false;
  res.addEventListener('toggle',async()=>{if(!res.open||cargado||cargando)return;cargando=true;lista.replaceChildren(crear('p','Cargando reseñas…'));try{
   const opiniones:Opinion[]=Array.isArray(p.resenas)?p.resenas:await apiLocal('/acompanantes/'+encodeURIComponent(p.dni)+'/resenas');
   lista.replaceChildren();if(!opiniones.length)lista.append(crear('p','Aún no tiene reseñas.'));
   for(const o of opiniones){const item=crear('article','','catalogo-opinion');const r=crear('div','','catalogo-rating');r.append(stars(o.puntuacion),crear('strong',Number(o.puntuacion).toFixed(1)+' / 5'));item.append(r,crear('p',o.comentario||'Valoración sin comentario.'),crear('div',new Date(o.creadoEn).toLocaleDateString('es-PE',{timeZone:'America/Lima'}),'catalogo-meta'));lista.append(item);}cargado=true;
  }catch{lista.replaceChildren(crear('p','No se pudieron cargar las reseñas. Vuelve a abrir para reintentar.'));}finally{cargando=false;}});
  e.append(res);
  const horarios=document.createElement('details');horarios.className='catalogo-detalle';horarios.append(crear('summary','Consultar disponibilidad'));const hs=crear('div');horarios.append(hs);let listo=false;let consultando=false;
  horarios.addEventListener('toggle',async()=>{if(!horarios.open||listo||consultando)return;consultando=true;hs.replaceChildren(crear('p','Consultando horarios…'));try{const lista=await apiLocal('/acompanantes/'+encodeURIComponent(p.dni)+'/disponibilidad');const dias=['','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];hs.replaceChildren();if(!lista.length)hs.append(crear('p','Sin horarios registrados.'));for(const h of lista)hs.append(crear('p',dias[h.diaSemana]+': '+h.horaInicio.slice(0,5)+'–'+h.horaFin.slice(0,5)));listo=true;}catch{hs.replaceChildren(crear('p','No se pudieron consultar los horarios.'));}finally{consultando=false;}});
  e.append(horarios);
  const enlace=document.createElement('a');enlace.className='catalogo-reservar';enlace.href=base+'/reservas?acompanante='+encodeURIComponent(p.dni);enlace.textContent='Solicitar acompañamiento';e.append(enlace);tarjetas.set(p.dni,e);return e;
 }
 function render(){
  const f=new FormData(filtros);const q=normalizar(f.get('texto')).split(/\s+/).filter(Boolean);const cal=String(f.get('rating')||'');const inst=String(f.get('institucion')||'');const carrera=String(f.get('carrera')||'');const tarifa=String(f.get('tarifa')||'');const orden=f.get('orden');
  const encontrados=catalogo.filter(p=>{const texto=normalizar([p.nombre,p.carrera,p.institucion,p.biografia].join(' '));return q.every(t=>texto.includes(t))&&(!inst||p.institucion===inst)&&(!carrera||p.carrera===carrera)&&(!tarifa||Number(p.tarifaHora)<=Number(tarifa))&&(!cal||(cal==='sin'?Number(p.totalCalificaciones)===0:Number(p.totalCalificaciones)>0&&Number(p.promedioCalificacion)>=Number(cal)));});
  encontrados.sort((a,b)=>{const nombre=a.nombre.localeCompare(b.nombre,'es');if(orden==='precio')return Number(a.tarifaHora)-Number(b.tarifaHora)||nombre;if(orden==='precio-desc')return Number(b.tarifaHora)-Number(a.tarifaHora)||nombre;if(orden==='nombre')return nombre;if(orden==='opiniones')return b.totalCalificaciones-a.totalCalificaciones||nombre;return (Number(b.promedioCalificacion)||0)-(Number(a.promedioCalificacion)||0)||b.totalCalificaciones-a.totalCalificaciones||nombre;});
  grid.replaceChildren(...encontrados.map(card));estado.textContent=encontrados.length+' de '+catalogo.length+' acompañantes';
  if(!encontrados.length)grid.append(crear('p','No se encontraron acompañantes con estos filtros.'));
 }
 async function iniciar(){try{catalogo=await apiLocal('/acompanantes');for(const key of ['institucion','carrera'] as const){const sel=filtros.elements.namedItem(key) as HTMLSelectElement;const vals=[...new Set(catalogo.map(p=>p[key]).filter((x):x is string=>Boolean(x)))].sort((a,b)=>a.localeCompare(b,'es'));for(const v of vals)sel.append(new Option(v,v));}render();}catch(e){estado.textContent='No se pudo cargar el catálogo: '+(e instanceof Error?e.message:String(e));}}
 filtros.addEventListener('submit',e=>e.preventDefault());filtros.addEventListener('input',render);filtros.addEventListener('change',render);filtros.addEventListener('reset',()=>queueMicrotask(render));
 window.addEventListener('pagehide',()=>tarjetas.forEach(c=>c.querySelectorAll('img').forEach(limpiarFoto)));
 void iniciar();
</script>
