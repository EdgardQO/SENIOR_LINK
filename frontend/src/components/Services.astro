---
/**
 * Imágenes temporales. Para reemplazarlas, guarda tus fotos en
 * frontend/public/Servicios/ y cambia cada valor "image" por
 * "/Servicios/nombre-de-tu-imagen.jpg".
 */
const services = [
  { title: 'Caminatas y recreación', description: 'Paseos y momentos al aire libre, siempre en buena compañía.', image: 'https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=720&q=85' },
  { title: 'Compras y trámites', description: 'Una mano amiga para resolver las tareas del día a día.', image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=720&q=85' },
  { title: 'Acompañamiento a citas', description: 'Apoyo y compañía para acudir a citas y diligencias.', image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=720&q=85' },
  { title: 'Apoyo digital', description: 'Ayuda sencilla para usar el celular y otras tecnologías.', image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=720&q=85' },
  { title: 'Compañía y actividades', description: 'Compartir conversaciones, aficiones y buenos momentos.', image: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=720&q=85' },
  { title: 'Lectura y estimulación', description: 'Lecturas y actividades para mantener la mente activa.', image: 'https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=720&q=85' },
  { title: 'Alimentación consciente', description: 'Compañía en las rutinas de alimentación cotidianas.', image: 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=720&q=85' },
  { title: 'Otros servicios', description: 'Acompañamiento personalizado según cada necesidad.', image: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=720&q=85' },
];
---

<section id="servicios" class="services-section" aria-labelledby="services-title">
  <div class="services-container">
    <div class="services-heading">
      <span class="services-eyebrow">SERVICIOS SENIORLINK</span>
      <h2 id="services-title">Acompañamiento para cada momento</h2>
      <p>Estamos presentes en las pequeñas cosas que hacen la diferencia.</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-photo">
            <img src={service.image} alt={`Imagen ilustrativa de ${service.title.toLowerCase()}`} loading="lazy" decoding="async" />
          </div>
          <div class="service-content">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section{position:relative;isolation:isolate;overflow:hidden;padding:80px 0 92px;background:#f7faf9;scroll-margin-top:85px}
  .services-section::before{content:"";position:absolute;z-index:-1;left:0;right:0;top:40%;height:36%;background:#d9efe7}
  .services-container{max-width:1190px;margin:0 auto;padding:0 26px}
  .services-heading{text-align:center;margin:0 auto 38px;max-width:750px}
  .services-eyebrow{display:block;color:#158679;font-size:11px;font-weight:750;letter-spacing:.14em;margin-bottom:13px}
  .services-heading h2{color:#183f3d;font-size:clamp(30px,3.4vw,43px);line-height:1.16;font-weight:800;letter-spacing:-.035em;margin:0 0 12px}
  .services-heading p{color:#5e7773;font-size:15px;line-height:1.6;margin:0}
  .services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .service-card{min-width:0;background:#fff;border-radius:17px;padding:16px 16px 22px;box-shadow:0 7px 24px rgba(21,65,59,.075);border:1px solid rgba(27,88,75,.07);transition:transform .22s ease,box-shadow .22s ease}
  .service-card:hover{transform:translateY(-4px);box-shadow:0 13px 32px rgba(21,65,59,.13)}
  .service-photo{width:100%;aspect-ratio:1.34;overflow:hidden;border-radius:11px;background:#e7f0ed}
  .service-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .service-card:hover .service-photo img{transform:scale(1.035)}
  .service-content{text-align:center;padding:19px 3px 0}
  .service-content h3{color:#204540;font-size:16px;font-weight:750;line-height:1.35;letter-spacing:-.015em;margin:0 0 10px}
  .service-content p{font-size:12.5px;color:#6b807c;line-height:1.6;margin:0 auto;max-width:215px}
  @media(max-width:950px){.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.services-container{max-width:700px}}
  @media(max-width:600px){.services-section{padding:56px 0 66px}.services-container{padding:0 15px}.services-heading{margin-bottom:27px}.services-heading h2{font-size:29px}.services-heading p{font-size:13px}.services-grid{gap:12px}.service-card{padding:10px 10px 17px;border-radius:13px}.service-photo{border-radius:8px;aspect-ratio:1.05}.service-content{padding:14px 2px 0}.service-content h3{font-size:13px;margin-bottom:8px}.service-content p{font-size:11px;line-height:1.45}}
  @media(max-width:360px){.services-grid{grid-template-columns:1fr}.service-photo{aspect-ratio:1.5}}
  @media(prefers-reduced-motion:reduce){.service-card,.service-photo img{transition:none}.service-card:hover,.service-card:hover .service-photo img{transform:none}}
</style>