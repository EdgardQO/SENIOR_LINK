---
const services = [
  { icon: 'footprints', title: 'Caminatas y recreación', description: 'Paseos acompañados y actividades recreativas.' },
  { icon: 'shopping-cart', title: 'Compras y trámites', description: 'Apoyo en compras y gestiones cotidianas.' },
  { icon: 'calendar-check', title: 'Acompañamiento a citas', description: 'Compañía durante citas y diligencias.' },
  { icon: 'monitor-smartphone', title: 'Apoyo digital', description: 'Orientación para usar dispositivos y aplicaciones.' },
  { icon: 'users-round', title: 'Compañía y actividades', description: 'Conversación y actividades compartidas.' },
  { icon: 'book-open', title: 'Lectura y estimulación', description: 'Lectura acompañada y actividades de estimulación.' },
  { icon: 'utensils', title: 'Alimentación consciente', description: 'Acompañamiento durante rutinas de alimentación.' },
  { icon: 'ellipsis', title: 'Servicios personalizados', description: 'Apoyo adaptado a las necesidades de cada persona.' },
];
---

<section id="servicios" class="services-section" aria-labelledby="services-title">
  <div class="services-container">
    <div class="services-heading">
      <span class="services-kicker">LO QUE HACEMOS</span>
      <h2 id="services-title">Acompañamiento para cada momento</h2>
      <p>Pequeñas ayudas que hacen más fácil el día a día.</p>
    </div>

    <div class="services-grid">
      {services.map((service, index) => (
        <article class="service-card">
          <div class="service-icon" aria-hidden="true">
            {service.icon === 'footprints' && <svg viewBox="0 0 24 24"><path d="M10 5.5 12 3l2.5 2M12 3l-.5 6-3.5 3m3.5-3 4 3 3 1m-7.5-4-2 5-4 4m6-4 3 3 1 4"/></svg>}
            {service.icon === 'shopping-cart' && <svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M2 3h2l3 13h13l2-9H5"/></svg>}
            {service.icon === 'calendar-check' && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-13 5 3 3 5-5"/></svg>}
            {service.icon === 'monitor-smartphone' && <svg viewBox="0 0 24 24"><rect x="2" y="4" width="15" height="12" rx="2"/><path d="M9.5 16v4m-4 0h8"/><rect x="18" y="9" width="4" height="11" rx="1"/></svg>}
            {service.icon === 'users-round' && <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m1 4a5 5 0 0 1 3 5"/></svg>}
            {service.icon === 'book-open' && <svg viewBox="0 0 24 24"><path d="M12 6c-3-2-6-2-10-1v14c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Zm0 0v14"/></svg>}
            {service.icon === 'utensils' && <svg viewBox="0 0 24 24"><path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18M19 21V3c-4 2-5 7-5 11h5"/></svg>}
            {service.icon === 'ellipsis' && <svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>}
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section{padding:88px 0 96px;background:#fff;scroll-margin-top:85px}
  .services-container{max-width:1190px;margin:0 auto;padding:0 30px}
  .services-heading{max-width:650px;margin:0 0 43px;text-align:left}
  .services-kicker{display:block;color:#188579;font-size:11px;font-weight:750;letter-spacing:.14em;margin-bottom:14px}
  .services-heading h2{color:#173e3a;font-size:clamp(29px,3.4vw,43px);line-height:1.14;font-weight:800;letter-spacing:-.04em;margin:0 0 15px}
  .services-heading>p{color:#617a75;font-size:15px;line-height:1.65;margin:0}
  .services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-top:1px solid #e5eeeb;border-left:1px solid #e5eeeb}
  .service-card{min-width:0;min-height:207px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;padding:28px 24px 26px;border-right:1px solid #e5eeeb;border-bottom:1px solid #e5eeeb;background:#fff;transition:background .2s ease}
  .service-card:hover{background:#f6fbf9}
  .service-icon{display:grid;place-items:center;width:47px;height:47px;border-radius:12px;color:#137d76;background:#e9f6f1;margin-bottom:22px}
  .service-card:nth-child(4n+2) .service-icon{background:#eaf4f9;color:#267a9d}
  .service-card:nth-child(4n+3) .service-icon{background:#edf4ee;color:#477f68}
  .service-card:nth-child(4n+4) .service-icon{background:#f2f2ed;color:#797e59}
  .service-icon svg{width:27px;height:27px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .service-card h3{font-size:16px;font-weight:750;line-height:1.32;letter-spacing:-.015em;color:#1a4140;margin:0 0 9px}
  .service-card p{font-size:13px;line-height:1.55;color:#6a807c;margin:0}
  @media(max-width:950px){.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.service-card{min-height:185px}}
  @media(max-width:600px){.services-section{padding:60px 0 70px}.services-container{padding:0 18px}.services-heading{margin-bottom:30px}.services-heading h2{font-size:31px}.services-heading>p{font-size:14px}.service-card{min-height:190px;padding:22px 16px}.service-icon{width:43px;height:43px;margin-bottom:17px}.service-icon svg{width:25px;height:25px}.service-card h3{font-size:14px}.service-card p{font-size:12px}}
  @media(max-width:360px){.services-grid{grid-template-columns:1fr}.service-card{min-height:155px}}
  @media(prefers-reduced-motion:reduce){.service-card{transition:none}}
</style>