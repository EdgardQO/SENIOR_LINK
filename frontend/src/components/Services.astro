---
const services = [
  { icon: 'footprints', title: 'Caminatas y recreación', description: 'Paseos acompañados y actividades recreativas.' },
  { icon: 'shopping-cart', title: 'Compras y trámites', description: 'Apoyo en compras y gestiones cotidianas.' },
  { icon: 'calendar-check', title: 'Acompañamiento a citas', description: 'Compañía durante citas y diligencias.' },
  { icon: 'monitor-smartphone', title: 'Apoyo digital', description: 'Orientación para usar dispositivos y aplicaciones.' },
  { icon: 'users-round', title: 'Compañía y actividades', description: 'Conversación y actividades compartidas.' },
  { icon: 'book-open', title: 'Lectura y estimulación', description: 'Lectura acompañada y actividades de estimulación.' },
  { icon: 'utensils', title: 'Alimentación consciente', description: 'Acompañamiento durante rutinas de alimentación.' },
  { icon: 'ellipsis', title: 'Servicios personalizados', description: 'Apoyo adaptado a las necesidades de cada persona.' },
];
---

<section id="servicios" class="services-section" aria-labelledby="services-title">
  <div class="services-container">
    <div class="services-heading">
      <span class="services-kicker">CUIDADO Y BIENESTAR</span>
      <h2 id="services-title">Nuestros servicios de acompañamiento</h2>
      <p>Apoyo cercano en actividades cotidianas para promover el bienestar y la calidad de vida.</p>
    </div>

    <div class="services-grid">
      {services.map((service, index) => (
        <article class="service-card">
          <div class="service-card-top"><span class="service-number">{String(index + 1).padStart(2, "0")}</span><div class="service-icon" aria-hidden="true">
            {service.icon === 'footprints' && <svg viewBox="0 0 24 24"><path d="M10 5.5 12 3l2.5 2M12 3l-.5 6-3.5 3m3.5-3 4 3 3 1m-7.5-4-2 5-4 4m6-4 3 3 1 4"/></svg>}
            {service.icon === 'shopping-cart' && <svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M2 3h2l3 13h13l2-9H5"/></svg>}
            {service.icon === 'calendar-check' && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-13 5 3 3 5-5"/></svg>}
            {service.icon === 'monitor-smartphone' && <svg viewBox="0 0 24 24"><rect x="2" y="4" width="15" height="12" rx="2"/><path d="M9.5 16v4m-4 0h8"/><rect x="18" y="9" width="4" height="11" rx="1"/></svg>}
            {service.icon === 'users-round' && <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m1 4a5 5 0 0 1 3 5"/></svg>}
            {service.icon === 'book-open' && <svg viewBox="0 0 24 24"><path d="M12 6c-3-2-6-2-10-1v14c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Zm0 0v14"/></svg>}
            {service.icon === 'utensils' && <svg viewBox="0 0 24 24"><path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18M19 21V3c-4 2-5 7-5 11h5"/></svg>}
            {service.icon === 'ellipsis' && <svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>}
          </div>
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section{position:relative;isolation:isolate;overflow:hidden;padding:92px 0 100px;background:radial-gradient(ellipse 58% 48% at 100% 0%,#dff6ee 0%,transparent 80%),radial-gradient(ellipse 48% 55% at 0% 100%,#e7f3ff 0%,transparent 78%),#f8fbfc;scroll-margin-top:85px}
  .services-section::before{content:"";position:absolute;inset:0;z-index:-1;opacity:.25;background-image:radial-gradient(#9fc8c1 .65px,transparent .65px);background-size:22px 22px;mask-image:linear-gradient(to bottom,transparent,#000 30%,transparent 95%)}
  .services-container{max-width:1260px;margin:0 auto;padding:0 28px}
  .services-heading{text-align:center;margin:0 auto 42px;max-width:760px}
  .services-kicker{display:inline-flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;border:1px solid #cce9e2;background:#eaf8f3;color:#138579;font-size:10px;font-weight:850;letter-spacing:.17em}
  .services-heading h2{margin:17px 0 12px;font-size:clamp(28px,3.2vw,43px);line-height:1.16;font-weight:850;letter-spacing:-.04em;color:#123d43}
  .services-heading>p{font-size:15px;line-height:1.65;color:#627b83;margin:0}
  .services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .service-card{--accent:#168a87;--tint:#e5f7f1;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:flex-start;min-width:0;min-height:228px;padding:24px;border:1px solid #e1ecec;border-radius:22px;background:#fff;box-shadow:0 6px 22px rgba(20,75,82,.045);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
  .service-card:nth-child(4n+2){--accent:#2887b7;--tint:#e5f4fd}
  .service-card:nth-child(4n+3){--accent:#7c79bf;--tint:#f0efff}
  .service-card:nth-child(4n+4){--accent:#dc8b42;--tint:#fff2e5}
  .service-card::after{content:"";position:absolute;width:140px;height:140px;border-radius:50%;background:var(--tint);right:-78px;top:-76px;opacity:.7;transition:transform .25s ease}
  .service-card::before{content:"";position:absolute;bottom:0;left:24px;right:24px;height:3px;border-radius:5px 5px 0 0;background:var(--accent);opacity:.65;transform:scaleX(.22);transform-origin:left;transition:transform .25s ease}
  .service-card:hover{transform:translateY(-6px);border-color:#b6dad4;box-shadow:0 18px 40px rgba(20,75,82,.12)}
  .service-card:hover::after{transform:scale(1.3)}
  .service-card:hover::before{transform:scaleX(1)}
  .service-card-top{display:flex;align-items:flex-start;justify-content:space-between;width:100%;margin-bottom:21px}
  .service-number{font-size:11px;font-weight:800;letter-spacing:.09em;color:#a4b9ba;padding-top:5px}
  .service-icon{width:62px;height:62px;display:grid;place-items:center;color:var(--accent);background:var(--tint);border:1px solid color-mix(in srgb,var(--accent) 12%,transparent);border-radius:18px;position:relative;z-index:1}
  .service-icon svg{width:32px;height:32px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .service-card h3{font-size:17px;font-weight:800;line-height:1.3;color:#1c434a;margin:0 0 9px;max-width:240px}
  .service-card p{font-size:13px;line-height:1.55;color:#6c838a;margin:0;max-width:250px}
  @media(max-width:1050px){.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.service-card{min-height:210px}}
  @media(max-width:600px){.services-section{padding:60px 0 66px}.services-container{padding:0 16px}.services-heading{margin-bottom:28px}.services-heading h2{font-size:29px}.services-heading>p{font-size:13px}.services-grid{gap:12px}.service-card{padding:18px 15px;min-height:204px;border-radius:17px}.service-card-top{margin-bottom:16px}.service-icon{width:48px;height:48px;border-radius:14px}.service-icon svg{width:27px;height:27px}.service-card h3{font-size:14px}.service-card p{font-size:11px}}
  @media(max-width:390px){.services-grid{grid-template-columns:1fr}.service-card{min-height:165px}}
  @media(prefers-reduced-motion:reduce){.service-card,.service-card::before,.service-card::after{transition:none}.service-card:hover{transform:none}}
</style>