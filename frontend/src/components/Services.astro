---
const services = [
  { title: 'Caminatas y recreación', description: 'Paseos y momentos al aire libre, siempre en buena compañía.', image: '/Servicios/caminata.png', details: "Disfruta de paseos tranquilos, visitas a parques y actividades recreativas con acompañamiento. La actividad se adapta a los intereses, preferencias y ritmo de cada persona." },
  { title: 'Compras y trámites', description: 'Una mano amiga para resolver las tareas del día a día.', image: '/Servicios/compras.png', details: "Brindamos compañía durante compras de productos cotidianos y gestiones sencillas, como acudir a establecimientos o realizar trámites. El objetivo es que la persona se sienta acompañada y segura durante el recorrido." },
  { title: 'Acompañamiento a citas', description: 'Apoyo y compañía para acudir a citas y diligencias.', image: '/Servicios/citas.png', details: "Ofrecemos compañía para acudir a citas, reuniones y diligencias programadas, desde el traslado hasta el regreso, según lo acordado. Este servicio no sustituye la atención ni las indicaciones de profesionales de salud." },
  { title: 'Apoyo digital', description: 'Ayuda sencilla para usar el celular y otras tecnologías.', image: '/Servicios/tecnologia.png', details: "Ayudamos a familiarizarse con el celular, las videollamadas, la mensajería y otras herramientas digitales de uso diario. La orientación es práctica y se realiza paso a paso, respetando la privacidad del usuario." },
  { title: 'Compañía y actividades', description: 'Compartir conversaciones, aficiones y buenos momentos.', image: '/Servicios/compania.png', details: "Compartimos momentos de conversación, juegos de mesa, actividades culturales y pasatiempos elegidos por la persona. Buscamos crear experiencias agradables y fortalecer la conexión social." },
  { title: 'Lectura y estimulación', description: 'Lecturas y actividades para mantener la mente activa.', image: '/Servicios/lectura.png', details: "Acompañamos en sesiones de lectura, juegos de memoria, conversación sobre historias y otras actividades recreativas que invitan a participar y mantener la curiosidad." },
  { title: 'Alimentación consciente', description: 'Compañía en las rutinas de alimentación cotidianas.', image: '/Servicios/alimentacion.png', details: "Brindamos compañía durante las comidas y apoyamos en la organización de rutinas cotidianas relacionadas con la alimentación. No reemplazamos la orientación nutricional ni la atención médica." },
  { title: 'Otros servicios', description: 'Acompañamiento personalizado según cada necesidad.', image: '/Servicios/otros.png', details: "¿Necesitas un tipo de acompañamiento diferente? Podemos conversar sobre las actividades, horarios y preferencias de la persona para evaluar una propuesta personalizada, de acuerdo con los servicios disponibles." },
];
---

<section id="servicios" class="services-section" aria-labelledby="services-title">
  <div class="services-container">
    <div class="services-heading">
      <h2 id="services-title">NUESTROS SERVICIOS</h2>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-photo">
            <img src={service.image} alt={`Imagen ilustrativa de ${service.title.toLowerCase()}`} loading="lazy" decoding="async" />
          </div>
          <div class="service-content">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <button class="service-more" type="button" data-service-title={service.title} data-service-details={service.details} data-service-image={service.image} aria-haspopup="dialog">Más información <span aria-hidden="true">→</span></button>
          </div>
        </article>
      ))}
    </div>
  </div>
  <dialog id="service-details-dialog" class="service-dialog" aria-labelledby="service-dialog-title" aria-describedby="service-dialog-description">
    <div class="service-dialog-inner">
      <button type="button" class="service-dialog-close" aria-label="Cerrar información del servicio" data-service-close>×</button>
      <img id="service-dialog-image" class="service-dialog-image" alt="" />
      <div class="service-dialog-body">
        <span class="service-dialog-label">SERVICIOS SENIORLINK</span>
        <h3 id="service-dialog-title"></h3>
        <p id="service-dialog-description"></p>
        <button type="button" class="service-dialog-done" data-service-close>Entendido</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  // Script procesado por Astro: evita TypeScript sin compilar en el navegador.
  const dialog = document.querySelector<HTMLDialogElement>('#service-details-dialog');
  const dialogTitle = document.querySelector<HTMLElement>('#service-dialog-title');
  const dialogDescription = document.querySelector<HTMLElement>('#service-dialog-description');
  const dialogImage = document.querySelector<HTMLImageElement>('#service-dialog-image');
  document.querySelectorAll<HTMLButtonElement>('.service-more').forEach(button => {
    button.addEventListener('click', () => {
      if (!dialog || !dialogTitle || !dialogDescription || !dialogImage) return;
      dialogTitle.textContent = button.dataset.serviceTitle || '';
      dialogDescription.textContent = button.dataset.serviceDetails || '';
      dialogImage.src = button.dataset.serviceImage || '';
      dialogImage.alt = button.dataset.serviceTitle || '';
      if (!dialog.open) dialog.showModal();
    });
  });
  dialog?.querySelectorAll<HTMLButtonElement>('[data-service-close]').forEach(button => {
    button.addEventListener('click', () => dialog.close());
  });
  dialog?.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .services-section{padding:76px 0 88px;background:#f8faf9;scroll-margin-top:85px}
  .services-container{max-width:1240px;margin:0 auto;padding:0 28px}
  .services-heading{display:flex;align-items:center;justify-content:center;margin:0 0 38px}
  .services-heading h2{position:relative;margin:0;color:#173e3a;font-size:clamp(25px,2.8vw,37px);font-weight:800;line-height:1.25;letter-spacing:.015em;text-align:center}
  .services-heading h2::after{content:"";display:block;margin:14px auto 0;width:54px;height:3px;background:#0d9488;border-radius:10px}
  .services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
  .service-card{min-width:0;overflow:hidden;display:flex;flex-direction:column;background:#fff;border:1px solid #e3eae7;border-radius:15px;box-shadow:0 5px 18px rgba(18,65,59,.045);transition:box-shadow .22s ease,transform .22s ease,border-color .22s ease}
  .service-card:hover{transform:translateY(-4px);border-color:#bfdad1;box-shadow:0 13px 32px rgba(18,65,59,.1)}
  .service-photo{width:100%;aspect-ratio:1.35;overflow:hidden;background:#e7f0ed}
  .service-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
  .service-card:hover .service-photo img{transform:scale(1.035)}
  .service-content{flex:1;text-align:left;padding:21px 22px 25px;background:#eaf5f0;transition:background-color .22s ease}
  .service-card:hover .service-content{background:#deefe7}
  .service-content h3{color:#234943;font-size:16px;font-weight:750;line-height:1.35;letter-spacing:-.012em;margin:0 0 9px}
  .service-content p{font-size:13px;color:#6c827b;line-height:1.55;margin:0}
  .service-content{display:flex;flex-direction:column;align-items:stretch}
  .service-more{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:40px;margin-top:auto;padding:10px 12px;border:1px solid #177e72;border-radius:9px;background:#167f72;color:#fff;font:inherit;font-size:12px;font-weight:750;cursor:pointer;transition:background .2s ease,transform .2s ease}
  .service-content p{margin-bottom:20px}
  .service-more:hover{background:#10695e;transform:translateY(-1px)}
  .service-more:focus-visible,.service-dialog button:focus-visible{outline:3px solid #70c6b6;outline-offset:3px}
  .service-dialog{width:min(520px,calc(100vw - 32px));max-height:min(85vh,750px);padding:0;border:0;border-radius:18px;background:#fff;color:#234943;box-shadow:0 25px 85px rgba(0,33,30,.23);overflow:auto}
  .service-dialog::backdrop{background:rgba(12,38,35,.58);backdrop-filter:blur(3px)}
  .service-dialog-inner{position:relative}
  .service-dialog-close{position:absolute;z-index:1;top:14px;right:14px;width:36px;height:36px;border:0;border-radius:50%;background:rgba(255,255,255,.95);color:#244d46;font-size:25px;line-height:1;cursor:pointer}
  .service-dialog-image{display:block;width:100%;height:215px;object-fit:cover;background:#eaf5f0}
  .service-dialog-body{padding:27px 32px 32px}
  .service-dialog-label{color:#148477;font-size:10px;font-weight:800;letter-spacing:.13em}
  .service-dialog-body h3{font-size:25px;line-height:1.22;letter-spacing:-.025em;margin:10px 0 14px;color:#193f3b}
  .service-dialog-body p{font-size:14px;line-height:1.8;color:#5b756f;margin:0 0 25px}
  .service-dialog-done{border:0;border-radius:10px;padding:11px 22px;background:#167f72;color:#fff;font:inherit;font-size:13px;font-weight:750;cursor:pointer}
  .service-dialog-done:hover{background:#10695e}
  @media(max-width:600px){.service-dialog-image{height:165px}.service-dialog-body{padding:23px}.service-dialog-body h3{font-size:21px}.service-more{font-size:11px}}
  @media(max-width:950px){.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.services-container{max-width:750px}}
  @media(max-width:600px){.services-section{padding:54px 0 62px}.services-container{padding:0 16px}.services-heading{margin-bottom:28px}.services-grid{gap:13px}.service-card{border-radius:12px}.service-photo{aspect-ratio:1.12}.service-content{padding:15px 14px 19px}.service-content h3{font-size:13px;line-height:1.3}.service-content p{font-size:11px;line-height:1.5}}
  @media(max-width:360px){.services-grid{grid-template-columns:1fr}.service-photo{aspect-ratio:1.5}.service-content h3{font-size:15px}.service-content p{font-size:12px}}
  @media(prefers-reduced-motion:reduce){.service-card,.service-photo img{transition:none}.service-card:hover,.service-card:hover .service-photo img{transform:none}}
</style>