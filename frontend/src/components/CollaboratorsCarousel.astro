---
const institutions = [
  { name: 'Pontificia Universidad Católica del Perú', image: '/Universidades/LOGO_CATOLICA.jpg' },
  { name: 'Universidad Peruana Cayetano Heredia', image: '/Universidades/LOGO_CAYETANO.png' },
  { name: 'Universidad Nacional Mayor de San Marcos', image: '/Universidades/LOGO_UNMSM.png' },
  { name: 'Universidad Peruana Unión', image: '/Universidades/LOGO_UPEU.png' },
  { name: 'Universidad Ricardo Palma', image: '/Universidades/LOGO_URP.jpeg' },
  { name: 'Universidad Norbert Wiener', image: '/Universidades/LOGO_WIENER.png' },
  { name: 'Universidad Nacional Federico Villarreal', image: '/Universidades/logo_unfv.jpg' },
];
const logos = [...institutions, ...institutions, ...institutions, ...institutions];
---

<section id="clientes" class="partners-section scroll-mt-24" aria-labelledby="partners-title">
  <div class="partners-heading">
    <span class="partners-eyebrow">SENIORLINK</span>
    <h2 id="partners-title">Nuestros clientes y colaboradores</h2>
    <p>Instituciones que forman parte de nuestra comunidad.</p>
  </div>
  <div class="partners-marquee" aria-label="Universidades colaboradoras">
    <div class="partners-track">
      {logos.map((institution, index) => (
        <div class="partner-logo" aria-hidden={index >= institutions.length ? 'true' : undefined}>
          <img src={institution.image} alt={index < institutions.length ? institution.name : ''} loading={index < institutions.length ? 'eager' : 'lazy'} decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-section{padding:64px 0 72px;background:#f2f0fc;overflow:hidden}
  .partners-heading{text-align:center;padding:0 20px 32px}
  .partners-eyebrow{display:block;font-size:11px;font-weight:800;letter-spacing:.15em;color:#628d88;margin-bottom:10px}
  .partners-heading h2{font-size:clamp(25px,3vw,36px);font-weight:800;letter-spacing:-.03em;color:#264841;line-height:1.2;margin:0 0 10px}
  .partners-heading p{font-size:14px;color:#6d827f;margin:0}
  .partners-marquee{width:100%;overflow:hidden;user-select:none;pointer-events:none}
  .partners-track{display:flex;align-items:center;width:max-content;animation:partners-scroll 48s linear infinite;will-change:transform}
  .partner-logo{width:clamp(135px,15vw,185px);height:100px;flex:none;display:flex;align-items:center;justify-content:center;padding:10px 8px}
  .partner-logo img{display:block;max-width:100%;max-height:80px;width:auto;height:auto;object-fit:contain}
  @keyframes partners-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media(max-width:600px){
    .partners-section{padding:48px 0 55px}
    .partners-heading{padding-bottom:20px}
    .partner-logo{width:142px;height:88px;padding:8px 6px}
    .partner-logo img{max-height:74px}
  }
  @media(prefers-reduced-motion:reduce){.partners-track{animation:none}}
</style>
