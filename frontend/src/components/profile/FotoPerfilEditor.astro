<div class="photo-profile-area">
  <button id="photo-profile-trigger" type="button" class="photo-profile-trigger" aria-label="Actualizar foto de perfil" title="Actualizar foto de perfil">
    <img id="photo-profile-avatar" alt="Mi fotografía" hidden />
    <span id="photo-profile-placeholder" aria-hidden="true">Foto</span>
  </button>
</div>
<div id="photo-profile-modal" class="photo-profile-modal" hidden>
  <div class="photo-profile-window" role="dialog" aria-modal="true" aria-labelledby="photo-profile-title" aria-describedby="photo-profile-description">
    <h2 id="photo-profile-title">Tu fotografía de perfil</h2>
    <p id="photo-profile-description">Selecciona una foto JPG, PNG o WebP de hasta 5 MB. Todos los usuarios deben contar con una fotografía para utilizar SeniorLink.</p>
    <form id="photo-profile-form">
      <label for="photo-profile-file">Seleccionar fotografía</label>
      <input id="photo-profile-file" type="file" accept="image/jpeg,image/png,image/webp" required />
      <p id="photo-profile-status" role="status" aria-live="polite"></p>
      <div class="photo-profile-actions">
        <button id="photo-profile-close" type="button">Cancelar</button>
        <button id="photo-profile-submit" type="submit">Guardar foto</button>
      </div>
    </form>
  </div>
</div>
<style>
  .photo-profile-area{display:flex;align-items:center}
  .photo-profile-trigger{width:43px;height:43px;padding:0;border:2px solid #bee7dc;background:#e3f5ec;color:#14665a;border-radius:50%;overflow:hidden;display:grid;place-items:center;cursor:pointer;font:600 11px Lexend,sans-serif}
  .photo-profile-trigger img{width:100%;height:100%;object-fit:cover;display:block}
  .photo-profile-trigger img[hidden]{display:none}
  .photo-profile-modal[hidden]{display:none!important}
  .photo-profile-modal{position:fixed;inset:0;z-index:1000;background:rgba(8,35,28,.72);display:flex;justify-content:center;align-items:center;padding:16px}
  .photo-profile-window{background:#fff;border-radius:19px;width:min(460px,100%);padding:27px;box-shadow:0 12px 60px rgba(0,0,0,.24);color:#153b32}
  .photo-profile-window h2{font-size:21px;margin:0 0 12px}
  .photo-profile-window p{font-size:13px;line-height:1.65;margin-bottom:15px}
  .photo-profile-window label{display:block;font-weight:700;margin-bottom:8px}
  .photo-profile-window input{width:100%;padding:11px;border:1px solid #b4d3c8;border-radius:9px}
  .photo-profile-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}
  .photo-profile-actions button{border-radius:9px;padding:10px 15px;border:1px solid #0d8070;background:white;color:#0d6659;font:600 13px Lexend;cursor:pointer}
  .photo-profile-actions button[type=submit]{background:#0d8070;color:white}
  .photo-profile-actions button[hidden]{display:none}
  #photo-profile-status{color:#b42318;min-height:1.2em}
</style>
<script>
  import { API_URL, getSession, fetchProfile } from '../../lib/auth.js';
  import { mostrarFotoProtegida } from '../../lib/profile-photo';
  const trigger = document.querySelector<HTMLButtonElement>('#photo-profile-trigger');
  const avatar = document.querySelector<HTMLImageElement>('#photo-profile-avatar');
  const placeholder = document.querySelector<HTMLElement>('#photo-profile-placeholder');
  const modal = document.querySelector<HTMLElement>('#photo-profile-modal');
  const close = document.querySelector<HTMLButtonElement>('#photo-profile-close');
  const form = document.querySelector<HTMLFormElement>('#photo-profile-form');
  const file = document.querySelector<HTMLInputElement>('#photo-profile-file');
  const status = document.querySelector<HTMLElement>('#photo-profile-status');
  const submit = document.querySelector<HTMLButtonElement>('#photo-profile-submit');
  let obligatoria = true;
  let usuarioDni = '';
  function abrir(requerida:boolean) {
    obligatoria = requerida;
    if(close) close.hidden = requerida;
    if(modal) modal.hidden = false;
    file?.focus();
  }
  function cerrar(){
    if(obligatoria) return;
    if(modal) modal.hidden=true;
    if(file) file.value='';
    if(status) status.textContent='';
  }
  trigger?.addEventListener('click',()=>abrir(obligatoria));
  close?.addEventListener('click',cerrar);
  document.addEventListener('seniorlink:profile', async (e) => {
    const detail = (e as CustomEvent).detail;
    usuarioDni = String(detail?.usuario?.dni || '');
    const fotoUrl = detail?.usuario?.fotoUrl;
    obligatoria = !fotoUrl;
    if(fotoUrl && avatar){
      const ok = await mostrarFotoProtegida(usuarioDni, avatar);
      if(placeholder) placeholder.hidden = ok;
      if(!ok) abrir(true);
    } else {
      if(placeholder) placeholder.hidden = false;
      abrir(true);
    }
  });
  form?.addEventListener('submit',async event => {
    event.preventDefault();
    const foto = file?.files?.[0];
    const sesion = getSession();
    if(!sesion || !usuarioDni || !status || !submit) return;
    if(!foto || !['image/jpeg','image/png','image/webp'].includes(foto.type) ||
        foto.size===0 || foto.size>5*1024*1024){
      status.textContent='Selecciona un archivo JPG, PNG o WebP de hasta 5 MB.';
      return;
    }
    const datos=new FormData();
    datos.append('foto',foto);
    submit.disabled=true;
    status.textContent='Guardando imagen...';
    try{
      const respuesta = await fetch(API_URL+'/api/v1/usuarios/me/foto',{
        method:'PUT',headers:{Authorization:'Bearer '+sesion.accessToken},body:datos
      });
      if(!respuesta.ok){
        let mensaje='No se pudo guardar la fotografía.';
        try{const j=await respuesta.json();mensaje=j.detail||j.message||mensaje;}catch{}
        throw new Error(mensaje);
      }
      const perfil=await fetchProfile(sesion);
      if(avatar){const ok=await mostrarFotoProtegida(usuarioDni,avatar);if(placeholder)placeholder.hidden=ok;}
      obligatoria=false;
      if(modal)modal.hidden=true;
      if(file)file.value='';
      status.textContent='';
      document.dispatchEvent(new CustomEvent('seniorlink:profile-photo-updated',{detail:perfil}));
    }catch(error){status.textContent=error instanceof Error?error.message:String(error);}
    finally{submit.disabled=false;}
  });
</script>
