---
interface Props { role:string; route:string; home:string }
const {role,route,home}=Astro.props;
type Paso=[string,string,string?];
type Guia={titulo:string;pasos:Paso[]};
const homeGuides:Record<string,Guia>={
 FAMILIAR:{titulo:'Empieza a gestionar el acompañamiento de tu familiar',pasos:[['Vincula a tu familiar','Solicita autorización antes de reservar.','/familiar/vinculaciones'],['Elige un acompañante','Revisa perfiles y disponibilidad.','/familiar/acompanantes'],['Solicita el servicio','Selecciona las jornadas y confirma los datos.','/familiar/reservas'],['Consulta el progreso','Revisa solicitudes, pagos y confirmaciones.','/familiar/mis-reservas']]},
 ADULTO_MAYOR:{titulo:'Encuentra acompañamiento y gestiona tus servicios',pasos:[['Consulta acompañantes','Revisa sus perfiles y horarios.','/adulto-mayor/acompanantes'],['Solicita acompañamiento','Elige el servicio y las fechas.','/adulto-mayor/reservas'],['Revisa tus reservas','Consulta el estado y las próximas jornadas.','/adulto-mayor/mis-reservas'],['Gestiona tus familiares','Revisa y responde solicitudes de vinculación.','/adulto-mayor/vinculaciones']]},
 ACOMPANANTE:{titulo:'Organiza tu trabajo como acompañante',pasos:[['Configura tu disponibilidad','Revisa horarios y tarifa.','/acompanante/disponibilidad'],['Revisa solicitudes','Acepta o rechaza según tu disponibilidad.','/acompanante/solicitudes'],['Gestiona las jornadas','Consulta tu agenda y registra el progreso.','/acompanante/solicitudes'],['Consulta liquidaciones','Revisa el estado de tus ingresos.','/acompanante/liquidaciones']]},
 SOPORTE:{titulo:'Atiende las consultas de los usuarios',pasos:[['Revisa las incidencias','Identifica las solicitudes pendientes.','/soporte/incidencias'],['Consulta el contexto','Revisa la información disponible del caso.','/soporte/incidencias'],['Registra el seguimiento','Mantén la atención dentro del sistema.','/soporte/incidencias'],['Revisa tu cuenta','Consulta tus datos de trabajo.','/soporte/mi-perfil']]},
 ADMINISTRADOR:{titulo:'Supervisa la operación de SeniorLink',pasos:[['Gestiona usuarios','Consulta cuentas y perfiles.','/admin/usuarios'],['Supervisa reservas','Revisa contrataciones y estados.','/admin/reservas'],['Controla pagos','Consulta movimientos y liquidaciones.','/admin/pagos'],['Atiende incidencias','Revisa los casos que requieren seguimiento.','/admin/incidencias']]}
};
const sections:Record<string,Guia>={
 acompanantes:{titulo:'Encuentra el acompañante adecuado',pasos:[['Consulta los perfiles','Revisa experiencia, institución y valoraciones.'],['Compara disponibilidad','Comprueba los horarios antes de solicitar.'],['Solicita acompañamiento','Selecciona el servicio desde Reservas.',home+'/reservas']]},
 'metodos-pago':{titulo:'Prepara tu método de pago',pasos:[['Revisa el entorno','Usa únicamente los métodos habilitados por SeniorLink.'],['Registra un método','Completa los datos solicitados dentro de la plataforma.'],['Consulta tu reserva','El pago se gestiona desde Mis reservas.',home+'/mis-reservas']]},
 incidencias:{titulo:role==='SOPORTE'||role==='ADMINISTRADOR'?'Gestiona las incidencias':'Consulta el seguimiento de tus incidencias',pasos:role==='SOPORTE'||role==='ADMINISTRADOR'?[['Revisa la lista','Identifica los casos pendientes y su estado.'],['Consulta el detalle','Revisa el contexto de la reserva y la información disponible.'],['Registra el seguimiento','Utiliza únicamente las acciones autorizadas por tu rol.']]:[['Identifica la reserva','Consulta la contratación relacionada.',home+'/mis-reservas'],['Reporta el problema','Describe la situación mediante las opciones disponibles en tu reserva.'],['Consulta el seguimiento','Revisa el estado de la incidencia en esta sección.']]},
 disponibilidad:{titulo:'Configura tu agenda y tarifa',pasos:[['Revisa tus horarios','Consulta los días y franjas de atención.'],['Actualiza disponibilidad','Registra horarios y bloqueos según corresponda.'],['Revisa la tarifa','Comprueba el importe y guarda los cambios.']]},
 liquidaciones:{titulo:'Consulta las liquidaciones',pasos:[['Identifica la contratación','Revisa la reserva asociada.'],['Consulta los importes','Comprueba el detalle y estado de la liquidación.'],['Revisa pendientes','Utiliza las opciones disponibles según tu rol.']]},
 usuarios:{titulo:'Administra las cuentas',pasos:[['Busca al usuario','Filtra por los datos disponibles.'],['Consulta su perfil','Revisa el rol y la información correspondiente.'],['Gestiona cambios','Verifica los datos antes de guardar.']]},
 perfiles:{titulo:'Consulta los perfiles por rol',pasos:[['Identifica al usuario','Busca la cuenta que necesitas revisar.'],['Revisa los datos del perfil','Consulta los campos específicos de este rol.'],['Verifica antes de editar','Conserva los datos que no necesitan cambios.']]},
 instituciones:{titulo:'Gestiona las instituciones aliadas',pasos:[['Consulta el registro','Busca la institución por su información.'],['Verifica los datos','Revisa el RUC y los campos disponibles.'],['Gestiona cambios','Confirma los datos antes de guardar.']]},
 promociones:{titulo:'Gestiona las promociones',pasos:[['Consulta promociones','Revisa condiciones y vigencia.'],['Comprueba los datos','Verifica los importes y fechas.'],['Guarda los cambios','Confirma la información antes de aplicar.']]},
 pagos:{titulo:'Supervisa los pagos',pasos:[['Identifica la reserva','Consulta participantes y estado.'],['Revisa los importes','Comprueba el detalle de la operación.'],['Consulta el seguimiento','Revisa liquidaciones o incidencias cuando corresponda.']]},
 'configuracion-reservas':{titulo:'Revisa las reglas de contratación',pasos:[['Consulta los parámetros','Revisa los valores vigentes.'],['Evalúa los cambios','Ten en cuenta su efecto sobre las reservas.'],['Guarda y verifica','Comprueba los valores tras guardar.']]},
 reservas:{titulo:'Supervisa las contrataciones',pasos:[['Consulta las reservas','Identifica participantes, jornadas y estado.'],['Revisa el seguimiento','Comprueba las acciones y registros disponibles.'],['Consulta pagos e incidencias','Usa los módulos correspondientes cuando sea necesario.']]}
};
const sub=route.slice(home.length).split('/').filter(Boolean)[0]||'';
const guia=route===home?homeGuides[role]:((['mi-perfil','vinculaciones','mis-reservas','solicitudes'].includes(sub)||(sub==='reservas'&&role!=='ADMINISTRADOR'))?undefined:sections[sub]);
---
{guia && <section class="role-guide" aria-label="Guía de esta sección">
 <details open={route===home}>
  <summary><span class="role-guide-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/></svg></span><span><small>GUÍA DE USO</small><strong>{guia.titulo}</strong><span class="role-guide-hint">Consulta los pasos de esta sección</span></span><svg class="role-guide-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
  <ol>{guia.pasos.map(([titulo,detalle,href],i)=><li><span class="role-guide-num">{String(i+1).padStart(2,'0')}</span><h3>{titulo}</h3><p>{detalle}</p>{href&&<a href={href}>Ir a la sección →</a>}</li>)}</ol>
 </details>
</section>}
<style>
.role-guide{background:#eff9f4;border:1px solid #d5ebe1;border-radius:15px;padding:16px;margin:0 0 20px;color:#174e42}.role-guide summary{list-style:none;display:flex;align-items:center;gap:12px;cursor:pointer}.role-guide summary::-webkit-details-marker{display:none}.role-guide summary strong,.role-guide summary small,.role-guide-hint{display:block}.role-guide summary small{font-size:10px;font-weight:700;letter-spacing:.12em;color:#087a70}.role-guide summary strong{font-size:16px;margin:4px 0}.role-guide-hint{font-size:12px;color:#52665f}.role-guide-icon{display:grid;place-items:center;width:44px;height:44px;background:#d9f0e5;color:#087a70;border-radius:12px;flex-shrink:0}.role-guide-chevron{margin-left:auto;flex-shrink:0}.role-guide details[open] .role-guide-chevron{transform:rotate(180deg)}.role-guide ol{list-style:none;padding:0;margin:16px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}.role-guide li{background:white;border:1px solid #d5ebe1;border-radius:11px;padding:14px}.role-guide-num{font-weight:700;color:#087a70;font-size:12px}.role-guide h3{font-size:14px;margin:8px 0 4px}.role-guide p{font-size:13px;line-height:1.5;margin:0;color:#405d55}.role-guide a{display:inline-block;margin-top:10px;font-size:13px;color:#087a70;font-weight:600}.role-guide summary:focus-visible,.role-guide a:focus-visible{outline:2px solid #087a70;outline-offset:3px}@media(max-width:500px){.role-guide ol{grid-template-columns:1fr}}
</style>
