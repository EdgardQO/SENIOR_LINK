---
const year = new Date().getFullYear();
const whatsappUrl = 'https://wa.me/51934004275?text=' + encodeURIComponent('Hola, quisiera recibir información sobre SeniorLink.');
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="#inicio" class="footer-logo" aria-label="SeniorLink - Volver al inicio">
          <span class="footer-logo-surface">
            <img src="/LOGO/LOGO%20CON%20FRASE.png" alt="SeniorLink" loading="lazy" decoding="async" />
          </span>
        </a>
        <p>Conectamos generaciones para brindar compañía, cercanía y apoyo en cada etapa de la vida.</p>
        <span class="footer-location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg> Lima, Perú</span>
      </div>

      <nav class="footer-column" aria-label="Explora SeniorLink">
        <h3>Explora</h3>
        <a href="#inicio">Inicio</a>
        <a href="#servicios">Nuestros servicios</a>
        <a href="#como-funciona">¿Cómo funciona?</a>
        <a href="#acompanantes">Acompañantes destacados</a>
      </nav>

      <nav class="footer-column" aria-label="Información de SeniorLink">
        <h3>SeniorLink</h3>
        <a href="#nosotros">Sobre nosotros</a>
        <a href="#clientes">Instituciones colaboradoras</a>
        <a href="#contacto">Contacto</a>
        <a href="/registro?rol=acompanante">Ser acompañante</a>
      </nav>

      <div class="footer-column footer-contact">
        <h3>Hablemos</h3>
        <p>¿Tienes alguna consulta? Estamos para ayudarte.</p>
        <a href="mailto:dabertquijano@gmail.com" class="footer-contact-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          dabertquijano@gmail.com
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-whatsapp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/></svg>
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} SeniorLink Perú. Todos los derechos reservados.</p>
      <a href="#inicio">Volver al inicio <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer{background:#102b29;color:#c1d2cc;border-top:1px solid #20453e}
  .footer-container{max-width:1200px;margin:0 auto;padding:0 28px}
  .footer-main{display:grid;grid-template-columns:1.35fr .75fr .85fr 1.15fr;gap:52px;padding:72px 0 62px}
  .footer-brand{min-width:0}
  .footer-logo{display:inline-flex;text-decoration:none}
  .footer-logo-surface{display:flex;align-items:center;justify-content:center;min-height:70px;padding:9px 15px;border-radius:13px;background:#fff;box-shadow:0 6px 24px rgba(0,0,0,.1)}
  .footer-logo img{display:block;width:auto;max-width:195px;height:48px;object-fit:contain}
  .footer-brand>p{max-width:285px;margin:22px 0 19px;font-size:13px;line-height:1.9;color:#b4cac1}
  .footer-location{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:#90b8aa}
  .footer-location svg{width:16px;height:16px}
  .footer-column{display:flex;flex-direction:column;align-items:flex-start;gap:14px;min-width:0}
  .footer-column h3{margin:4px 0 10px;color:#fff;font-size:14px;font-weight:800;letter-spacing:.015em}
  .footer-column>a:not(.footer-whatsapp){color:#b4cac1;font-size:13px;line-height:1.6;text-decoration:none;transition:color .2s}
  .footer-column>a:hover{color:#fff}
  .footer-contact>p{margin:-3px 0 3px;color:#b4cac1;font-size:13px;line-height:1.75}
  .footer-contact-link{display:inline-flex;align-items:flex-start;gap:9px;overflow-wrap:anywhere}
  .footer-contact-link svg{width:17px;height:17px;flex-shrink:0;margin-top:2px;color:#8ad8ba}
  .footer-whatsapp{display:inline-flex;align-items:center;justify-content:center;gap:10px;margin-top:5px;padding:13px 15px;border:1px solid #4b987b;border-radius:10px;background:#23765f;color:#fff;font-size:12px;font-weight:800;text-decoration:none;transition:background .2s,transform .2s}
  .footer-whatsapp svg{width:18px;height:18px;flex-shrink:0}
  .footer-whatsapp:hover{background:#2a9275;transform:translateY(-2px)}
  .footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:23px 0 28px;border-top:1px solid rgba(204,232,217,.15)}
  .footer-bottom p{margin:0;color:#91aaa0;font-size:12px}
  .footer-bottom a{display:inline-flex;align-items:center;gap:9px;color:#c3ded1;font-size:12px;font-weight:700;text-decoration:none}
  .footer-bottom a:hover{color:#fff}
  .footer-bottom a span{font-size:17px}
  @media(max-width:1050px){.footer-main{grid-template-columns:1.3fr 1fr;gap:42px 55px}}
  @media(max-width:640px){.footer-container{padding:0 20px}.footer-main{grid-template-columns:repeat(2,minmax(0,1fr));gap:35px 20px;padding:52px 0 42px}.footer-brand,.footer-contact{grid-column:1/-1}.footer-brand>p{max-width:380px}.footer-column{gap:12px}.footer-column h3{margin-bottom:7px}.footer-whatsapp{margin-top:5px}.footer-bottom{flex-direction:column;align-items:flex-start;padding:22px 0 28px}.footer-logo-surface{min-height:65px}.footer-logo img{height:45px}}
  @media(prefers-reduced-motion:reduce){.footer-column>a,.footer-whatsapp{transition:none}.footer-whatsapp:hover{transform:none}}
</style>