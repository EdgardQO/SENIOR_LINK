---
---

<section id="login" class="auth-section">
  <h2>Bienvenido de nuevo</h2>
  <p class="sub">Ingresa con tu correo y contraseña.</p>

  <form id="loginForm">
    <div class="field">
      <label for="lEmail">Correo electrónico</label>
      <input id="lEmail" type="email" placeholder="nombre@correo.com" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="lPass">Contraseña</label>
      <div class="pw">
        <input id="lPass" type="password" placeholder="Tu contraseña" autocomplete="current-password" required />
        <button type="button" class="toggle" data-target="lPass" aria-label="Mostrar contraseña">Mostrar</button>
      </div>
    </div>

    <label class="check-row">
      <input type="checkbox" id="lRemember" /> Mantener sesión iniciada
    </label>
    <p class="support-note">Si olvidaste tu contraseña, contacta con soporte.</p>
    <p class="msg" id="lMsg" role="status" aria-live="polite"></p>
    <button class="btn" type="submit">Ingresar</button>
  </form>

  <p class="switch">¿Aún no tienes cuenta? <a class="linkbtn" href="/registro">Crear cuenta</a></p>
  <p class="secure">🔒 Conexión segura. Protegemos tus datos personales.</p>
</section>

<style>
.auth-section {
  width: 100%;
}
h2 {
  font-size: 1.9rem;
  margin: 0 0 8px;
  font-weight: 600;
  color: var(--color-text-main);
}
.sub {
  color: var(--color-text-muted);
  margin: 0 0 26px;
}
label {
  display: block;
  font-weight: 600;
  font-size: 0.95rem;
  margin: 0 0 8px;
  color: var(--color-text-main);
}
.field {
  margin-bottom: 22px;
}
input[type="email"],
input[type="password"] {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  font: inherit;
  font-size: 0.95rem;
  color: var(--color-text-main);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background: var(--color-bg-card);
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}
input::placeholder {
  color: var(--color-text-muted);
  opacity: 0.7;
}
input:focus-visible {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.2);
}
.pw {
  position: relative;
}
.pw input {
  padding-right: 96px;
}
.toggle {
  position: absolute;
  right: 6px;
  top: 6px;
  height: 40px;
  padding: 0 14px;
  border: 0;
  border-radius: 8px;
  background: var(--color-primary-light);
  color: var(--color-primary-hover);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
}
.toggle:hover {
  background: #ccfbf1;
}
.toggle:focus-visible,
.btn:focus-visible {
  outline: 3px solid rgba(13, 148, 136, 0.4);
  outline-offset: 2px;
}
.check-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 0.93rem;
  margin-bottom: 18px;
  cursor: pointer;
  color: var(--color-text-main);
}
.check-row input {
  width: 20px;
  height: 20px;
  margin: 1px 0 0;
  accent-color: var(--color-primary);
  flex: none;
}
.btn {
  width: 100%;
  height: 52px;
  border: 0;
  border-radius: 14px;
  background: var(--color-primary);
  color: #fff;
  font: inherit;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.15s;
}
.btn:hover {
  background: var(--color-primary-hover);
}
.switch {
  text-align: center;
  color: var(--color-text-muted);
  margin: 22px 0 0;
}
.linkbtn {
  font: inherit;
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: underline;
  cursor: pointer;
}
.linkbtn:hover {
  color: var(--color-primary-hover);
}
.secure {
  text-align: center;
  font-size: 0.82rem;
  color: var(--color-text-muted);
  margin-top: 26px;
}
.support-note {
  color: var(--color-text-muted);
  font-size: 0.85rem;
  margin: 0 0 16px;
}
.msg {
  font-size: 0.85rem;
  color: #dc2626;
  margin: 6px 0 0;
  min-height: 0;
}
.msg:empty { display: none; }
</style>

<script>
  import { API_URL, getSession, homeForRole, saveSession } from '../../lib/auth.js';

  const form = document.querySelector<HTMLFormElement>('#loginForm');
  const email = document.querySelector<HTMLInputElement>('#lEmail');
  const password = document.querySelector<HTMLInputElement>('#lPass');
  const remember = document.querySelector<HTMLInputElement>('#lRemember');
  const message = document.querySelector<HTMLParagraphElement>('#lMsg');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const toggle = form?.querySelector<HTMLButtonElement>('.toggle');

  const existingSession = getSession();
  if (existingSession) window.location.replace(homeForRole(existingSession.rolNombre));

  if (form && email && password && remember && message && submit) {
    toggle?.addEventListener('click', () => {
      const visible = password.type === 'password';
      password.type = visible ? 'text' : 'password';
      toggle.textContent = visible ? 'Ocultar' : 'Mostrar';
      toggle.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });

    if (new URLSearchParams(window.location.search).get('registro') === 'ok') {
      message.style.color = '#047857';
      message.textContent = 'Cuenta creada correctamente. Ya puedes iniciar sesión.';
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.style.color = '#dc2626';
      message.textContent = '';

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Ingresando...';

      try {
        const response = await fetch(`${API_URL}/api/v1/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            correoElectronico: email.value.trim(),
            contrasena: password.value
          })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(response.status === 401
            ? 'Correo o contraseña incorrectos.'
            : data.message || data.error || 'No se pudo iniciar sesión.');
        }

        const destination = saveSession(data, remember.checked);
        window.location.replace(destination);
      } catch (error) {
        message.textContent = error instanceof TypeError
          ? 'No se pudo conectar con el servidor. Verifica que la API esté encendida.'
          : error instanceof Error ? error.message : 'Ocurrió un error al iniciar sesión.';
        submit.disabled = false;
        submit.textContent = 'Ingresar';
      }
    });
  }
</script>