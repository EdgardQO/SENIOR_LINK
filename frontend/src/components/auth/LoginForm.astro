---
// src/components/auth/LoginForm.astro
---

<section id="login" class="auth-section">
  <h2>Bienvenido de nuevo</h2>
  <p class="sub">Ingresa con tu correo y contraseña.</p>

  <form id="loginForm" novalidate>
    <div class="field">
      <label for="lEmail">Correo electrónico</label>
      <input id="lEmail" type="email" placeholder="nombre@correo.com" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="lPass">Contraseña</label>
      <div class="pw">
        <input id="lPass" type="password" placeholder="Tu contraseña" autocomplete="current-password" required />
        <button type="button" class="toggle" data-target="lPass" aria-label="Mostrar contraseña">Mostrar</button>
      </div>
      <p class="msg" id="lMsg" role="alert"></p>
    </div>

    <label class="check-row">
      <input type="checkbox" id="lRemember" /> Mantener sesión iniciada
    </label>
    <p class="sub">Si olvidaste tu contraseña, contacta con soporte.</p>
    <button class="btn" type="submit">Ingresar</button>
  </form>

  <p class="switch">¿Aún no tienes cuenta? <a class="linkbtn" href="/registro">Crear cuenta</a></p>
  <p class="secure">🔒 Conexión segura. Protegemos tus datos personales.</p>
</section>

<style>
.auth-section {
  width: 100%;
}
h2 {
  font-size: 1.9rem;
  margin: 0 0 8px;
  font-weight: 600;
  color: var(--color-text-main);
}
.sub {
  color: var(--color-text-muted);
  margin: 0 0 26px;
}
label {
  display: block;
  font-weight: 600;
  font-size: 0.95rem;
  margin: 0 0 8px;
  color: var(--color-text-main);
}
.field {
  margin-bottom: 22px;
}
input[type="email"],
input[type="password"] {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  font: inherit;
  font-size: 0.95rem;
  color: var(--color-text-main);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background: var(--color-bg-card);
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}
input::placeholder {
  color: var(--color-text-muted);
  opacity: 0.7;
}
input:focus-visible {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.2);
}
input.invalid {
  border-color: #dc2626;
}
.pw {
  position: relative;
}
.pw input {
  padding-right: 96px;
}
.toggle {
  position: absolute;
  right: 6px;
  top: 6px;
  height: 40px;
  padding: 0 14px;
  border: 0;
  border-radius: 8px;
  background: var(--color-primary-light);
  color: var(--color-primary-hover);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
}
.toggle:hover {
  background: #ccfbf1;
}
.toggle:focus-visible,
.btn:focus-visible {
  outline: 3px solid rgba(13, 148, 136, 0.4);
  outline-offset: 2px;
}
.check-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 0.93rem;
  margin-bottom: 18px;
  cursor: pointer;
  color: var(--color-text-main);
}
.check-row input {
  width: 20px;
  height: 20px;
  margin: 1px 0 0;
  accent-color: var(--color-primary);
  flex: none;
}
.forgot {
  display: inline-block;
  font-weight: 600;
  margin-bottom: 22px;
  color: var(--color-primary);
  text-decoration: none;
}
.forgot:hover {
  color: var(--color-primary-hover);
  text-decoration: underline;
}
.btn {
  width: 100%;
  height: 52px;
  border: 0;
  border-radius: 14px;
  background: var(--color-primary);
  color: #fff;
  font: inherit;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.15s;
}
.btn:hover {
  background: var(--color-primary-hover);
}
.switch {
  text-align: center;
  color: var(--color-text-muted);
  margin: 22px 0 0;
}
.linkbtn {
  font: inherit;
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: underline;
  cursor: pointer;
}
.linkbtn:hover {
  color: var(--color-primary-hover);
}
.secure {
  text-align: center;
  font-size: 0.82rem;
  color: var(--color-text-muted);
  margin-top: 26px;
}
.msg {
  font-size: 0.85rem;
  color: #dc2626;
  margin: 6px 0 0;
  min-height: 0;
}
</style>

<script>
import { API_URL, saveSession } from '../../lib/auth.js';
const emailOk = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
document.querySelectorAll('.toggle').forEach(btn => btn.addEventListener('click', () => {
  const input = document.getElementById(btn.dataset.target);
  if (!input) return;
  const visible = input.type === 'password';
  input.type = visible ? 'text' : 'password';
  btn.textContent = visible ? 'Ocultar' : 'Mostrar';
}));
document.getElementById('loginForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  const email = document.getElementById('lEmail');
  const pass = document.getElementById('lPass');
  const msg = document.getElementById('lMsg');
  const button = e.currentTarget.querySelector('button[type="submit"]');
  msg.textContent = '';
  if (!emailOk(email.value.trim()) || !pass.value) {
    msg.textContent = 'Ingresa un correo válido y tu contraseña.';
    return;
  }
  button.disabled = true;
  button.textContent = 'Ingresando...';
  try {
    const response = await fetch(API_URL + '/api/v1/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ correoElectronico: email.value.trim(), contrasena: pass.value })
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(response.status === 401 ? 'Correo o contraseña incorrectos.' : (data.error || data.message || 'No se pudo iniciar sesión.'));
    if (!data.accessToken || !data.rutaInicio) throw new Error('Respuesta de autenticación incompleta.');
    const route = saveSession(data, document.getElementById('lRemember').checked);
    window.location.replace(route);
  } catch (error) {
    msg.textContent = error instanceof TypeError ? 'No se pudo conectar con el servidor. Verifica que la API esté encendida.' : error.message;
  } finally {
    button.disabled = false;
    button.textContent = 'Ingresar';
  }
});
const params = new URLSearchParams(window.location.search);
if (params.get('registro') === 'ok') {
  const msg = document.getElementById('lMsg');
  msg.style.color = '#047857';
  msg.textContent = 'Cuenta creada correctamente. Ya puedes iniciar sesión.';
}
</script>