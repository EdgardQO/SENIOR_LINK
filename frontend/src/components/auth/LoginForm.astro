---
// src/components/auth/LoginForm.astro
---

<section id="login" class="auth-section">
  <h2>Bienvenido de nuevo</h2>
  <p class="sub">Ingresa con tu correo y contraseña.</p>
  
  <form id="loginForm" novalidate>
    <div class="field">
      <label for="lEmail">Correo electrónico</label>
      <input id="lEmail" type="email" placeholder="nombre@correo.com" autocomplete="email" required />
    </div>
    
    <div class="field">
      <label for="lPass">Contraseña</label>
      <div class="pw">
        <input id="lPass" type="password" placeholder="Tu contraseña" autocomplete="current-password" required />
        <button type="button" class="toggle" data-target="lPass" aria-label="Mostrar contraseña">Mostrar</button>
      </div>
      <p class="msg" id="lMsg" role="alert"></p>
    </div>

    <label class="check-row"><input type="checkbox" checked /> Mantener sesión iniciada</label>
    <a class="forgot" href="#">¿Olvidaste tu contraseña?</a>
    <button class="btn" type="submit">Ingresar</button>
  </form>

  <p class="switch">¿Aún no tienes cuenta? <a class="linkbtn" href="/registro">Crear cuenta</a></p>
  <p class="secure">🔒 Conexión segura. Protegemos tus datos personales.</p>
</section>

<style>
:root{
  --navy:#0b2e4f; --blue:#1a8fcb; --blue-dark:#127bb0; --text:#5b6b7a;
  --line:#dbe6ee; --soft:#e1f0fa; --bg:#fff; --err:#c0392b;
}
.auth-section { width: 100%; }
h2{font-size:1.9rem;margin:0 0 8px;font-weight:600;color:var(--navy)}
.sub{color:var(--text);margin:0 0 26px}
label{display:block;font-weight:600;font-size:.95rem;margin:0 0 8px;color:var(--navy)}
.field{margin-bottom:22px}
input[type=email],input[type=password]{
  width:100%;height:52px;padding:0 16px;font:inherit;font-size:.95rem;color:var(--navy);
  border:1px solid var(--line);border-radius:12px;background:#fff;outline:none;transition:border-color .15s,box-shadow .15s}
input::placeholder{color:#8593a0}
input:focus-visible{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,143,203,.2)}
input.invalid{border-color:var(--err)}
.pw{position:relative}
.pw input{padding-right:96px}
.toggle{position:absolute;right:6px;top:6px;height:40px;padding:0 14px;border:0;border-radius:8px;background:var(--soft);color:var(--navy);font:inherit;font-weight:600;cursor:pointer}
.toggle:focus-visible,.btn:focus-visible{outline:3px solid rgba(26,143,203,.4);outline-offset:2px}
.check-row{display:flex;gap:12px;align-items:flex-start;font-size:.93rem;margin-bottom:18px;cursor:pointer}
.check-row input{width:20px;height:20px;margin:1px 0 0;accent-color:var(--blue);flex:none}
.forgot{display:inline-block;font-weight:600;margin-bottom:22px;color:var(--blue);text-decoration:none}
.btn{width:100%;height:52px;border:0;border-radius:14px;background:var(--blue);color:#fff;font:inherit;font-weight:600;font-size:1rem;cursor:pointer;transition:background .15s}
.btn:hover{background:var(--blue-dark)}
.switch{text-align:center;color:var(--text);margin:22px 0 0}
.linkbtn{font:inherit;font-weight:600;color:var(--blue);text-decoration:underline;cursor:pointer}
.secure{text-align:center;font-size:.82rem;color:var(--text);margin-top:26px}
.msg{font-size:.85rem;color:var(--err);margin:6px 0 0;min-height:0}
</style>

<script is:inline>
const emailOk = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
const mark = (el, bad) => el && el.classList.toggle('invalid', bad);

document.querySelectorAll('.toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const input = document.getElementById(btn.dataset.target);
    if (!input) return;
    const hidden = input.type === 'password';
    input.type = hidden ? 'text' : 'password';
    btn.textContent = hidden ? 'Ocultar' : 'Mostrar';
    btn.setAttribute('aria-label', hidden ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });
});

document.getElementById('loginForm')?.addEventListener('submit', e => {
  e.preventDefault();
  const email = document.getElementById('lEmail');
  const pass = document.getElementById('lPass');
  const lMsg = document.getElementById('lMsg');
  const badE = !emailOk(email.value.trim());
  const badP = !pass.value;
  mark(email, badE); 
  mark(pass, badP);
  if (lMsg) lMsg.textContent = badE ? 'Escribe un correo válido.' : badP ? 'Escribe tu contraseña.' : '';
  if (badE || badP) return;

  console.log('Login iniciado:', { email: email.value.trim() });
});
</script>