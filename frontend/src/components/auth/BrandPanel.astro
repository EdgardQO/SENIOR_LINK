---
// src/components/auth/BrandPanel.astro
interface Props {
  logoSrc?: string;
}

const { logoSrc = "" } = Astro.props;
---

<aside class="brand">
  <div class="brand-inner">
    <div class="logo-card">
      <img 
        src={logoSrc} 
        alt="SeniorLink: acompañamiento que conecta generaciones" 
        width="520" 
        height="401" 
        loading="eager"
      />
    </div>

    <h1>Acompañamiento de confianza, a un clic</h1>
    <p>Reserva, paga y haz seguimiento desde un solo lugar.</p>

    <ul>
      <li>
        <span class="check">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
          </svg>
        </span>
        Acompañantes con documentos verificados
      </li>
      <li>
        <span class="check">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
          </svg>
        </span>
        Reservas por horas con importe claro
      </li>
      <li>
        <span class="check">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
          </svg>
        </span>
        Historial para volver a elegir a tu favorito
      </li>
    </ul>

    <p class="note">Servicio de acompañamiento no clínico en Lima Metropolitana.</p>
  </div>
</aside>

<style>
.brand {
  position: relative;
  overflow: hidden;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 8%;
  background: linear-gradient(180deg, var(--color-primary-hover) 0%, var(--color-primary) 50%, var(--color-text-main) 100%);
}

.brand::after {
  content: "";
  position: absolute;
  right: -90px;
  bottom: -110px;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.brand-inner {
  position: relative;
  width: 100%;
  max-width: 520px;
  z-index: 1;
}

/* Tarjeta contenedora del logo: centrada horizontalmente */
.logo-card {
  background: var(--color-bg-card);
  border-radius: 20px;
  padding: 18px 24px;
  width: 100%;
  max-width: 280px;
  margin: 0 auto 36px auto; /* Centrado automático en el ancho disponible */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.22);
}

/* Imagen del logo sin deformación de altura */
.logo-card img {
  display: block;
  width: 100%;
  max-width: 220px;
  height: auto;
  object-fit: contain;
}

.brand h1 {
  font-size: clamp(2rem, 3.2vw, 2.75rem);
  line-height: 1.2;
  margin: 0 0 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand p {
  margin: 0 0 24px;
  font-size: 1.05rem;
  opacity: 0.95;
  line-height: 1.5;
}

.brand ul {
  list-style: none;
  margin: 0 0 28px;
  padding: 0;
  display: grid;
  gap: 16px;
}

.brand li {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.98rem;
}

.check {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: grid;
  place-items: center;
}

.check svg {
  width: 14px;
  height: 14px;
}

.note {
  font-size: 0.88rem;
  opacity: 0.8;
  margin: 0;
}

@media (max-width: 860px) {
  .brand {
    padding: 36px 24px;
  }
  .brand ul,
  .brand .note,
  .brand p {
    display: none;
  }
  .brand h1 {
    font-size: 1.55rem;
    margin: 0;
    text-align: center;
  }
  .logo-card {
    max-width: 190px;
    padding: 12px 18px;
    margin-bottom: 16px;
    border-radius: 14px;
  }
  .brand::after {
    display: none;
  }
}
</style>