---
const steps = [
  {
    step: '01',
    title: 'Regístrate y Vincula',
    desc: 'Crea tu cuenta con DNI. Si eres familiar, envía la solicitud de vinculación para que el adulto mayor la apruebe.',
  },
  {
    step: '02',
    title: 'Elige los Servicios y Horas',
    desc: 'Selecciona las horas necesarias por servicio y elige un acompañante según tarifa, calificaciones y perfil.',
  },
  {
    step: '03',
    title: 'Pago Protegido',
    desc: 'Paga con Mercado Pago en Soles (S/.). La reserva queda confirmada al instante con snapshot de precio congelado.',
  },
  {
    step: '04',
    title: 'Acompañamiento y Calificación',
    desc: 'Al terminar la asistencia, califica del 1 al 5 estrellas para ajustar la reputación de tu acompañante.',
  },
];
---

<section id="como-funciona" class="how-section" aria-labelledby="how-title">
  <div class="how-container">
    <div class="how-intro">
      <span class="how-eyebrow">PASO A PASO</span>
      <h2 id="how-title">¿Cómo funciona SeniorLink?</h2>
      <p>Conoce cómo encontrar acompañamiento de forma sencilla, desde el registro hasta la valoración del servicio.</p>
      <div class="how-hint" aria-hidden="true"><span>Explora los pasos</span><span>↓</span></div>
    </div>

    <div class="how-scroll" aria-label="Pasos para usar SeniorLink">
      <div class="how-timeline">
        {steps.map((st) => (
          <article class="how-step">
            <div class="how-marker" aria-hidden="true">{st.step}</div>
            <div class="how-step-content">
              <span class="how-step-label">PASO {st.step}</span>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#como-funciona');
  const items = [...(section?.querySelectorAll<HTMLElement>('.how-step') ?? [])];
  if (items.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      });
    }, { root: null, rootMargin: '-12% 0px -25% 0px', threshold: 0.1 });
    items.forEach(item => observer.observe(item));
  } else {
    items.forEach(item => item.classList.add('is-visible'));
  }
</script>

<style>
  .how-section{padding:95px 0;background:#f8faf9;border-top:1px solid #e5eee9;scroll-margin-top:85px}
  .how-container{max-width:1220px;margin:0 auto;padding:0 28px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:clamp(40px,7vw,100px);align-items:stretch}
  .how-intro{position:sticky;top:clamp(110px,28vh,260px);align-self:start}
  .how-eyebrow{display:inline-block;border:1px solid #a7cfc3;border-radius:50px;padding:7px 14px;color:#147a6c;font-size:11px;font-weight:800;letter-spacing:.11em}
  .how-intro h2{margin:20px 0 18px;color:#173e3a;font-size:clamp(30px,3.7vw,48px);line-height:1.13;letter-spacing:-.035em;font-weight:850}
  .how-intro>p{margin:0;max-width:480px;color:#6a7f79;font-size:17px;line-height:1.8}
  .how-hint{display:flex;align-items:center;gap:12px;margin-top:30px;color:#168579;font-size:12px;font-weight:750}
  .how-hint span:last-child{display:grid;place-items:center;width:32px;height:32px;border:1px solid #bcdad0;border-radius:50%;font-size:18px}
  .how-scroll{min-width:0;padding:0 14px 0 0;overflow:visible}
  .how-timeline{position:relative}
  .how-timeline::before{content:"";position:absolute;top:30px;bottom:65px;left:27px;width:2px;background:linear-gradient(#0d9488,#c6dfd6 45%,#dbe9e4)}
  .how-step{position:relative;display:grid;grid-template-columns:56px minmax(0,1fr);gap:30px;min-height:270px;opacity:.45;transform:translateY(16px);transition:opacity .55s ease,transform .55s ease}
  .how-step:last-child{min-height:210px}
  .how-step.is-visible{opacity:1;transform:translateY(0)}
  .how-marker{position:relative;z-index:1;width:56px;height:56px;display:grid;place-items:center;background:#f8faf9;border:1.5px solid #c6ded5;border-radius:50%;color:#81938d;font-size:20px;font-weight:800;transition:background .35s,border-color .35s,color .35s,box-shadow .35s}
  .how-step.is-visible .how-marker{background:#e5f4ee;border-color:#0d9488;color:#116f63;box-shadow:0 0 0 6px rgba(13,148,136,.07)}
  .how-step-content{padding-top:3px}
  .how-step-label{display:block;margin-bottom:9px;color:#168579;font-size:10px;font-weight:800;letter-spacing:.13em}
  .how-step-content h3{margin:0 0 13px;color:#203e39;font-size:clamp(19px,2vw,24px);font-weight:800;line-height:1.3}
  .how-step-content p{margin:0;max-width:390px;color:#6a7f79;font-size:15px;line-height:1.75}
  @media(max-width:849px){.how-section{padding:66px 0}.how-container{grid-template-columns:1fr;gap:38px}.how-intro{position:static}.how-intro h2{font-size:34px}.how-intro>p{font-size:15px}.how-hint{display:none}.how-scroll{padding:0}.how-step{min-height:205px;gap:20px}.how-step:last-child{min-height:150px}}
  @media(max-width:480px){.how-container{padding:0 20px}.how-intro h2{font-size:30px}.how-step{grid-template-columns:48px minmax(0,1fr);gap:16px;min-height:230px}.how-marker{width:48px;height:48px;font-size:17px}.how-timeline::before{left:23px}.how-step-content h3{font-size:19px}.how-step-content p{font-size:13px}}
  @media(prefers-reduced-motion:reduce){.how-step{opacity:1;transform:none;transition:none}.how-marker{transition:none}.how-scroll{scroll-behavior:auto}}
</style>