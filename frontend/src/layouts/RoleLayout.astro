---
import '../styles/global.css';
interface Props {
  role: string;
  label: string;
  description: string;
}
const { role, label, description } = Astro.props;
const adminSection = role === 'ADMINISTRADOR' && Astro.url.pathname !== '/admin';
const sectionNames: Record<string,string> = {
  '/admin/usuarios':'Usuarios',
  '/admin/mi-perfil':'Mi perfil',
  '/admin/reservas':'Reservas',
  '/admin/instituciones':'Instituciones',
  '/admin/promociones':'Promociones',
  '/admin/perfiles/ACOMPANANTE':'Acompañantes',
  '/admin/perfiles/ADULTO_MAYOR':'Adultos mayores',
  '/admin/perfiles/FAMILIAR':'Familiares',
  '/admin/perfiles/SOPORTE':'Soporte',
  '/admin/perfiles/ADMINISTRADOR':'Administradores'
};
const sectionName = sectionNames[Astro.url.pathname] || label;
---
<!doctype html>
<html lang="es" data-expected-role={role}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{label} | SeniorLink</title>
</head>
<body class="role-app">
  <div id="session-loading" class="session-loading">Verificando tu sesión...</div>
  <div id="app-shell" hidden>
    <header class="panel-header">
      <div class="panel-brand"><a href="/" class="panel-logo" aria-label="SeniorLink — ir al inicio"><img src="/LOGO/LOGO.png" alt="SeniorLink — acompañamiento de confianza" class="panel-brand-image" loading="eager" decoding="async" /></a></div>
      <div class="panel-header-actions"><span class="panel-role">{label}</span><button id="logout" type="button" class="panel-logout">Cerrar sesión</button></div>
    </header>
    <div class="panel-toolbar" role="toolbar" aria-label="Opciones de visualización">
      <button id="menu-toggle" type="button" class="panel-menu-toggle" aria-label="Ocultar barra lateral" aria-controls="panel-sidebar" aria-expanded="true">
        <svg class="panel-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
        <span class="menu-toggle-text">Ocultar barra lateral</span>
      </button>
    </div>
    <div class="panel-layout">
      <aside class="panel-sidebar" id="panel-sidebar">
        <div class="sidebar-caption">MI ESPACIO</div>
        {role !== "ADMINISTRADOR" && <a class="sidebar-link" href="#inicio"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-8h6v8"/></svg><span>Inicio</span></a>}
        <a class="sidebar-link" href={role === "ADMINISTRADOR" ? "/admin/mi-perfil" : "#mi-perfil"}><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Mi perfil</span></a>
        {role === 'ADMINISTRADOR' ? (
          <>
            <a class="sidebar-link" href="/admin"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>Dashboard</span></a>
            <a class="sidebar-link" href="/admin/usuarios"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Usuarios</span></a>
            <a class="sidebar-link" href="/admin/perfiles/ACOMPANANTE"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 10 10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5M22 10v7"/></svg><span>Acompañantes</span></a>
            <a class="sidebar-link" href="/admin/perfiles/ADULTO_MAYOR"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/></svg><span>Adultos mayores</span></a>
            <a class="sidebar-link" href="/admin/perfiles/FAMILIAR"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="7" r="3"/><circle cx="17" cy="8" r="2.5"/><path d="M2 21v-3a6 6 0 0 1 12 0v3M15 15a5 5 0 0 1 7 5v1"/></svg><span>Familiares</span></a>
            <a class="sidebar-link" href="/admin/perfiles/SOPORTE"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><rect x="2" y="13" width="4" height="7" rx="2"/><rect x="18" y="13" width="4" height="7" rx="2"/><path d="M20 20c0 2-3 2-6 2"/></svg><span>Soporte</span></a>
            <a class="sidebar-link" href="/admin/perfiles/ADMINISTRADOR"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 22 8-4V6l-8-4-8 4v12z"/><path d="m9 12 2 2 4-4"/></svg><span>Administradores</span></a>
            <a class="sidebar-link" href="/admin/reservas"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></svg><span>Reservas</span></a>
            <a class="sidebar-link" href="/admin/instituciones"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5l8-3 8 3v16M2 21h20M9 21v-5h6v5M8 8h1m6 0h1M8 12h1m6 0h1"/></svg><span>Instituciones</span></a>
            <a class="sidebar-link" href="/admin/promociones"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M4 20 20 4"/></svg><span>Promociones</span></a>
          </>
        ) : (
          <a class="sidebar-link" href="#herramientas"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 7a5 5 0 0 0-6 6L3 18l3 3 5-5a5 5 0 0 0 6-6l-3 3-3-3z"/></svg><span>Herramientas</span></a>
        )}
        <div class="sidebar-foot">● &nbsp; Cuenta protegida de SeniorLink</div>
      </aside>
      <main class="panel-content" id="inicio">
        <div class="panel-intro">
          <div><div class="panel-eyebrow">{adminSection ? 'ADMINISTRACIÓN / ' + sectionName.toUpperCase() : label.toUpperCase() + ' / INICIO'}</div><h1>{adminSection ? sectionName : <>¡Hola, <span id="welcome-name">usuario</span>!</>}</h1><p>{description}</p></div>
          <span class="panel-intro-icon" aria-hidden="true">✦</span>
        </div>
        {!adminSection && <div class="panel-banner">
          <div><div class="banner-kicker">BIENVENIDO A SENIORLINK</div><h2>Tu espacio de {label.toLowerCase()}</h2><p>Tu información, tus herramientas y tus servicios en un solo lugar.</p></div><span aria-hidden="true">✳</span>
        </div>}
        {adminSection && <div class="panel-section-user">Sesión administrativa: <strong id="welcome-name">usuario</strong></div>}
        <div id="panel-error" class="panel-error" role="alert" hidden></div>
        <slot />
        <footer class="panel-footer">SeniorLink · Acompañamiento de confianza</footer>
      </main>
    </div>
  </div>
  <script>
    import { getSession, clearSession, homeForRole, fetchProfile } from '../lib/auth.js';

    const role = document.documentElement.dataset.expectedRole;
    const loading = document.querySelector<HTMLDivElement>('#session-loading');
    const shell = document.querySelector<HTMLDivElement>('#app-shell');
    const welcomeName = document.querySelector<HTMLSpanElement>('#welcome-name');
    const menuToggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const sidebar = document.querySelector<HTMLElement>('#panel-sidebar');
    const layout = document.querySelector<HTMLElement>('.panel-layout');
    const mobileQuery = window.matchMedia('(max-width:700px)');
    const desktopStorageKey = 'seniorlink_sidebar_collapsed';
    const syncMenu = () => {
      const mobile = mobileQuery.matches;
      const expanded = mobile
        ? sidebar?.classList.contains('is-open') === true
        : !layout?.classList.contains('is-collapsed');
      menuToggle?.setAttribute('aria-expanded', String(expanded));
      menuToggle?.setAttribute('aria-label', expanded ? 'Ocultar barra lateral' : 'Mostrar barra lateral');
      const toggleText = menuToggle?.querySelector<HTMLElement>('.menu-toggle-text');
      if (toggleText) toggleText.textContent = expanded ? 'Ocultar barra lateral' : 'Mostrar barra lateral';
    };
    if (!mobileQuery.matches && localStorage.getItem(desktopStorageKey) === 'true') {
      layout?.classList.add('is-collapsed');
    }
    syncMenu();
    menuToggle?.addEventListener('click', () => {
      if (mobileQuery.matches) {
        sidebar?.classList.toggle('is-open');
      } else {
        const collapsed = layout?.classList.toggle('is-collapsed') ?? false;
        localStorage.setItem(desktopStorageKey, String(collapsed));
      }
      syncMenu();
    });
    mobileQuery.addEventListener('change', () => {
      sidebar?.classList.remove('is-open');
      syncMenu();
    });
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    sidebar?.querySelectorAll<HTMLAnchorElement>('a.sidebar-link').forEach(link => {
      const href = link.getAttribute('href');
      link.classList.remove('selected');
      link.removeAttribute('aria-current');
      if (href && href.startsWith('/') && href === currentPath) {
        link.classList.add('selected');
        link.setAttribute('aria-current', 'page');
      }
      link.addEventListener('click', () => {
        if (mobileQuery.matches) {
          sidebar?.classList.remove('is-open');
          syncMenu();
        }
      });
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobileQuery.matches) {
        sidebar?.classList.remove('is-open');
        syncMenu();
      }
    });

    document.querySelector<HTMLButtonElement>('#logout')?.addEventListener('click', () => {
      clearSession();
      window.location.replace('/login');
    });

    async function initialize() {
      const current = getSession();
      if (!current) {
        window.location.replace('/login');
        return;
      }
      if (current.rolNombre !== role) {
        window.location.replace(homeForRole(current.rolNombre));
        return;
      }

      if (!loading || !shell || !welcomeName) return;

      try {
        const data = await fetchProfile(current);
        if (data?.usuario?.dni !== current.dni || data?.usuario?.rolNombre !== role) {
          throw Object.assign(new Error('No tienes autorización para este perfil.'), { status: 403 });
        }

        welcomeName.textContent = data.usuario.nombres?.split(' ')[0] || 'usuario';
        shell.hidden = false;
        loading.hidden = true;
        document.dispatchEvent(new CustomEvent('seniorlink:profile', { detail: data }));
        document.documentElement.dataset.profileReady = 'true';
      } catch (error: unknown) {
        const status = error instanceof Error && 'status' in error
          ? (error as Error & { status: number }).status
          : undefined;

        if (status === 401 || status === 403) {
          clearSession();
          window.location.replace('/login');
          return;
        }

        loading.textContent = 'No se pudo comprobar tu sesión. Revisa la conexión con el backend y vuelve a cargar la página.';
        document.dispatchEvent(new CustomEvent('seniorlink:profile-error', { detail: error }));
      }
    }

    void initialize();
  </script>
</body>
</html>
<style is:global>
  *,*::before,*::after { box-sizing:border-box; }
  .role-app { margin:0; background:#f7faf9; font:14px Lexend,system-ui,sans-serif; color:#15302e; }
  .role-app [hidden] {display:none!important}
  .panel-header {display:flex;align-items:center;justify-content:space-between;height:76px;background:#fff;border-bottom:1px solid #e3eeeb;padding:0 32px;}
  .panel-logo {display:flex;align-items:center;text-decoration:none;color:#182f2d;font-size:23px;font-weight:700;letter-spacing:-.8px;}
  .panel-logo span:last-child {color:#0d9488;}
  .panel-logo-mark {display:inline-flex;align-items:center;justify-content:center;margin-right:10px;width:42px;height:42px;background:#0d9488;border-radius:13px;color:white!important;letter-spacing:0}
  .panel-brand {display:flex;align-items:center;gap:16px;min-width:0}
  .panel-header-actions {display:flex;align-items:center;gap:16px}
  .panel-toolbar{height:48px;display:flex;align-items:center;padding:0 32px;background:#fbfdfc;border-bottom:1px solid #e3eeeb}\n  .panel-menu-toggle{display:inline-flex;align-items:center;gap:9px;border:0;background:transparent;color:#4e7067;border-radius:8px;padding:8px 10px;cursor:pointer;font:600 12px Lexend;transition:background .15s,color .15s}\n  .panel-menu-toggle:hover{background:#e7f7f2;color:#087a70}\n  .panel-toggle-icon{width:18px;height:18px;flex:none}

  .panel-menu-toggle:focus-visible {outline:3px solid #85d8c6;outline-offset:2px}
  .panel-role {color:#087a70;background:#e7f7f2;border-radius:999px;font-size:12px;font-weight:600;padding:9px 13px}
  .panel-logout {background:white;color:#087a70;border:1px solid #cee5dd;border-radius:11px;padding:11px 15px;cursor:pointer;font:600 12px Lexend}
  .panel-logout:hover {background:#effbf7}
  .panel-layout {display:grid;grid-template-columns:230px minmax(0,1fr);min-height:calc(100vh - 124px);transition:grid-template-columns .2s}
  .panel-layout.is-collapsed {grid-template-columns:0 minmax(0,1fr)}
  .panel-layout.is-collapsed .panel-sidebar {visibility:hidden;padding-left:0;padding-right:0;overflow:hidden;border:0}
  .panel-sidebar.is-open {visibility:visible}
  .panel-sidebar {display:flex;flex-direction:column;gap:6px;background:#fff;border-right:1px solid #e3eeeb;padding:32px 15px}
  .sidebar-caption {font-size:11px;color:#9aada9;letter-spacing:2px;font-weight:700;margin:0 15px 12px}
  .sidebar-link {display:flex;align-items:center;gap:12px;text-decoration:none;color:#607773;padding:13px 14px;border-radius:11px;font-weight:500;line-height:1.4;transition:background .16s ease,color .16s ease}
  .sidebar-icon {width:18px;height:18px;flex:0 0 18px;color:#79938c}
  .sidebar-link:hover .sidebar-icon,.sidebar-link.selected .sidebar-icon {color:#087a70}
  .sidebar-link.selected {font-weight:600}
  .sidebar-link:focus-visible {outline:2px solid #0d9488;outline-offset:2px}
  .sidebar-link:hover,.sidebar-link.selected {color:#087a70;background:#e7f7f2}
  .sidebar-foot {font-size:11px;color:#91a6a1;margin-top:auto;padding:18px 10px}
  .panel-section-user {font-size:12px;color:#63867a;margin:12px 0 20px}
  .panel-content {max-width:1450px;min-width:0;width:100%;padding:36px clamp(20px,4vw,60px);margin:0 auto}
  .panel-intro {display:flex;justify-content:space-between;align-items:center;gap:16px}
  .panel-eyebrow {color:#0d9488;font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:9px}
  .panel-intro h1 {font-size:clamp(25px,3vw,33px);letter-spacing:-1px;margin:0}
  .panel-intro p {font-size:13px;color:#80918d;line-height:1.7;margin:10px 0 23px}
  .panel-intro-icon {font-size:24px;color:#0d9488;background:#e5f7f0;border-radius:13px;padding:14px}
  .panel-banner {border-radius:18px;background:linear-gradient(105deg,#0b8177,#0d9488);min-height:164px;color:white;padding:29px 32px;display:flex;justify-content:space-between;align-items:center}
  .banner-kicker {font-size:10px;opacity:.82;letter-spacing:1.6px;font-weight:700}
  .panel-banner h2 {font-size:24px;margin:14px 0 8px}
  .panel-banner p {font-size:12px;opacity:.86;line-height:1.6;margin:0}
  .panel-banner>span {font-size:95px;line-height:1;opacity:.17}
  .dashboard-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin:24px 0 32px}
  .dashboard-card,.profile-box,.section-box {border:1px solid #e2ece8;border-radius:17px;background:white;padding:24px;box-shadow:0 5px 18px #145e530a}
  .dashboard-card {min-height:162px}
  .card-symbol {display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;color:#0d9488;background:#eaf8f3;font-size:23px;margin-bottom:18px}
  .dashboard-card h3 {font-size:15px;margin:0 0 8px}
  .dashboard-card p {font-size:12px;line-height:1.7;color:#819490;margin:0}
  .section-heading {display:flex;align-items:center;justify-content:space-between;margin:24px 0 16px;gap:10px}
  .section-heading h2 {font-size:19px;margin:0}
  .section-heading small {color:#8c9e99;font-size:11px}
  .profile-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:19px}
  .profile-key {font-size:12px;color:#859a94;margin-bottom:6px}
  .profile-value {font-size:14px;font-weight:600;overflow-wrap:anywhere}
  .profile-note {font-size:12px;line-height:1.6;color:#80948d;margin:20px 0 0}
  .panel-footer {text-align:center;color:#94a6a1;font-size:11px;padding:30px 0}
  .panel-error {padding:16px;border-radius:11px;background:#fff4f4;color:#a83535;margin:20px 0}
  .staff-input {border:1px solid #d6e7df;background:white;border-radius:10px;padding:11px;width:100%;font:inherit}
  .staff-input:focus {outline:2px solid #b0e5da}
  .staff-label {display:block;color:#547168;font-size:12px;font-weight:600;margin:0 0 7px}
  .staff-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .staff-btn {font:600 13px Lexend;cursor:pointer;border:0;border-radius:11px;background:#0d9488;color:white;padding:13px 20px}
  .staff-btn:hover {background:#0f766e}
  .staff-btn:disabled {opacity:.6;cursor:wait}
  .staff-message {margin:14px 0 0;font-size:12px;color:#087a70}
  .staff-message.error {color:#b33939}
  @media(max-width:1000px){.dashboard-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel-layout{grid-template-columns:180px 1fr}}
  @media(max-width:700px){
    .panel-layout,.panel-layout.is-collapsed{display:block}
    .panel-sidebar,.panel-layout.is-collapsed .panel-sidebar{position:fixed;z-index:40;top:116px;left:0;bottom:0;width:min(300px,86vw);overflow-y:auto;box-shadow:12px 0 30px #183a3022;transform:translateX(-105%);transition:transform .2s ease;padding:20px 15px;visibility:hidden}
    .panel-sidebar.is-open,.panel-layout.is-collapsed .panel-sidebar.is-open{visibility:visible;transform:translateX(0);display:flex;flex-direction:column}
    .panel-layout.is-collapsed .panel-sidebar:not(.is-open){visibility:hidden}
    .sidebar-caption,.sidebar-foot{display:block}
    .sidebar-link{white-space:normal}
    .panel-header{padding:0 15px;height:68px}
    .panel-logo{font-size:19px}
    .panel-logo-mark{width:36px;height:36px}
    .panel-role{display:none}\n    .panel-toolbar{height:48px;padding:0 15px}\n    .panel-menu-toggle{font-size:11px}
    .panel-content{padding:23px 15px}
    .panel-banner>span,.panel-intro-icon{display:none}
    .panel-banner{padding:24px}
    .panel-banner h2{font-size:20px}
    .dashboard-grid,.profile-grid,.staff-grid{grid-template-columns:1fr}
  }
  .panel-logo{display:inline-flex;align-items:center;flex-shrink:0;min-width:0;text-decoration:none}
  .panel-brand-image{display:block;width:auto;height:64px;max-width:min(280px,50vw);object-fit:contain;object-position:left center}
  @media(max-width:600px){.panel-brand-image{height:48px;max-width:48vw}}
</style>