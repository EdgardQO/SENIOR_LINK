---
import RoleLayout from '../layouts/RoleLayout.astro';
---
<RoleLayout role="ADULTO_MAYOR" label="Adulto mayor" description="Un espacio claro para consultar tus datos y organizar tu acompañamiento.">
  <section id="herramientas" class="dashboard-grid" aria-label="Herramientas del perfil">
    <article class="dashboard-card"><span class="card-symbol" aria-hidden="true">◯</span><h3>Mis datos</h3><p>Revisa tu información de contacto y residencia.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">☎</span><h3>Emergencias</h3><p>Ten disponible la información de tu contacto de emergencia.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">♡</span><h3>Acompañamiento</h3><p>La contratación de acompañantes estará disponible próximamente.</p></article>
  </section>
  <section id="mi-perfil">
    <div class="section-heading"><h2>Mi información</h2><small>Datos de tu cuenta</small></div>
    <div class="profile-box">
      <div class="profile-grid">
        <div><div class="profile-key">Nombre completo</div><div class="profile-value" data-field="usuario.nombreCompleto">Cargando...</div></div>
        <div><div class="profile-key">Correo electrónico</div><div class="profile-value" data-field="usuario.correoElectronico">Cargando...</div></div>
        <div><div class="profile-key">DNI</div><div class="profile-value" data-field="usuario.dni">Cargando...</div></div>
        <div><div class="profile-key">Teléfono</div><div class="profile-value" data-field="usuario.telefono">Cargando...</div></div>
        <div><div class="profile-key">Fecha de nacimiento</div><div class="profile-value" data-field="adultoMayor.fechaNacimiento">Cargando...</div></div>
<div><div class="profile-key">Dirección</div><div class="profile-value" data-field="adultoMayor.direccionResidencia">Cargando...</div></div>
<div><div class="profile-key">Contacto de emergencia</div><div class="profile-value" data-field="adultoMayor.contactoEmergencia">Cargando...</div></div>
<div><div class="profile-key">Teléfono de emergencia</div><div class="profile-value" data-field="adultoMayor.telefonoEmergencia">Cargando...</div></div>
      </div>
      <p class="profile-note">Esta información proviene de tu perfil registrado en SeniorLink.</p>
    </div>
  </section>
  
</RoleLayout>
<script>
  import { renderProfileFields } from '../lib/profile-fields';
  document.addEventListener('seniorlink:profile', (event: Event) => {
    renderProfileFields((event as CustomEvent).detail);
  }, { once: true });
</script>