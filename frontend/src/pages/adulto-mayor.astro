---
import RoleLayout from '../layouts/RoleLayout.astro';
---
<RoleLayout role="ADULTO_MAYOR" label="Adulto mayor" description="Organiza tu acompañamiento y consulta el estado de tus servicios.">
 <section class="adult-home">
  <div class="section-heading"><h2>Resumen de tus reservas</h2></div>
  <div class="dashboard-grid">
   <article class="dashboard-card"><h3>Solicitudes pendientes</h3><strong id="adult-pendientes">—</strong></article>
   <article class="dashboard-card"><h3>Servicios activos</h3><strong id="adult-activas">—</strong></article>
   <article class="dashboard-card"><h3>Servicios completados</h3><strong id="adult-completadas">—</strong></article>
  </div>
  <p id="adult-resumen-status" role="status"></p>
  <div class="section-heading"><h2>Accesos directos</h2></div>
  <div class="dashboard-grid">
   <article class="dashboard-card"><h3>Encontrar acompañante</h3><p>Consulta perfiles y opiniones.</p><a href="/adulto-mayor/acompanantes">Ver catálogo</a></article>
   <article class="dashboard-card"><h3>Mis reservas</h3><p>Consulta y administra tus solicitudes.</p><a href="/adulto-mayor/reservas">Ver reservas</a></article>
   <article class="dashboard-card"><h3>Mi perfil</h3><p>Revisa tus datos personales y fotografía.</p><a href="/adulto-mayor/mi-perfil">Consultar perfil</a></article>
   <article class="dashboard-card"><h3>Mis incidencias</h3><p>Solicita ayuda y revisa las respuestas de soporte.</p><a href="/adulto-mayor/incidencias">Solicitar ayuda</a></article>
   <article class="dashboard-card"><h3>Familiares</h3><p>Consulta y administra tus vinculaciones familiares.</p><a href="/adulto-mayor/vinculaciones">Ver familiares</a></article>
  </div>
 </section>
</RoleLayout>
<style>
.adult-home .dashboard-card strong{display:block;color:#087a70;font-size:2rem;margin-top:12px}.adult-home a{display:inline-block;color:#087a70;font-weight:600;margin-top:12px;text-decoration:underline;text-underline-offset:3px}.adult-home a:focus-visible{outline:2px solid #087a70;outline-offset:3px}
</style>
<script>
 import {apiLocal} from '../lib/local-api';
 async function resumen(){
  try{
   const reservas=await apiLocal('/reservas');
   const contar=(estados:string[])=>reservas.filter((r:any)=>estados.includes(r.estado)).length;
   document.querySelector('#adult-pendientes')!.textContent=String(contar(['PENDIENTE_ACEPTACION','PENDIENTE_PAGO']));
   document.querySelector('#adult-activas')!.textContent=String(contar(['CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION','EN_DISPUTA']));
   document.querySelector('#adult-completadas')!.textContent=String(contar(['COMPLETADA']));
  }catch{document.querySelector('#adult-resumen-status')!.textContent='No se pudo consultar el resumen de reservas.';}
 }
 document.addEventListener('seniorlink:profile',()=>void resumen(),{once:true});
 const hash=window.location.hash;
 if(hash==='#mi-perfil')window.location.replace('/adulto-mayor/mi-perfil');
 if(hash==='#herramientas')window.history.replaceState(null,'','/adulto-mayor');
</script>
