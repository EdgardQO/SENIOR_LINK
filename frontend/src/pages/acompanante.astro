---
import RoleLayout from '../layouts/RoleLayout.astro';
---
<RoleLayout role="ACOMPANANTE" label="Acompañante" description="Consulta tu perfil de estudiante y tus servicios de acompañamiento.">
  <section id="herramientas" class="dashboard-grid" aria-label="Herramientas del perfil">
    <article class="dashboard-card"><span class="card-symbol" aria-hidden="true">✦</span><h3>Mi perfil profesional</h3><p>Consulta tu carrera, ciclo y centro de estudios.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">S/</span><h3>Tarifa por hora</h3><p>Revisa la tarifa registrada en tu perfil.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">▤</span><h3>Próximos servicios</h3><p>La agenda de servicios individuales estará disponible próximamente.</p></article>
  </section>
  <section id="mi-perfil">
    <div class="section-heading"><h2>Mi información</h2><small>Datos de tu cuenta</small></div>
    <div class="profile-box">
      <div class="profile-grid">
        <div><div class="profile-key">Nombre completo</div><div class="profile-value" data-field="usuario.nombreCompleto">Cargando...</div></div>
        <div><div class="profile-key">Correo electrónico</div><div class="profile-value" data-field="usuario.correoElectronico">Cargando...</div></div>
        <div><div class="profile-key">DNI</div><div class="profile-value" data-field="usuario.dni">Cargando...</div></div>
        <div><div class="profile-key">Teléfono</div><div class="profile-value" data-field="usuario.telefono">Cargando...</div></div>
        <div><div class="profile-key">Carrera</div><div class="profile-value" data-field="acompanante.carrera">Cargando...</div></div>
<div><div class="profile-key">Ciclo académico</div><div class="profile-value" data-field="acompanante.ciclo">Cargando...</div></div>
<div><div class="profile-key">Institución aliada</div><div class="profile-value" data-field="acompanante.institucionAliada.nombre">Cargando...</div></div>
<div><div class="profile-key">Tarifa base por hora</div><div class="profile-value" data-field="acompanante.tarifaBasePorHora">Cargando...</div></div>
      </div>
      <p class="profile-note">Esta información proviene de tu perfil registrado en SeniorLink.</p>
    </div>
  </section>
  
</RoleLayout>
<script>
  import { renderProfileFields } from '../lib/profile-fields';
  document.addEventListener('seniorlink:profile', (event: Event) => {
    renderProfileFields((event as CustomEvent).detail);
  }, { once: true });
</script>