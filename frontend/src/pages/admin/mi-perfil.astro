---
import RoleLayout from '../../layouts/RoleLayout.astro';
---
<RoleLayout role="ADMINISTRADOR" label="Administración" description="Consulta la información de tu cuenta administrativa.">
  <section class="profile-box" aria-labelledby="own-profile-title">
    <h2 id="own-profile-title">Mi perfil de administrador</h2>
    <p class="profile-note">Información de tu cuenta y de tu perfil administrativo.</p>
    <div class="own-profile-sections" id="own-profile-fields"></div>
    <p id="own-profile-status" class="profile-note" role="status">Cargando tu información...</p>
  </section>
</RoleLayout>
<style is:global>
#own-profile-fields.own-profile-sections{display:flex;flex-direction:column;gap:22px;margin-top:24px;width:100%}
#own-profile-fields .own-profile-section{min-width:0;overflow:hidden;border:1px solid #dceae5;border-radius:14px;background:#fff;box-shadow:0 4px 16px rgba(21,67,55,.05)}
#own-profile-fields .own-profile-section h3{font-size:15px;color:#087a70;margin:0;padding:17px 22px;background:#eff9f5;border-bottom:1px solid #dceae5;font-weight:700}
#own-profile-fields .own-profile-grid{display:flex!important;flex-direction:column!important;width:100%;gap:0!important}
#own-profile-fields .own-profile-field{display:grid!important;grid-template-columns:minmax(160px,34%) minmax(0,1fr)!important;align-items:center;min-height:60px;min-width:0;border-bottom:1px solid #edf2f0;overflow-wrap:anywhere;background:#fff}
#own-profile-fields .own-profile-field:nth-child(even){background:#fbfdfc}
#own-profile-fields .own-profile-field:last-child{border-bottom:0}
#own-profile-fields .own-profile-field .profile-key{display:block;margin:0;padding:16px 20px;font-size:12px;color:#607b73;font-weight:600;border-right:1px solid #edf2f0;height:100%;align-content:center}
#own-profile-fields .own-profile-field .profile-value{display:block;margin:0;padding:16px 22px;font-size:13px;line-height:1.5;color:#183d35;font-weight:650;overflow-wrap:anywhere}
@media(max-width:700px){
#own-profile-fields .own-profile-section h3{padding:15px}
#own-profile-fields .own-profile-field{grid-template-columns:minmax(110px,40%) minmax(0,1fr)!important}
#own-profile-fields .own-profile-field .profile-key{padding:14px 12px;font-size:11px}
#own-profile-fields .own-profile-field .profile-value{padding:14px 12px;font-size:12px}
}
</style>
<script>
  type Profile = Record<string, unknown>;
  const labels: Record<string,string> = {
    dni:'DNI', nombres:'Nombres', apellidos:'Apellidos',
    correoElectronico:'Correo electrónico', telefono:'Teléfono',
    rolNombre:'Rol', estaActivo:'Estado de la cuenta',
    creadoEn:'Fecha de registro', actualizadoEn:'Última actualización',
    areaODepartamento:'Área o departamento', nivelAcceso:'Nivel de acceso'
  };
  const format = (value: unknown, key: string): string => {
    if (value === null || value === undefined || value === '') return 'No registrado';
    if (key === 'estaActivo') return value ? 'Activo' : 'Inactivo';
    if (key === 'creadoEn' || key === 'actualizadoEn') {
      const date = new Date(String(value));
      return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString('es-PE');
    }
    return String(value);
  };
  function renderProfile(event: Event) {
    const detail = (event as CustomEvent).detail as {usuario?:Profile;admin?:Profile};
    const grid = document.querySelector<HTMLElement>('#own-profile-fields');
    const status = document.querySelector<HTMLElement>('#own-profile-status');
    if (!grid || !status || !detail?.usuario) return;
    grid.replaceChildren();
    const sections: Array<[string,Profile,Array<[string,string]>]> = [
      ['Datos personales',detail.usuario,[
        ['nombres','Nombres'],['apellidos','Apellidos'],['dni','DNI'],
        ['correoElectronico','Correo electrónico'],['telefono','Teléfono']]],
      ['Información de la cuenta',detail.usuario,[
        ['rolNombre','Rol'],['estaActivo','Estado de la cuenta'],
        ['creadoEn','Fecha de registro'],['actualizadoEn','Última actualización']]],
      ['Perfil administrativo',detail.admin || {},[
        ['areaODepartamento','Área o departamento'],['nivelAcceso','Nivel de acceso']]]
    ];
    for (const [heading,values,fields] of sections) {
      const block=document.createElement('section');
      block.className='own-profile-section';
      const title=document.createElement('h3');
      title.textContent=heading;
      const fieldGrid=document.createElement('div');
      fieldGrid.className='own-profile-grid';
      for(const [key,labelText] of fields) {
        const item=document.createElement('div');
        item.className='own-profile-field';
        const label=document.createElement('div');
        label.className='profile-key';
        label.textContent=labelText;
        const text=document.createElement('div');
        text.className='profile-value';
        text.textContent=format(values[key],key);
        item.append(label,text);
        fieldGrid.appendChild(item);
      }
      block.append(title,fieldGrid);
      grid.appendChild(block);
    }
    status.textContent = detail.admin ? '' : 'No se encontraron datos adicionales del perfil administrativo.';
  }
  document.addEventListener('seniorlink:profile',renderProfile);
  document.addEventListener('seniorlink:profile-error',()=>{
    const status = document.querySelector<HTMLElement>('#own-profile-status');
    if (status) status.textContent='No se pudo cargar el perfil.';
  });
</script>
