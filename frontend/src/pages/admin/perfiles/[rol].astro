---
import RoleLayout from '../../../layouts/RoleLayout.astro';
export function getStaticPaths() {
  return ['ADMINISTRADOR','ACOMPANANTE','ADULTO_MAYOR','SOPORTE','FAMILIAR'].map(rol => ({ params: { rol } }));
}
const rol = Astro.params.rol!;
const labels: Record<string,string> = {ADMINISTRADOR:'Administradores',ACOMPANANTE:'Acompañantes',ADULTO_MAYOR:'Adultos mayores',SOPORTE:'Soporte',FAMILIAR:'Familiares'};
---
<RoleLayout role="ADMINISTRADOR" label="Administración" description="Gestión específica de perfiles y cuentas por rol.">
  
  <section class="admin-shell" data-admin-module="usuarios" data-role-filter={rol}>
    <h2 style="margin:0 0 10px">Perfiles: {labels[rol]}</h2>
    <p class="admin-note">Consulta los usuarios de este rol. Selecciona «Ver perfil» para abrir su ficha completa con datos generales y específicos.</p>
    <div id="module-content"></div>
    <p id="module-message" class="admin-message" role="status" aria-live="polite"></p>
  </section>
</RoleLayout>
<style is:global>
.admin-shell{background:#fff;border:1px solid #e2ece8;border-radius:17px;padding:22px;margin-top:22px}
.admin-links{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}
.admin-links a{border:1px solid #d5e9e2;color:#087a70;border-radius:10px;padding:10px 13px;text-decoration:none;font-size:12px}
.admin-links a:hover{background:#e9f8f3}
.admin-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.admin-form label{font-size:12px;color:#56756c;font-weight:600}
.admin-form input,.admin-form select,.admin-form textarea,.admin-filter{width:100%;display:block;border:1px solid #d7e9e2;border-radius:10px;padding:11px;margin-top:7px;font:inherit;background:#fff}
.admin-form input:focus,.admin-form select:focus,.admin-filter:focus{outline:2px solid #a9ded0}
.admin-form [hidden]{display:none!important}
.admin-table-wrap{width:100%;overflow-x:auto;overscroll-behavior-x:contain;padding-bottom:8px}
.admin-table{min-width:1050px}
.admin-table th,.admin-table td{vertical-align:middle}
.admin-table th:last-child,.admin-table td:last-child{min-width:156px}
.admin-actions-cell{width:156px;min-width:156px}
.admin-actions-group{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:stretch}
.admin-actions-group .admin-btn{margin:0!important;white-space:nowrap;width:100%;padding:10px 9px;min-height:36px;text-align:center;font-size:11px}
.admin-actions-group .admin-btn:first-child{grid-column:1/-1}
.admin-actions-group .admin-btn:last-child{grid-column:2}
.admin-actions-group .admin-btn:nth-child(2){grid-column:1}
.admin-actions-group .admin-btn:focus-visible{outline:2px solid #087a70;outline-offset:2px}
.admin-table{width:100%;border-collapse:collapse;text-align:left}
.admin-table th{padding:12px;font-size:11px;color:#738b83;border-bottom:1px solid #e2ece8}
.admin-table td{padding:12px;border-bottom:1px solid #e8f1ed;font-size:12px}
/* Filas alternadas estilo Excel: contraste suave y lectura clara. */
.admin-table tbody tr:nth-child(odd){background-color:#ffffff}
.admin-table tbody tr:nth-child(even){background-color:#eef8f4}
.admin-table tbody tr{transition:background-color .16s ease}
.admin-table tbody tr:hover{background-color:#ddf1e9}
.admin-table tbody tr:focus-within{background-color:#e3f4ed}
.admin-table tbody td{background-color:transparent}

.admin-btn{border:0;border-radius:10px;background:#0d9488;color:white;padding:11px 16px;cursor:pointer;font:600 12px Lexend}
.admin-btn:disabled{opacity:.6}
.admin-secondary{background:#edf8f4;color:#087a70}
.admin-danger{background:#fff0f0;color:#ae3333}
.admin-note{color:#708b81;font-size:12px;line-height:1.7}
.admin-message{font-size:12px;margin-top:13px;color:#087a70}
.admin-message.error{color:#b42336}
.admin-profile-detail{margin:20px 0;padding:24px;border:1px solid #cce9df;border-radius:18px;background:#f9fdfb;box-shadow:0 8px 25px #15302e0b}
.admin-profile-header{display:flex;justify-content:space-between;align-items:start;gap:16px;flex-wrap:wrap}
.admin-profile-header h3{font-size:22px;margin:6px 0 4px;color:#15302e}
.admin-profile-eyebrow{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#087a70;font-weight:700}
.admin-profile-section{background:#fff;border:1px solid #e2ece8;border-radius:14px;padding:20px;margin-top:18px}
.admin-profile-section h4{font-size:15px;margin:0 0 18px;color:#087a70}
.admin-profile-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 18px}
.admin-profile-field{min-width:0;display:flex;flex-direction:column;gap:6px;overflow-wrap:anywhere}
.admin-profile-label{font-size:11px;color:#708b81}
.admin-profile-field strong{font-size:13px;font-weight:600;color:#15302e;white-space:pre-wrap}
@media(max-width:900px){.admin-profile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.admin-form,.admin-profile-grid{grid-template-columns:1fr}.admin-profile-detail{padding:14px}.admin-profile-section{padding:15px}}
</style>
<script>
  import { initAdminModule } from '../../../lib/admin-console';
  const initializeModule = () => {
    const root = document.querySelector<HTMLElement>('[data-admin-module]');
    if (root) void initAdminModule(root);
  };
  if (document.documentElement.dataset.profileReady === 'true') initializeModule();
  else document.addEventListener('seniorlink:profile', initializeModule, { once: true });
</script>