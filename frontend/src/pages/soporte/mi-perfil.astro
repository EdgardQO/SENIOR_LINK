---
import RoleLayout from '../../layouts/RoleLayout.astro';
---
<RoleLayout role="SOPORTE" label="Soporte" description="Consulta tus datos personales y tu información de trabajo.">
 <section id="mi-perfil">
    <div class="section-heading"><h2>Mi información</h2><small>Datos de tu cuenta</small></div>
    <div class="profile-box">
      <div class="profile-grid">
        <div><div class="profile-key">Nombre completo</div><div class="profile-value" data-field="usuario.nombreCompleto">Cargando...</div></div>
        <div><div class="profile-key">Correo electrónico</div><div class="profile-value" data-field="usuario.correoElectronico">Cargando...</div></div>
        <div><div class="profile-key">DNI</div><div class="profile-value" data-field="usuario.dni">Cargando...</div></div>
        <div><div class="profile-key">Teléfono</div><div class="profile-value" data-field="usuario.telefono">Cargando...</div></div>
        <div><div class="profile-key">Turno</div><div class="profile-value" data-field="soporte.turno">Cargando...</div></div>
<div><div class="profile-key">Extensión telefónica</div><div class="profile-value" data-field="soporte.extensionTelefonica">Cargando...</div></div>
<div><div class="profile-key">Casos atendidos</div><div class="profile-value" data-field="soporte.casosAtendidos">Cargando...</div></div>
      </div>
      <div class="support-profile-actions"><button type="button" id="support-foto-editar">Actualizar fotografía</button><a href="/soporte/incidencias">Gestionar incidencias</a></div>
      <p class="profile-note">Esta información proviene de tu perfil registrado en SeniorLink.</p>
    </div>
  </section>
</RoleLayout>
<style>
.support-profile-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:20px}
.support-profile-actions button,.support-profile-actions a{display:inline-block;background:#087a70;color:white;border:0;border-radius:9px;padding:12px 16px;font:inherit;cursor:pointer;text-decoration:none}
.support-profile-actions a{background:#e3f1eb;color:#087a70}
.support-profile-actions button:focus-visible,.support-profile-actions a:focus-visible{outline:2px solid #087a70;outline-offset:3px}
</style>
<script>
 import {renderProfileFields} from '../../lib/profile-fields';
 document.addEventListener('seniorlink:profile',(event:Event)=>renderProfileFields((event as CustomEvent).detail));
 document.querySelector('#support-foto-editar')?.addEventListener('click',()=>document.querySelector<HTMLButtonElement>('#photo-profile-trigger')?.click());
</script>
