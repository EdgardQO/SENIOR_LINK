---
import RoleLayout from '../layouts/RoleLayout.astro';
---
<RoleLayout role="ADMINISTRADOR" label="Administración" description="Administra usuarios, personal interno y las cuentas de la plataforma.">
  <section id="herramientas" class="dashboard-grid" aria-label="Herramientas del perfil">
    <article class="dashboard-card"><span class="card-symbol" aria-hidden="true">♙</span><h3>Usuarios del sistema</h3><p>Consulta las cuentas registradas y su estado.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">✚</span><h3>Personal interno</h3><p>Registra administradores y agentes de soporte.</p></article>
<article class="dashboard-card"><span class="card-symbol" aria-hidden="true">✓</span><h3>Gestión segura</h3><p>Las operaciones administrativas requieren autorización.</p></article>
  </section>
  <section id="mi-perfil">
    <div class="section-heading"><h2>Mi información</h2><small>Datos de tu cuenta</small></div>
    <div class="profile-box">
      <div class="profile-grid">
        <div><div class="profile-key">Nombre completo</div><div class="profile-value" data-field="usuario.nombreCompleto">Cargando...</div></div>
        <div><div class="profile-key">Correo electrónico</div><div class="profile-value" data-field="usuario.correoElectronico">Cargando...</div></div>
        <div><div class="profile-key">DNI</div><div class="profile-value" data-field="usuario.dni">Cargando...</div></div>
        <div><div class="profile-key">Teléfono</div><div class="profile-value" data-field="usuario.telefono">Cargando...</div></div>
        <div><div class="profile-key">Área o departamento</div><div class="profile-value" data-field="admin.areaODepartamento">Cargando...</div></div>
<div><div class="profile-key">Nivel de acceso</div><div class="profile-value" data-field="admin.nivelAcceso">Cargando...</div></div>
      </div>
      <p class="profile-note">Esta información proviene de tu perfil registrado en SeniorLink.</p>
    </div>
  </section>
  <section id="gestion-usuarios">
  <div class="section-heading"><h2>Usuarios registrados</h2><small>Solo administradores</small></div>
  <div class="section-box">
    <p id="users-summary" class="profile-note" style="margin:0 0 12px">Cargando usuarios...</p>
    <div style="overflow:auto"><table id="users-table" style="border-collapse:collapse;width:100%;text-align:left" hidden><thead><tr><th style="padding:10px">Nombre</th><th style="padding:10px">Correo</th><th style="padding:10px">Rol</th><th style="padding:10px">Estado</th></tr></thead><tbody id="users-body"></tbody></table></div>
  </div>
</section>
<section id="crear-personal">
  <div class="section-heading"><h2>Crear personal interno</h2><small>Administración y soporte</small></div>
  <div class="section-box">
    <form id="staff-form">
      <div class="staff-grid">
        <div><label class="staff-label" for="staff-role">Rol</label><select id="staff-role" class="staff-input" required><option value="SOPORTE">Soporte</option><option value="ADMINISTRADOR">Administrador</option></select></div>
        <div><label class="staff-label" for="staff-dni">DNI</label><input id="staff-dni" class="staff-input" maxlength="8" pattern="[0-9]{8}" required /></div>
        <div><label class="staff-label" for="staff-name">Nombres</label><input id="staff-name" class="staff-input" maxlength="100" required /></div>
        <div><label class="staff-label" for="staff-surname">Apellidos</label><input id="staff-surname" class="staff-input" maxlength="100" required /></div>
        <div><label class="staff-label" for="staff-email">Correo electrónico</label><input id="staff-email" class="staff-input" type="email" maxlength="150" required /></div>
        <div><label class="staff-label" for="staff-phone">Teléfono (opcional)</label><input id="staff-phone" class="staff-input" maxlength="20" /></div>
        <div><label class="staff-label" for="staff-pass">Contraseña inicial</label><input id="staff-pass" class="staff-input" type="password" minlength="8" maxlength="72" autocomplete="new-password" required /></div>
      </div>
      <div id="support-fields" class="staff-grid" style="margin-top:15px">
        <div><label class="staff-label" for="staff-shift">Turno</label><select id="staff-shift" class="staff-input"><option>Mañana</option><option>Tarde</option><option>Noche</option></select></div>
        <div><label class="staff-label" for="staff-ext">Extensión (opcional)</label><input id="staff-ext" class="staff-input" maxlength="20" /></div>
      </div>
      <div id="admin-fields" class="staff-grid" style="margin-top:15px" hidden>
        <div><label class="staff-label" for="staff-area">Área o departamento</label><input id="staff-area" class="staff-input" maxlength="100" /></div>
        <div><label class="staff-label" for="staff-access">Nivel de acceso</label><input id="staff-access" class="staff-input" type="number" min="1" max="32767" value="1" /></div>
      </div>
      <button id="staff-submit" class="staff-btn" type="submit" style="margin-top:20px">Crear cuenta</button>
      <p id="staff-message" class="staff-message" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
</RoleLayout>
<script>
  document.addEventListener('seniorlink:profile', event => {
    const data = event.detail;
    document.querySelectorAll('[data-field]').forEach(field => {
      const path = field.dataset.field;
      let value = path === 'usuario.nombreCompleto'
        ? [data.usuario?.nombres, data.usuario?.apellidos].filter(Boolean).join(' ')
        : path.split('.').reduce((current, key) => current?.[key], data);
      if (path === 'acompanante.tarifaBasePorHora' && value != null) value = 'S/ ' + Number(value).toFixed(2);
      field.textContent = value == null || String(value).trim() === '' ? 'No registrado' : String(value);
    });
  }, { once: true });
  
  import { getSession, clearSession, API_URL } from '../lib/auth.js';
  const session = getSession();
  const el = id => document.getElementById(id);
  const val = id => el(id).value.trim();
  const roleSelector = el('staff-role');
  const sync = () => {
    const support = roleSelector.value === 'SOPORTE';
    el('support-fields').hidden = !support;
    el('admin-fields').hidden = support;
    el('staff-shift').required = support;
    el('staff-area').required = !support;
  };
  roleSelector.addEventListener('change', sync);
  sync();
  async function loadUsers() {
    if (!session || session.rolNombre !== 'ADMINISTRADOR') return;
    const status = el('users-summary');
    try {
      const res = await fetch(API_URL + '/api/v1/usuarios', { headers: { Authorization: 'Bearer ' + session.accessToken } });
      if (res.status === 401 || res.status === 403) throw Object.assign(new Error('No autorizado'), { status: res.status });
      if (!res.ok) throw new Error('No se pudieron consultar los usuarios.');
      const users = await res.json();
      if (!Array.isArray(users)) throw new Error('Respuesta inválida.');
      el('users-body').replaceChildren();
      for (const user of users) {
        const tr = document.createElement('tr');
        for (const value of [user.nombres + ' ' + user.apellidos, user.correoElectronico, user.rolNombre, user.estaActivo ? 'Activo' : 'Inactivo']) {
          const td = document.createElement('td');
          td.textContent = value || '—';
          td.style.padding = '10px';
          td.style.borderTop = '1px solid #e2ece8';
          tr.appendChild(td);
        }
        el('users-body').appendChild(tr);
      }
      el('users-table').hidden = false;
      status.textContent = users.length + ' usuario(s) registrados.';
    } catch (error) {
      status.textContent = error.message || 'Error de conexión.';
      if (error.status === 401 || error.status === 403) { clearSession(); location.replace('/login'); }
    }
  }
  document.addEventListener('seniorlink:profile', loadUsers, { once: true });
  el('staff-form').addEventListener('submit', async event => {
    event.preventDefault();
    const current = getSession();
    if (!current || current.rolNombre !== 'ADMINISTRADOR') return;
    const body = {
      dni: val('staff-dni'),
      nombres: val('staff-name'),
      apellidos: val('staff-surname'),
      correoElectronico: val('staff-email'),
      contrasena: el('staff-pass').value,
      telefono: val('staff-phone') || null,
      rol: roleSelector.value
    };
    if (body.rol === 'SOPORTE') {
      body.turno = val('staff-shift');
      body.extensionTelefonica = val('staff-ext') || null;
    } else {
      body.areaODepartamento = val('staff-area');
      body.nivelAcceso = Number(val('staff-access'));
    }
    const button = el('staff-submit');
    const msg = el('staff-message');
    msg.textContent = '';
    msg.classList.remove('error');
    button.disabled = true;
    button.textContent = 'Creando...';
    try {
      const res = await fetch(API_URL + '/api/v1/admin/personal', {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + current.accessToken, 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw Object.assign(new Error(res.status === 409 ? 'El DNI o correo ya existen.' : result.detail || result.error || result.message || 'No se pudo crear la cuenta.'), { status: res.status });
      }
      msg.textContent = 'Cuenta creada correctamente.';
      event.currentTarget.reset();
      sync();
      loadUsers();
    } catch (error) {
      msg.textContent = error.message || 'Error de conexión.';
      msg.classList.add('error');
      if (error.status === 401 || error.status === 403) { clearSession(); location.replace('/login'); }
    } finally {
      button.disabled = false;
      button.textContent = 'Crear cuenta';
    }
  });
</script>