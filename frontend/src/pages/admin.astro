---
import RoleLayout from '../layouts/RoleLayout.astro';
---
<RoleLayout role="ADMINISTRADOR" label="Administración" description="Métricas, indicadores y gestión integral de SeniorLink.">
  <div class="section-heading"><h2>Resumen general</h2><small>Datos del sistema · PostgreSQL</small></div>
  <section class="admin-overview" aria-label="Indicadores generales">
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2"/><circle cx="18" cy="8" r="2.3"/><path d="M17 14a5 5 0 0 1 4 5v1"/></svg><strong id="m-users">—</strong><span>Usuarios registrados</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 3.5h8M8 8h8M8 12h3m2 3 2 2 4-4"/></svg><strong id="m-reservations">—</strong><span>Reservas totales</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg><strong id="m-active">—</strong><span>Usuarios activos</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="6" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3M8 12l-2 3m10-3 2 3"/></svg><strong id="m-elders">—</strong><span>Adultos mayores</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></svg><strong id="m-completed">—</strong><span>Reservas completadas</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5l8-3 8 3v16M2 21h20M9 21v-5h6v5M8 8h1m6 0h1M8 12h1m6 0h1"/></svg><strong id="m-institutions">—</strong><span>Instituciones aliadas</span></article>
    <article class="overview-card"><svg class="overview-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M4 20 20 4"/></svg><strong id="m-promotions">—</strong><span>Promociones activas</span></article>
  </section>
  <section class="admin-chart-grid" aria-label="Gráficos de reservas">
    <article class="chart-panel">
      <div class="chart-heading"><h2>Reservas por mes</h2><span id="monthly-caption">Últimos 6 meses</span></div>
      <div class="month-chart" id="monthly-chart" role="img" aria-label="Reservas registradas por mes">Cargando datos...</div>
    </article>
    <article class="chart-panel">
      <div class="chart-heading"><h2>Estado de reservas</h2><span id="states-caption">Distribución actual</span></div>
      <div class="state-chart">
        <div class="donut" id="reservation-donut"><div class="donut-center"><strong id="donut-total">—</strong><span>Reservas</span></div></div>
        <div class="state-legend" id="reservation-legend">Cargando datos...</div>
      </div>
    </article>
  </section>
  <div class="section-heading"><h2>Distribución de usuarios por rol</h2></div>
  <p class="profile-note">Acompañantes, adultos mayores y familiares; no incluye personal interno.</p>
  <div class="profile-box"><div id="roles-graph" class="roles-graph"></div></div>
  <div class="section-heading"><h2>Módulos administrativos</h2></div>
  <div class="dashboard-grid">
    <a href="/admin/usuarios" class="dashboard-card" style="text-decoration:none;color:inherit"><span class="card-symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 6a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v2"/></svg></span><h3>Usuarios y perfiles</h3><p>Consultar, registrar, editar y desactivar cuentas.</p></a>
    <a href="/admin/reservas" class="dashboard-card" style="text-decoration:none;color:inherit"><span class="card-symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m5 5h4"/></svg></span><h3>Reservas</h3><p>Consultar y actualizar estados con historial.</p></a>
    <a href="/admin/instituciones" class="dashboard-card" style="text-decoration:none;color:inherit"><span class="card-symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5l8-3 8 3v16M2 21h20M9 21v-5h6v5M8 8h1m6 0h1M8 12h1m6 0h1"/></svg></span><h3>Instituciones</h3><p>Gestionar instituciones aliadas.</p></a>
    <a href="/admin/promociones" class="dashboard-card" style="text-decoration:none;color:inherit"><span class="card-symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12 12 20 3 11V4h7z"/><circle cx="7.5" cy="8.5" r="1"/></svg></span><h3>Promociones</h3><p>Gestionar cupones y descuentos.</p></a>
  </div>
  <p id="dashboard-status" class="profile-note" role="status">Cargando indicadores...</p>
</RoleLayout>
<style>
.admin-overview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:20px 0 30px}
.overview-card{position:relative;isolation:isolate;overflow:hidden;border-radius:17px;padding:23px 12px 20px;min-height:184px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;background:#e9f7f1;border:1px solid #cce9dc;box-shadow:0 5px 16px rgba(16,86,65,.07);transition:transform .18s ease,box-shadow .18s ease}
.overview-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(23,61,57,.12)}
.overview-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(255,255,255,.7),transparent 72%);z-index:-1}
.overview-card strong{font-size:38px;line-height:1.08;color:#125b4e;font-weight:700;letter-spacing:-1.2px;font-variant-numeric:tabular-nums}
.overview-card>span:last-child{font-size:13px;line-height:1.35;color:#365e52;font-weight:600;max-width:140px}
.overview-icon{display:block;width:43px;height:43px;flex:none;stroke:#087e68;filter:drop-shadow(0 2px 2px rgba(0,0,0,.04))}
.admin-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 0 30px}
.chart-panel{min-width:0;background:#fff;border:1px solid #e2ece8;border-radius:17px;padding:24px;box-shadow:0 5px 18px #145e530a}
.chart-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.chart-heading h2{font-size:16px;margin:0}.chart-heading span{font-size:11px;color:#819490}
.month-chart{display:flex;align-items:end;justify-content:space-around;gap:10px;min-height:230px;border-bottom:1px solid #dcece7;padding:12px 5px 0}
.month-item{height:220px;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:end;gap:7px}
.month-count{font-size:11px;font-weight:700;color:#355e56}
.month-bar{width:min(100%,44px);min-height:3px;background:linear-gradient(180deg,#36b5aa,#0d9488);border-radius:7px 7px 0 0;transition:height .2s}
.month-label{font-size:11px;color:#718d85;padding-bottom:6px}
.state-chart{display:flex;align-items:center;justify-content:center;gap:26px;flex-wrap:wrap;min-height:230px}
.donut{width:175px;height:175px;flex:none;border-radius:50%;display:grid;place-items:center;background:#e8f1ed}
.donut-center{width:115px;height:115px;background:white;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}
.donut-center strong{font-size:31px;color:#15302e}.donut-center span{font-size:12px;color:#819490}
.state-legend{display:grid;gap:12px;min-width:145px;flex:1;font-size:12px}
.legend-item{display:flex;align-items:center;gap:8px}.legend-dot{width:11px;height:11px;flex:none;border-radius:50%}.legend-item strong{margin-left:auto}
.roles-graph{display:grid;gap:14px}
@media(max-width:1100px){.admin-overview{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-chart-grid{grid-template-columns:1fr}}
@media(max-width:700px){.admin-overview{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.overview-card{min-height:154px;padding:17px 8px}.overview-card strong{font-size:32px}.overview-icon{width:36px;height:36px}.chart-panel{padding:16px}.state-chart{gap:14px}}
.dashboard-card{transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
.dashboard-card:hover{transform:translateY(-3px);border-color:#badfd0;box-shadow:0 12px 25px #145e5318}
.dashboard-card .card-symbol{background:#e2f4ec;color:#087963;border:1px solid #c9e9dc}
.dashboard-card .card-symbol svg{width:24px;height:24px}
@media(prefers-reduced-motion:reduce){.dashboard-card{transition:none}.dashboard-card:hover{transform:none}}

/* Dashboard administrativo: tarjetas compactas de estilo ejecutivo */
.admin-overview{gap:15px;margin:18px 0 34px}
.overview-card{min-height:126px;padding:20px 18px;display:grid;grid-template-columns:52px minmax(0,1fr);grid-template-rows:auto auto;column-gap:14px;row-gap:4px;align-content:center;align-items:center;text-align:left;background:#fff;border:1px solid #dfebe6;border-radius:16px;box-shadow:0 6px 20px rgba(16,73,60,.055)}
.overview-card::before{display:none}
.overview-card::after{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:#0d9488;opacity:.8}
.overview-icon{grid-column:1;grid-row:1 / span 2;box-sizing:content-box;width:26px;height:26px;padding:12px;background:#e6f6ee;border-radius:13px;stroke:#087e68;filter:none}
.overview-card strong{grid-column:2;grid-row:1;font-size:29px;letter-spacing:-.9px;color:#153f37}
.overview-card>span:last-child{grid-column:2;grid-row:2;font-size:11px;line-height:1.5;color:#6a8179;font-weight:550;max-width:none}
.overview-card:hover{transform:translateY(-3px);border-color:#b5dfce;box-shadow:0 12px 24px rgba(16,73,60,.10)}
.admin-chart-grid{gap:18px;margin-bottom:34px}
.chart-panel{border-radius:17px;border-color:#dfebe6;box-shadow:0 6px 20px rgba(16,73,60,.055)}
.chart-heading{border-bottom:1px solid #edf3f0;padding-bottom:15px;margin-bottom:16px}
.chart-heading h2{font-size:16px;color:#183d36}
:global(html[data-expected-role="ADMINISTRADOR"] .section-heading){margin-top:28px;margin-bottom:16px}
:global(html[data-expected-role="ADMINISTRADOR"] .section-heading h2){font-size:19px;color:#183d36;letter-spacing:-.35px}
:global(html[data-expected-role="ADMINISTRADOR"] .dashboard-card){border-color:#dfebe6;box-shadow:0 6px 20px rgba(16,73,60,.055)}
@media(max-width:1150px){.admin-overview{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.admin-overview{gap:10px}.overview-card{min-height:116px;padding:14px 11px;grid-template-columns:40px minmax(0,1fr);column-gap:9px}.overview-icon{width:22px;height:22px;padding:9px;border-radius:10px}.overview-card strong{font-size:25px}.overview-card>span:last-child{font-size:10px}.chart-panel{padding:17px}}
@media(prefers-reduced-motion:reduce){.overview-card{transition:none}.overview-card:hover{transform:none}}
</style>
<script>
  import { adminRequest } from '../lib/admin-api';
  type User = { rolNombre?: string; estaActivo?: boolean };
  type Summary = Record<string, number>;
  type Reservation = {id?:number;estado?:string;creadoEn?:string};
  const setMetric = (id: string, count: number) => {
    const element = document.getElementById(id);
    if (element) element.textContent = Number(count).toLocaleString('es-PE');
  };
  const drawRoles = (roles: Array<[string,number]>) => {
    const graph = document.getElementById('roles-graph');
    if (!graph) return;
    graph.replaceChildren();
    const total = Math.max(1, roles.reduce((sum,[,count]) => sum + count,0));
    for (const [name,count] of roles) {
      const item = document.createElement('div');
      const label = document.createElement('div');
      label.textContent = name + ' · ' + count.toLocaleString('es-PE');
      label.style.cssText = 'font-size:12px;margin-bottom:7px';
      const track = document.createElement('div');
      track.style.cssText = 'height:9px;border-radius:9px;background:#e7f5f0;overflow:hidden';
      const fill = document.createElement('div');
      fill.style.cssText = 'height:100%;background:#0d9488;border-radius:9px;width:' + (count / total * 100) + '%';
      track.appendChild(fill);
      item.append(label,track);
      graph.appendChild(item);
    }
  };
  const monthNames=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  const drawMonthly = (reservations: Reservation[]) => {
    const chart=document.getElementById('monthly-chart');
    if(!chart)return;
    chart.replaceChildren();
    const now=new Date();
    const months=Array.from({length:6},(_,i)=>{
      const date=new Date(now.getFullYear(),now.getMonth()-5+i,1);
      return {year:date.getFullYear(),month:date.getMonth(),label:monthNames[date.getMonth()],count:0};
    });
    for(const reservation of reservations){
      if(!reservation.creadoEn)continue;
      const date=new Date(reservation.creadoEn);
      if(Number.isNaN(date.getTime()))continue;
      const month=months.find(m=>m.year===date.getFullYear()&&m.month===date.getMonth());
      if(month)month.count++;
    }
    const max=Math.max(1,...months.map(m=>m.count));
    for(const month of months){
      const item=document.createElement('div');item.className='month-item';
      const count=document.createElement('span');count.className='month-count';count.textContent=String(month.count);
      const bar=document.createElement('div');bar.className='month-bar';bar.style.height=(month.count/max*165)+'px';
      const label=document.createElement('span');label.className='month-label';label.textContent=month.label;
      item.append(count,bar,label);chart.appendChild(item);
    }
  };
  const drawStates=(reservations: Reservation[])=>{
    const donut=document.getElementById('reservation-donut');
    const legend=document.getElementById('reservation-legend');
    const total=document.getElementById('donut-total');
    if(!donut||!legend||!total)return;
    total.textContent=String(reservations.length);
    const counts=new Map<string,number>();
    for(const reservation of reservations){
      const state=reservation.estado||'SIN ESTADO';
      counts.set(state,(counts.get(state)||0)+1);
    }
    legend.replaceChildren();
    const colors=['#0d9488','#3b9dd1','#a8b9b3','#f3aa63','#9b86d9','#df7997'];
    let start=0;const segments:string[]=[];
    [...counts.entries()].sort((a,b)=>b[1]-a[1]).forEach(([state,count],index)=>{
      const pct=reservations.length?count/reservations.length*100:0;
      const color=colors[index%colors.length];
      segments.push(color+' '+start+'% '+(start+pct)+'%');start+=pct;
      const row=document.createElement('div');row.className='legend-item';
      const dot=document.createElement('span');dot.className='legend-dot';dot.style.background=color;
      const label=document.createElement('span');label.textContent=state.replaceAll('_',' ').toLowerCase();
      const number=document.createElement('strong');number.textContent=count+' · '+Math.round(pct)+'%';
      row.append(dot,label,number);legend.appendChild(row);
    });
    donut.style.background=segments.length?'conic-gradient('+segments.join(',')+')':'#e8f1ed';
    if(!reservations.length)legend.textContent='Todavía no hay reservas registradas.';
  };
  let started = false;
  async function loadDashboard() {
    if (started) return;
    started = true;
    const message = document.getElementById('dashboard-status');
    if (message) message.textContent = 'Consultando los datos del backend...';
    // Los usuarios se consultan de forma independiente para no bloquear sus métricas
    // si falla alguna consulta de reservas, instituciones o promociones.
    const [usersResult, summaryResult, reservationsResult] = await Promise.allSettled([
      adminRequest<User[]>('/usuarios'),
      adminRequest<Summary>('/dashboard'),
      adminRequest<Reservation[]>('/reservas')
    ]);
    const errors: string[] = [];
    if (usersResult.status === 'fulfilled') {
      const users = usersResult.value;
      const endUsers = users.filter(u => ['ACOMPANANTE','ADULTO_MAYOR','FAMILIAR'].includes(u.rolNombre ?? ''));
      setMetric('m-users',endUsers.length);
      setMetric('m-active',endUsers.filter(u => u.estaActivo === true).length);
      setMetric('m-elders',endUsers.filter(u => u.rolNombre === 'ADULTO_MAYOR').length);
      drawRoles([
        ['Acompañantes',endUsers.filter(u => u.rolNombre === 'ACOMPANANTE').length],
        ['Adultos mayores',endUsers.filter(u => u.rolNombre === 'ADULTO_MAYOR').length],
        ['Familiares',endUsers.filter(u => u.rolNombre === 'FAMILIAR').length]
      ]);
    } else {
      errors.push('Usuarios: ' + String(usersResult.reason));
    }
    if (summaryResult.status === 'fulfilled') {
      const data = summaryResult.value;
      setMetric('m-reservations',data.reservas);
      setMetric('m-completed',data.reservasCompletadas);
      setMetric('m-institutions',data.instituciones);
      setMetric('m-promotions',data.promocionesActivas);
      if (usersResult.status !== 'fulfilled') {
        setMetric('m-users',data.usuarios);
        setMetric('m-active',data.usuariosActivos);
        setMetric('m-elders',data.adultosMayores);
        drawRoles([
          ['Acompañantes',data.acompanantes],
          ['Adultos mayores',data.adultosMayores],
          ['Familiares',data.familiares]
        ]);
      }
    } else {
      errors.push('Resumen: ' + String(summaryResult.reason));
    }
    if (reservationsResult.status === 'fulfilled') {
      drawMonthly(reservationsResult.value);
      drawStates(reservationsResult.value);
    } else {
      errors.push('Gráficos de reservas: ' + String(reservationsResult.reason));
      const chart=document.getElementById('monthly-chart');
      const legend=document.getElementById('reservation-legend');
      if(chart)chart.textContent='No se pudieron cargar las reservas.';
      if(legend)legend.textContent='Datos no disponibles.';
    }
    if (message) {
      message.textContent = errors.length ? 'No se pudieron cargar todas las métricas. ' + errors.join(' | ') : 'Métricas actualizadas desde el backend.';
      message.style.color = errors.length ? '#b42336' : '#087a70';
    }
  }
  // El layout valida el JWT; esta señal se dispara después de verificar el perfil.
  if (document.documentElement.dataset.profileReady === 'true') void loadDashboard();
  else document.addEventListener('seniorlink:profile', () => void loadDashboard(), { once:true });
</script>