---
import RoleLayout from '../layouts/RoleLayout.astro';
const accesos=[
 {titulo:'Acompañantes',detalle:'Encuentra y compara acompañantes verificados.',ruta:'/familiar/acompanantes',accion:'Ver catálogo'},
 {titulo:'Reservas familiares',detalle:'Administra las solicitudes y servicios de tus familiares.',ruta:'/familiar/reservas',accion:'Ver reservas'},
 {titulo:'Vinculaciones',detalle:'Consulta y administra tus vinculaciones con adultos mayores.',ruta:'/familiar/vinculaciones',accion:'Ver vinculaciones'},
 {titulo:'Métodos de pago',detalle:'Administra tus tarjetas registradas.',ruta:'/familiar/metodos-pago',accion:'Ver métodos de pago'},
 {titulo:'Mis incidencias',detalle:'Solicita ayuda y consulta las respuestas de soporte.',ruta:'/familiar/incidencias',accion:'Solicitar ayuda'},
 {titulo:'Mi perfil',detalle:'Consulta tus datos personales y actualiza tu fotografía.',ruta:'/familiar/mi-perfil',accion:'Consultar perfil'}
];
---
<RoleLayout role="FAMILIAR" label="Familiar" description="Organiza el acompañamiento de tus familiares y consulta el estado de sus servicios.">
 <section class="familiar-home">
  <div class="section-heading"><h2>Resumen de tus reservas familiares</h2></div>
  <div class="dashboard-grid">
   <article class="dashboard-card"><h3>Solicitudes pendientes</h3><strong id="familiar-pendientes">—</strong></article>
   <article class="dashboard-card"><h3>Servicios activos</h3><strong id="familiar-activas">—</strong></article>
   <article class="dashboard-card"><h3>Servicios completados</h3><strong id="familiar-completadas">—</strong></article>
   <article class="dashboard-card"><h3>Reservas canceladas</h3><strong id="familiar-canceladas">—</strong></article>
   <article class="dashboard-card"><h3>Vinculaciones aceptadas</h3><strong id="familiar-vinculos">—</strong></article>
   <article class="dashboard-card"><h3>Incidencias abiertas</h3><strong id="familiar-incidencias">—</strong></article>
  </div>
  <p id="familiar-resumen-status" role="status" aria-live="polite"></p>
  <div class="section-heading"><h2>Próximos servicios confirmados</h2><a href="/familiar/reservas">Ver reservas</a></div>
  <div id="familiar-proximas" class="local-list" aria-live="polite">Consultando reservas...</div>
  <div class="section-heading"><h2>Accesos directos</h2></div>
  <div class="dashboard-grid">
   {accesos.map(a=><article class="dashboard-card"><h3>{a.titulo}</h3><p>{a.detalle}</p><a href={a.ruta}>{a.accion}</a></article>)}
  </div>
 </section>
</RoleLayout>
<style>
.familiar-home .dashboard-card strong{display:block;color:#087a70;font-size:2rem;margin-top:12px}
.familiar-home a{color:#087a70;font-weight:600;text-decoration:underline;text-underline-offset:3px}
.familiar-home .dashboard-card a{display:inline-block;margin-top:12px}
.familiar-home a:focus-visible{outline:2px solid #087a70;outline-offset:3px}
</style>
<script>
 import {apiLocal,horaLocal} from '../lib/local-api';
 type Reserva={id:number,estado:string,inicio:string,fin:string,adultoMayorNombre:string,acompananteNombre:string};
 type Estado={estado:string};
 const mostrar=(id:string,valor:string)=>{const el=document.querySelector('#familiar-'+id);if(el)el.textContent=valor;};
 async function resumen(){
  const lista=document.querySelector<HTMLElement>('#familiar-proximas')!;
  const avisos:string[]=[];
  const [reservas,vinculos,incidencias]=await Promise.allSettled([apiLocal('/reservas'),apiLocal('/vinculos'),apiLocal('/incidencias')]);
  if(reservas.status==='fulfilled'&&Array.isArray(reservas.value)){
   const datos:Reserva[]=reservas.value;
   const grupos:Record<string,string[]>={pendientes:['PENDIENTE_ACEPTACION','PENDIENTE_PAGO'],activas:['CONFIRMADA','EN_PROGRESO','PENDIENTE_CONFIRMACION','EN_DISPUTA'],completadas:['COMPLETADA'],canceladas:['CANCELADA']};
   for(const [id,estados] of Object.entries(grupos))mostrar(id,String(datos.filter(r=>estados.includes(r.estado)).length));
   const proximas=datos.filter(r=>r.estado==='CONFIRMADA'&&Date.parse(r.fin)>Date.now()).sort((a,b)=>Date.parse(a.inicio)-Date.parse(b.inicio)).slice(0,5);
   lista.replaceChildren();
   if(!proximas.length)lista.textContent='No hay próximos servicios confirmados.';
   for(const r of proximas){const item=document.createElement('article');item.className='local-item local-booking';const titulo=document.createElement('strong');titulo.textContent='#'+r.id+' · '+r.adultoMayorNombre;const acomp=document.createElement('p');acomp.textContent='Acompañante: '+r.acompananteNombre;const fecha=document.createElement('p');fecha.textContent=horaLocal(r.inicio)+' — '+horaLocal(r.fin);item.append(titulo,acomp,fecha);lista.append(item);}
  }else{avisos.push('reservas');lista.textContent='No se pudieron consultar los próximos servicios.';}
  if(vinculos.status==='fulfilled'&&Array.isArray(vinculos.value))mostrar('vinculos',String(vinculos.value.filter((v:Estado)=>v.estado==='ACEPTADO').length));else avisos.push('vinculaciones');
  if(incidencias.status==='fulfilled'&&Array.isArray(incidencias.value))mostrar('incidencias',String(incidencias.value.filter((v:Estado)=>v.estado==='ABIERTA').length));else avisos.push('incidencias');
  mostrar('resumen-status',avisos.length?'No se pudo consultar: '+avisos.join(', ')+'.':'');
 }
 if(document.documentElement.dataset.profileReady==='true')void resumen();
 else document.addEventListener('seniorlink:profile',()=>void resumen(),{once:true});
 if(window.location.hash==='#mi-perfil')window.location.replace('/familiar/mi-perfil');
 else if(window.location.hash==='#herramientas')window.history.replaceState(null,'','/familiar');
</script>
